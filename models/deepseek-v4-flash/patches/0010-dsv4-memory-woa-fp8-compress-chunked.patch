+            sc = tl.load(rb[:, None] + STATE_WIDTH + block[None, :],
+                         mask=ok[:, None] & mask[None, :], other=float("-inf"))
+            den += tl.sum(tl.exp(sc - col_max[None, :]), axis=0)
+        compressed_kv = tl.zeros([TRITON_BLOCK_SIZE], tl.float32)
+        for c0 in range(0, NT, CHUNK_TOKENS):
+            p_c = start + c0 + ct
+            ok = p_c >= 0
+            bn = tl.load(block_table_ptr + req_idx * block_table_stride + p_c // block_size,
