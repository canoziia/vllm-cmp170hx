     # cohorts of >= 9 requests draft and verify at most 4 positions (0009)
     "VLLM_DSV4_NARROW_DRAFT": "4:9",
+    # FP8 wo_a without the bf16 copy; chunked ratio-128 KV compressor (0010)
+    "VLLM_DSV4_WOA_FP8": "1",
+    "VLLM_DSV4_COMPRESS_CHUNKED": "1",
     # target decode kernels
     "VLLM_DSV4_FAST_DET_MOE_ALIGN": "1",
     "VLLM_DSV4_CUDA_DET_ALIGN": "1",
