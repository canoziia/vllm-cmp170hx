     )
     o_ref = o_ref.view(o.shape[0], n_local_groups, -1)
 
+    from vllm.v1.attention.ops import dsv4_woa_fp8
+
+    if dsv4_woa_fp8.enabled() and getattr(wo_a, "_dsv4_wo_a_bf16", None) is None:
+        # VLLM_DSV4_WOA_FP8: run from the FP8 weight, never build the bf16 copy.
+        from vllm.model_executor.layers.quantization.utils.fp8_utils import (
+            get_fp8_block_weight_scale,
+        )
+
+        scale = get_fp8_block_weight_scale(wo_a)
+        if dsv4_woa_fp8.supported(o_ref, wo_a.weight, scale, n_local_groups, o_lora_rank):
+            return dsv4_woa_fp8.woa_fp8(
+                o_ref, wo_a.weight, dsv4_woa_fp8.scale_f32(wo_a, scale),
+                n_local_groups, o_lora_rank)
+        if "woa" not in dsv4_woa_fp8._WARNED:
+            dsv4_woa_fp8._WARNED.add("woa")
+            logger.warning("VLLM_DSV4_WOA_FP8: falling back to the bf16 wo_a copy: %s",
+                           dsv4_woa_fp8.why_not(o_ref, wo_a.weight, scale,
+                                                n_local_groups, o_lora_rank))
+
     wo_a_weight = _get_cached_wo_a_bf16(
         wo_a, n_local_groups, o_lora_rank, o_ref.shape[-1]
     )
