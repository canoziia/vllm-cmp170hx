diff --git a/vllm/v1/attention/ops/dsv4_woa_fp8.py b/vllm/v1/attention/ops/dsv4_woa_fp8.py
new file mode 100644
--- /dev/null
+++ b/vllm/v1/attention/ops/dsv4_woa_fp8.py
@@ -0,0 +1,134 @@
+"""DeepSeek-V4 wo_a grouped GEMM straight from the FP8 checkpoint weight.
+
+VLLM_DSV4_WOA_FP8=1 (default 0 = unchanged). On sm_80 the attention output
+projection wo_a (o_groups x o_lora_rank x hidden, FP8 e4m3 with 128x128 block
+scales) is otherwise run from a bf16 copy built at first use
+(_get_cached_wo_a_bf16: 64 MiB per layer, ~1 GiB on a 16-layer PP rank, kept
+next to the 32 MiB FP8 weight). This kernel reads the FP8 bytes directly: four
+e4m3 bytes become four fp16 values x * 2^-8 with one prmt/shift/and/lop3
+sequence (exact for every code; 0x7f/0xff give the +-480 * 2^-8 the e4m3 LUT
+uses for NaN), the activations go to the tensor cores as fp16 and each 128 x
+128 block's fp32 scale (times 2^8) is applied to the fp32 partial of its k
+chunk, which is then added in fp32 (same short-chain form as dsv41_thin_woa).
+Not bitwise equal to the bf16 path (fp16 activations, different k-chunk
+scaling point); error against an fp32 reference is at the bf16 path's level.
+Faster for decode token counts (CMP 170HX: 31-39 us vs 46-49 us at M <= 32).
+From DEQUANT_FROM_M tokens the weight is dequantized per call instead (77 us
+per layer, then the unchanged einsum: bitwise equal to the bf16 path).
+"""
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+
+def enabled() -> bool:
+    return os.environ.get("VLLM_DSV4_WOA_FP8", "0") == "1"
+
+
+@triton.jit
+def _e4m3x4_to_f16(b):
+    return tl.inline_asm_elementwise(
+        asm="{ .reg .b32 x0, x1, y0, y1; prmt.b32 x0, $2, 0, 0x1404; "
+            "prmt.b32 x1, $2, 0, 0x3424; shr.b32 y0, x0, 1; shr.b32 y1, x1, 1; "
+            "and.b32 y0, y0, 0x3FFF3FFF; and.b32 y1, y1, 0x3FFF3FFF; "
+            "lop3.b32 $0, x0, 0x80008000, y0, 0xEA; lop3.b32 $1, x1, 0x80008000, y1, 0xEA; }",
+        constraints="=r,=r,r", args=[b], dtype=tl.float16, is_pure=True, pack=4)
+
+
+@triton.jit
+def _woa_fp8_kernel(X, W, S, Y, M, SX, SG, G: tl.constexpr, N: tl.constexpr,
+                    K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    n = tl.program_id(0) * BN + tl.arange(0, BN)
+    g = tl.program_id(1)
+    m = tl.program_id(2) * BM + tl.arange(0, BM)
+    k = tl.arange(0, BK)
+    nb = (tl.program_id(0) * BN) // 128
+    acc = tl.zeros((BM, BN), tl.float32)
+    for i in range(K // BK):
+        kk = i * BK + k
+        a = tl.load(X + m[:, None] * SX + g * SG + kk[None, :], m[:, None] < M, 0).to(tl.float16)
+        b = _e4m3x4_to_f16(tl.load(W + g * N * K + n[None, :] * K + kk[:, None]))
+        tmp = tl.dot(a, b) * (tl.load(S + (g * (N // 128) + nb) * (K // 128) + i) * 256.0)
+        acc = tl.inline_asm_elementwise(
+            "add.rn.f32 $0, $1, $2;", constraints="=f,f,f",
+            args=[acc, tmp], dtype=tl.float32, is_pure=True, pack=1)
+    tl.store(Y + (m[:, None] * G + g) * N + n[None, :], acc.to(tl.bfloat16), m[:, None] < M)
+
+
+@triton.jit
+def _dequant_kernel(W, S, O, K: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    n = tl.program_id(0) * BN + tl.arange(0, BN)
+    k = tl.program_id(1) * BK + tl.arange(0, BK)
+    b = _e4m3x4_to_f16(tl.load(W + n[:, None] * K + k[None, :])).to(tl.float32)
+    sc = tl.load(S + (n[:, None] // 128) * (K // 128) + k[None, :] // 128)
+    tl.store(O + n[:, None] * K + k[None, :], (b * (sc * 256.0)).to(tl.bfloat16))
+
+
+# Above this many tokens (prefill chunks) the FP8 tensor-core loop is compute
+# bound behind cuBLAS: dequantize the layer's weight into a transient bf16
+# buffer (64 MiB, released to the caching allocator after the call) and run
+# the reference einsum on it. That dequant is bit-identical to the bf16 copy
+# _get_cached_wo_a_bf16 would keep, so prefill results equal the bf16 path.
+DEQUANT_FROM_M = 129
+
+
+def _cfg(m: int):
+    # (BM, BN, warps, stages), CMP 170HX graph-replay scan
+    if m <= 16:
+        return 16, 128, 4, 3
+    if m <= 32:
+        return 32, 128, 4, 3
+    if m <= 64:
+        return 64, 128, 4, 4
+    return 128, 128, 8, 2
+
+
+def supported(x: torch.Tensor, weight: torch.Tensor, scale: torch.Tensor | None,
+              n_groups: int, rank: int) -> bool:
+    return (enabled() and scale is not None and x.is_cuda and x.dtype == torch.bfloat16
+            and weight.dtype == torch.float8_e4m3fn and weight.is_contiguous()
+            and x.stride(-1) == 1 and rank % 128 == 0 and x.shape[-1] % 512 == 0
+            and tuple(scale.shape) == (n_groups * rank // 128, x.shape[-1] // 128)
+            and torch.cuda.get_device_capability(x.device) == (8, 0))
+
+
+_WARNED = set()
+
+
+def why_not(x, weight, scale, n_groups, rank) -> str:
+    return (f"x {tuple(x.shape)} {x.dtype} stride {x.stride()}; weight {tuple(weight.shape)} "
+            f"{weight.dtype} contiguous={weight.is_contiguous()}; scale "
+            f"{None if scale is None else (tuple(scale.shape), scale.dtype)}; G={n_groups} r={rank}")
+
+
+def scale_f32(module, scale: torch.Tensor) -> torch.Tensor:
+    """fp32 contiguous copy of the block scales, cached on the module (built on
+    the first eager call, before graph capture; 64 x 32 floats per layer)."""
+    s = getattr(module, "_dsv4_woa_scale_f32", None)
+    if s is None:
+        s = scale.to(torch.float32).contiguous()
+        module._dsv4_woa_scale_f32 = s
+    return s
+
+
+def woa_fp8(x: torch.Tensor, weight: torch.Tensor, scale: torch.Tensor,
+            n_groups: int, rank: int) -> torch.Tensor:
+    """x [T, G, K] bf16, weight [G*rank, K] e4m3, scale [G*rank/128, K/128] fp32
+    -> [T, G, rank] bf16 (= einsum('tgd,grd->tgr', x, dequant(weight)))."""
+    t, g, kdim = x.shape
+    if t >= DEQUANT_FROM_M:
+        w = torch.empty((g * rank, kdim), device=x.device, dtype=torch.bfloat16)
+        _dequant_kernel[(g * rank // 32, kdim // 512)](
+            weight.view(torch.uint8), scale, w, kdim, 32, 512, num_warps=4)
+        return torch.einsum("tgd,grd->tgr", x, w.view(g, rank, kdim))
+    out = torch.empty((t, g, rank), device=x.device, dtype=torch.bfloat16)
+    if t == 0:
+        return out
+    bm, bn, warps, stages = _cfg(t)
+    _woa_fp8_kernel[(rank // bn, g, triton.cdiv(t, bm))](
+        x, weight.view(torch.uint8), scale, out, t, x.stride(0), x.stride(1),
+        g, rank, kdim, bm, bn, 128, num_warps=warps, num_stages=stages,
+        enable_fp_fusion=False)
+    return out
