@@ -371,3 +389,60 @@
             )
         with record_function("dspark::markov_sampling"):
             self._sample_sequential(num_reqs, head_hidden)
+
+    # ---- VLLM_DSV4_NARROW_DRAFT -------------------------------------------
+    def _swap_narrow(self):
+        w = self._narrow[0]
+        saved = (self.num_speculative_steps, self.num_query_per_req,
+                 self.query_cudagraph_manager, self._anchor_idx, self._step_cols,
+                 self._fused_markov.n_spec if self._fused_markov is not None else None)
+        self.num_speculative_steps = w
+        self.num_query_per_req = w
+        self.query_cudagraph_manager = self._narrow_cg_manager
+        self._anchor_idx = self._narrow_anchor_idx
+        self._step_cols = self._narrow_step_cols
+        if self._fused_markov is not None:
+            self._fused_markov.n_spec = w
+        return saved
+
+    def _restore(self, saved):
+        (self.num_speculative_steps, self.num_query_per_req,
+         self.query_cudagraph_manager, self._anchor_idx, self._step_cols, n) = saved
+        if self._fused_markov is not None:
+            self._fused_markov.n_spec = n
+
+    def init_cudagraph_manager(self, cudagraph_mode: CUDAGraphMode) -> None:
+        super().init_cudagraph_manager(cudagraph_mode)
+        if self._narrow is not None:
+            from vllm.v1.worker.gpu.spec_decode.dflash.cudagraph import (
+                DFlashCudaGraphManager,
+            )
+            full = self.query_cudagraph_manager
+            self._narrow_cg_manager = DFlashCudaGraphManager(
+                self.vllm_config, self.device, full.cudagraph_mode,
+                decode_query_len=self._narrow[0],
+            )
+
+    def capture(self) -> None:
+        super().capture()
+        if self._narrow is not None and self._narrow_cg_manager is not None:
+            saved = self._swap_narrow()
+            try:
+                super().capture()
+            finally:
+                self._restore(saved)
+
+    def propose(self, input_batch, *args, **kwargs):
+        if (self._narrow is None or self._narrow_cg_manager is None
+                or input_batch.num_reqs < self._narrow[1]):
+            return super().propose(input_batch, *args, **kwargs)
+        w = self._narrow[0]
+        num_reqs = input_batch.num_reqs
+        saved = self._swap_narrow()
+        try:
+            super().propose(input_batch, *args, **kwargs)
+        finally:
+            self._restore(saved)
+        if self.enable_adaptive_verification:
+            self.draft_token_confidence_probs[:num_reqs, w:] = 0.0
+        return self.draft_tokens[:num_reqs]
