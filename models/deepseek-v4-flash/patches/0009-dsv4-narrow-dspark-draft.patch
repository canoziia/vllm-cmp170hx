         # load_draft_model once the head's weights and shard geometry exist.
         self._fused_markov: FusedMarkovSampler | None = None
 
+        # VLLM_DSV4_NARROW_DRAFT="W:N" (default off): cohorts of at least N
+        # requests draft only the first W block positions (W query tokens per
+        # request, its own FULL graphs); the scheduler caps their verification
+        # width at W (dsv41_fixed_policy). Positions >= W keep stale ids with
+        # confidence 0. Only the drafted block shrinks; the target still
+        # verifies every token it is given, so outputs are unchanged.
+        self._narrow: tuple[int, int] | None = None
+        v = os.environ.get("VLLM_DSV4_NARROW_DRAFT", "")
+        if v and self.sample_from_anchor:
+            w, n = (int(x) for x in v.split(":"))
