 """
 
 import math
+import os
 import time
 from types import SimpleNamespace
 from .dsv41_measured_policy import Policy
 
 
+
+
+def _narrow_draft():
+    """(width, min cohort) from VLLM_DSV4_NARROW_DRAFT="W:N", or None."""
+    v = os.environ.get("VLLM_DSV4_NARROW_DRAFT", "")
+    if not v:
+        return None
+    w, n = (int(x) for x in v.split(":"))
+    return w, n
+
 class FixedHistoryPolicy:
     def __init__(self, logger, decay=0.95, cost_ms=None, uniform=False):
         if isinstance(decay, bool) or not math.isfinite(decay) or not 0 <= decay < 1:
@@ -113,6 +124,15 @@
             result[r.request_id] = entry.k
         if self.uniform and len(result) > 1:
             self.unify(result)
+        narrow = _narrow_draft()
+        if narrow is not None and len(requests) >= narrow[1]:
+            # VLLM_DSV4_NARROW_DRAFT: the drafter only drafts narrow[0]
+            # positions for cohorts this large; never verify past them.
+            for rid in result:
+                result[rid] = min(result[rid], narrow[0])
+                entry = self.active.get(rid)
+                if entry is not None:
+                    entry.k = min(entry.k, narrow[0])
         return result
 
     def unify(self, result):
