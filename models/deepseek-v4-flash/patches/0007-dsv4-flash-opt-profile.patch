From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] deepseek-v4-flash: one dsv4-flash optimisation profile

VLLM_DSV41_OPT_PROFILE=dsv4-flash sets (setdefault, so each switch can still be
overridden) the switches measured to help DeepSeek-V4-Flash on CMP 170HX PP3:

* speculative decoding (0001/0002): verification-width graphs, decode metadata
  and the fp8 draft head, uniform graphs for 12/24-request PP cohorts (0008);
  pair with dspark K=5 and
  enable_adaptive_verification;
* target decode: single-kernel deterministic MoE align (Triton + CUDA), MXFP4
  MoE decode v2 (DQ2, fused activation and top-k sum), fast sparse-attention
  decode with direct output, thin wo_a, fused indexer q LUT, small-M dense
  FP8 GEMMs;
* PP: deferred feedback receive, live-load decode cohorts.

It replaces the speculative-only v4-spec profile of 0001. mHC v2 and the V4.1
prefill switches are not in it (see models/deepseek-v4-flash/README.md). The
default profile and unset/off are unchanged.
---
 vllm/dsv41_opt_profile.py | 31 ++++++++++++++++++++++++++-----
 1 file changed, 26 insertions(+), 5 deletions(-)

diff --git a/vllm/dsv41_opt_profile.py b/vllm/dsv41_opt_profile.py
index 819da97..9c2f565 100644
--- a/vllm/dsv41_opt_profile.py
+++ b/vllm/dsv41_opt_profile.py
@@ -54,15 +54,36 @@ PROFILES["verification"] = {
     "VLLM_DSV41_METADATA_GRAPHS": "1",
 }
 
-# DeepSeek V4 (deepseek-v4-flash) DSpark: verification-width graphs, decode
-# metadata and the fp8 draft head only (speculative-decoding switches).
-# Target kernels, PP cohort switches and the automatic width policy
-# (enable_adaptive_verification) are separate choices.
-PROFILES["v4-spec"] = {
+# DeepSeek-V4-Flash (deepseek_v4, hidden 4096): the switches measured to help
+# on CMP 170HX PP3 (see models/deepseek-v4-flash/README.md). Pair with
+# --speculative-config {"method":"dspark","num_speculative_tokens":5,
+# "enable_adaptive_verification":true}.
+PROFILES["dsv4-flash"] = {
+    # speculative decoding: verification-width graphs, decode metadata,
+    # fp8 draft head (patches 0001/0002)
     "VLLM_DSV41_VERIFICATION": "1",
     "VLLM_DSV41_FAST_METADATA": "1",
     "VLLM_DSV41_METADATA_GRAPHS": "1",
     "VLLM_DSPARK_DRAFT_HEAD_FP8": "1",
+    # uniform verification graphs for 12/24-request PP cohorts (0008)
+    "VLLM_DSV4_VERIFICATION_COHORTS": "1",
+    # target decode kernels
+    "VLLM_DSV4_FAST_DET_MOE_ALIGN": "1",
+    "VLLM_DSV4_CUDA_DET_ALIGN": "1",
+    "VLLM_DSV4_MXFP4_DECODE": "1",
+    "VLLM_DSV4_MXFP4_DQ": "2",
+    "VLLM_DSV4_MXFP4_FUSED_ACT": "1",
+    "VLLM_DSV4_MXFP4_FUSED_SUM": "1",
+    "VLLM_DSV4_MXFP4_FUSED_SUM_ORDER": "1",
+    "VLLM_DSV4_SPARSE_DECODE_FAST": "1",
+    "VLLM_DSV4_ATTN_DIRECT_OUT": "1",
+    "VLLM_DSV41_THIN_WOA": "1",
+    "VLLM_DSV41_INDEXER_Q_LUT_FUSED": "1",
+    "VLLM_DSV4_DENSE_FP8_DECODE": "1",
+    "VLLM_DSV41_DENSE_MXFP8_LIB": PROFILES["default"]["VLLM_DSV41_DENSE_MXFP8_LIB"],
+    # PP scheduling
+    "VLLM_PP_DEFERRED_FEEDBACK_RECV": "1",
+    "VLLM_PP_DECODE_COHORT_LIVE_LOAD": "1",
 }
 
 
