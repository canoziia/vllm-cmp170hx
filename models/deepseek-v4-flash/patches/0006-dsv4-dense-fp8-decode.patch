+TIERS = {
+    (1024, 8192): {1: ('streamk', 3, 64), 2: ('streamk', 3, 64), 4: ('streamk', 3, 64), 6: ('streamk', 3, 64), 8: ('streamk', 3, 64), 12: ('splitk', 20, 2), 16: ('splitk', 20, 2), 20: ('splitk', 30, 2), 24: ('splitk', 30, 2), 32: None, 40: ('splitk', 60, 2), 48: None, 64: None},
+    (1024, 32768): {1: ('streamk', 0, 128), 2: ('streamk', 3, 64), 4: ('streamk', 3, 128), 6: ('streamk', 0, 128), 8: ('splitk', 21, 1), 12: ('splitk', 20, 1), 16: ('splitk', 20, 1), 20: ('splitk', 30, 1), 24: ('splitk', 30, 1), 32: ('splitk', 40, 1), 40: ('splitk', 61, 1), 48: ('splitk', 60, 1), 64: ('splitk', 80, 1)},
+    (2048, 4096): {1: ('streamk', 3, 64), 2: ('streamk', 3, 64), 4: ('streamk', 3, 64), 6: ('streamk', 3, 64), 8: ('streamk', 3, 64), 12: ('splitk', 21, 4), 16: ('splitk', 21, 4), 20: ('splitk', 31, 4), 24: ('splitk', 31, 4), 32: None, 40: ('splitk', 61, 4), 48: ('splitk', 61, 4), 64: ('splitk', 80, 4)},
+    (4096, 1536): {1: ('streamk', 3, 56), 2: None, 4: None, 6: None, 8: None, 12: None, 16: None, 20: ('splitk', 30, 12), 24: ('splitk', 30, 12), 32: None, 40: ('splitk', 60, 12), 48: ('splitk', 60, 12), 64: ('splitk', 80, 12)},
+    (4096, 4096): {1: ('streamk', 3, 64), 2: ('streamk', 3, 64), 4: ('streamk', 3, 64), 6: None, 8: ('streamk', 3, 64), 12: None, 16: None, 20: ('splitk', 31, 4), 24: ('splitk', 31, 4), 32: None, 40: ('splitk', 61, 4), 48: ('splitk', 61, 4), 64: ('splitk', 81, 4)},
+    (8192, 4096): {1: ('streamk', 3, 64), 2: None, 4: None, 6: None, 8: None, 12: None, 16: None, 20: ('splitk', 32, 8), 24: ('splitk', 31, 4), 32: None, 40: ('splitk', 61, 4), 48: ('splitk', 61, 4), 64: ('splitk', 81, 4)},
+}
