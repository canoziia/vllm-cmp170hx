 }
 
+# DeepSeek V4 (deepseek-v4-flash) DSpark: verification-width graphs, decode
+# metadata and the fp8 draft head only (speculative-decoding switches).
+# Target kernels, PP cohort switches and the automatic width policy
+# (enable_adaptive_verification) are separate choices.
+PROFILES["v4-spec"] = {
+    "VLLM_DSV41_VERIFICATION": "1",
+    "VLLM_DSV41_FAST_METADATA": "1",
+    "VLLM_DSV41_METADATA_GRAPHS": "1",
+    "VLLM_DSPARK_DRAFT_HEAD_FP8": "1",
+}
+
 
 def apply() -> None:
     name = os.environ.get("VLLM_DSV41_OPT_PROFILE", "").strip().lower()
@@ -65,3 +76,17 @@ def apply() -> None:
             f"(known: {', '.join(sorted(PROFILES))})")
     for key, value in PROFILES[name].items():
         os.environ.setdefault(key, value)
+
+
+# Architectures whose DSpark drafter supports request-local verification
+# widths (VLLM_DSV41_VERIFICATION, spec_k, the measured history policy).
+# The V4 vision checkpoint resolves to DeepseekV4ForConditionalGeneration.
+VERIFICATION_WIDTH_ARCHS = frozenset({
+    "DeepseekV41ForCausalLM",
+    "DeepseekV4ForCausalLM",
+    "DeepseekV4ForConditionalGeneration",
+})
+
+
+def uses_dsv4_verification_widths(architectures) -> bool:
+    return not VERIFICATION_WIDTH_ARCHS.isdisjoint(architectures or ())
