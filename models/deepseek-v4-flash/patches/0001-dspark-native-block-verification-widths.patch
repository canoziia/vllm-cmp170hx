@@ -27,7 +31,7 @@ class FixedHistoryPolicy:
         )
 
     def make_entry(self, request):
-        return self.new_entry(Policy({"decay": self.decay}))
+        return self.new_entry(Policy({"decay": self.decay, "cost_ms": self.cost_ms}))
 
     def new_entry(self, plugin):
         self.generation += 1
@@ -107,8 +111,29 @@ class FixedHistoryPolicy:
                 except Exception as exc:
                     self.fail(r.request_id, entry, exc)
             result[r.request_id] = entry.k
+        if self.uniform and len(result) > 1:
+            self.unify(result)
         return result
 
+    def unify(self, result):
+        """Replace per-request widths by the cohort width with the best summed
+        predicted throughput; keep the most common width unless the gain
+        exceeds 3%. Growth stays limited to one step above the widest."""
+        entries = [self.active[rid] for rid in result]
+        scores = [getattr(e.plugin, "diagnostics", {}).get("score") for e in entries]
+        widths = list(result.values())
+        incumbent = max(set(widths), key=lambda k: (widths.count(k), -k))
+        best = incumbent
+        if all(s is not None and len(s) == 5 for s in scores):
+            total = [sum(s[j] for s in scores) for j in range(5)]
+            cand = max(range(1, min(5, max(widths) + 1) + 1), key=lambda k: total[k - 1])
+            if total[cand - 1] > 1.03 * total[incumbent - 1]:
+                best = cand
+        for rid, e in zip(result, entries):
+            if not self.is_disabled(e):
+                e.k = best
+                result[rid] = best
+
     def scheduled(self, output, residents, concurrency):
         if not self.active:
             return
