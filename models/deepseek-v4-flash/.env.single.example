# copy to .env.single; start with
#   podman compose --env-file .env.single --podman-run-args="--ipc=host --pid=host" up -d
VLLM_API_KEY=change-me
DSFLASH_IMAGE=localhost/vllm-backport:deepseek-v4.1-flash
DSFLASH_MODEL_DIR=/root/app/models/DeepSeek-V4-Flash-Vision-Exp
VLLM_CACHE_SINGLE=/root/app/vllm/cache/dsflash-single
DSFLASH_PORT=8501
DSFLASH_OPT_PROFILE=off
