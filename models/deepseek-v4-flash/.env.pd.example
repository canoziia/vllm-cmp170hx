# compose.pd.yml on host-b. Copy to .env.pd (chmod 600, never commit).
VLLM_API_KEY=change-me
DSFLASH_IMAGE=localhost/vllm-backport:deepseek-v4-flash-f5c9c8d
LMCACHE_IMAGE=localhost/lmcache-server:latest
ROUTER_IMAGE=localhost/vllm-router:latest
DSFLASH_MODEL_DIR=/srv/models/DeepSeek-V4-Flash-Vision-Exp
VLLM_CACHE_PREFILL=/srv/vllm-cache/dsflash-pd-prefill
VLLM_CACHE_DECODE=/srv/vllm-cache/dsflash-pd-decode
DSFLASH_OPT_PROFILE=dsv4-flash
DSFLASH_PP_PARTITION=15,16,12
DSFLASH_MAX_MODEL_LEN=1048576

# podman-compose 1.3 does not expand ${VAR:-default} for unset variables: keep all.
DSFLASH_PREFILL_GPU_0=5
DSFLASH_PREFILL_GPU_1=6
DSFLASH_PREFILL_GPU_2=7
DSFLASH_DECODE_GPU_0=1
DSFLASH_DECODE_GPU_1=2
DSFLASH_DECODE_GPU_2=3

# router = public endpoint
DSFLASH_PD_PORT=8401
DSFLASH_PREFILL_PORT=8412
DSFLASH_DECODE_PORT=8413
DSFLASH_PREFILL_KV_PORT=14601
DSFLASH_DECODE_KV_PORT=14602

# prefill role: few sequences, MBT as the single engine; the long-prefill
# threshold equals MBT so one long prompt still gets full 2048-token chunks
# (the old 1024 cap halved single-request prefill speed; the prefill engine has
# no decode traffic to protect)
DSFLASH_PREFILL_MAX_NUM_SEQS=4
DSFLASH_PREFILL_MAX_BATCHED_TOKENS=2048
DSFLASH_PREFILL_LONG_THRESHOLD=2048
DSFLASH_PREFILL_KV_CACHE_MEMORY=3758096384
# decode role
DSFLASH_DECODE_MAX_NUM_SEQS=32
DSFLASH_DECODE_MAX_BATCHED_TOKENS=512
DSFLASH_DECODE_KV_CACHE_MEMORY=4026531840

# LMCache: chunk = prefix-cache retention interval, multiple of the 256-token block
LMCACHE_CHUNK_SIZE=1024
DSFLASH_LMCACHE_PORT=5571
DSFLASH_LMCACHE_HTTP_PORT=18571
# host RAM is tight on host-b (Qwen's L1 holds 64 GiB)
LMCACHE_L1_SIZE_GB=12
LMCACHE_L2_PATH=/srv/lmcache/deepseek-v4-flash-pd
LMCACHE_L2_CAPACITY_GB=200
