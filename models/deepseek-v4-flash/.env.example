# DeepSeek-V4-Flash PD deployment (prefill GPUs 4,5,6 / decode GPUs 7,8,9).
MODEL_ROOT=/root/app/models
DSFLASH_IMAGE=localhost/vllm-backport:deepseek-v4.1-flash-debug
LMCACHE_IMAGE=localhost/lmcache-server:latest
DSFLASH_SERVED_NAME=deepseek-ai/DeepSeek-V4-Flash
VLLM_CACHE_PREFILL=/root/app/vllm/cache/dsflash-pd-prefill
VLLM_CACHE_DECODE=/root/app/vllm/cache/dsflash-pd-decode
LMCACHE_L2_PATH=/root/app/lmcache/deepseek-v4-flash
VLLM_API_KEY=change-me

# Partition layouts: 43 transformer layers (nextn layers ride on the last rank).
DSFLASH_PREFILL_PARTITION=15,14,14
DSFLASH_DECODE_PARTITION=15,15,13

# Model-specific knobs - confirm against the image before trusting them.
#DSFLASH_TOKENIZER_MODE=deepseek_v41
#DSFLASH_TOOL_CALL_PARSER=deepseek_v41
#DSFLASH_REASONING_PARSER=deepseek_v41
#DSFLASH_KV_CACHE_DTYPE=fp8_ds_mla
#DSFLASH_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":1}
#DSFLASH_MAX_MODEL_LEN=1048576
