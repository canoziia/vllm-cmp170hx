# Extra variables for compose.pd.yml (prefill/decode disaggregated) on top of
# the values already documented in .env.example.
#
# One compile cache per role, because the two roles use different PP layouts.
VLLM_CACHE_PREFILL=/root/app/vllm/cache/qwen-pd-prefill
VLLM_CACHE_DECODE=/root/app/vllm/cache/qwen-pd-decode

# LMCache L2 (disk) tier for the shared KV store.
LMCACHE_L2_PATH=/root/app/lmcache/qwen3.8-flash-next-nvfp4

# Role tuning (defaults match the validated PP2 deployment for decode).
#PREFILL_MAX_NUM_SEQS=4
#PREFILL_MAX_BATCHED_TOKENS=8192
#PREFILL_KV_CACHE_MEMORY=8589934592
#DECODE_MAX_NUM_SEQS=32
#DECODE_MAX_BATCHED_TOKENS=4096
#DECODE_KV_CACHE_MEMORY=17179869184

# LMCache L1 (host RAM) tier per server; keep this small - 64 GiB per server
# OOM-killed this host while the 149 GiB DeepSeek model was loading.
LMCACHE_L1_SIZE_GB=8
