--- /dev/null
+++ b/vllm/models/qwen4_exp/nvidia/gdn_recover.py
@@ -0,0 +1,458 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.8 GDN RecoverSSM: speculative verification without speculative
+state blocks (VLLM_QWEN38_GDN_RECOVER, align mode, any PP size).
+
+Baseline MTP verification writes the recurrent state after every verified
+token into its own KV block (1 + K blocks per request and Mamba group) and the
+next step reads the accepted one. Here the verify kernel reads the committed
+state of the running block, writes no state, and records per request slot the
+exact operands of each token's state update (gate g, normalised key k and
+correction v'). After sampling, every PP rank commits on its own layers in
+``postprocess_state`` (the non-last rank's deferred postprocess carries the
+same accepted counts): the accepted prefix is replayed with the baseline's two
+update operations (``h *= exp(g); h += v' k^T``), so the committed state is
+bit-identical to the baseline's accepted-position state. The final state goes
+to the running block column ``(new - 1) // B``; when the window crossed a
+block boundary the boundary state goes to the boundary block (what the align
+postprocess would have copied there). Conv windows (GDN and PLE short conv)
+are compacted the same way (shift by ``accepted - 1``) and ``num_accepted``
+is reset to 1, so the unchanged align pre/postprocess and the generated-
+history checkpoints see normalised states. Records live per request slot,
+outside the KV pool.
+"""
+
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+
+from vllm.model_executor.layers.mamba.mamba_utils import is_conv_state_dim_first
+from vllm.triton_utils import tl, triton
+
+
+def enabled() -> bool:
+    import os
+
+    return os.environ.get("VLLM_QWEN38_GDN_RECOVER", "0") == "1"
+
+
+_NATIVE = None
+
+
+def native_op():
+    """The native fused GDN MTP kernel with a recording mode
+    (models/qwen3.8-flash-next-nvfp4/native/gdn_mtp_record), or None."""
+    global _NATIVE
+    if _NATIVE is None:
+        import glob
+        import os
+
+        op = False
+        for so in glob.glob(os.path.join(os.path.dirname(os.path.dirname(
+                os.path.dirname(os.path.dirname(__file__)))), "_qwen38_gdn_mtp_C*.so")):
+            try:
+                torch.ops.load_library(so)
+                op = torch.ops._qwen38_gdn_mtp_C.post_conv_mtp
+                break
+            except Exception:  # noqa: BLE001 - fall back to the Triton path
+                op = False
+        _NATIVE = op
+    return _NATIVE or None
+
+
+@triton.jit
+def _plan_kernel(
+    idx_mapping_ptr,
+    num_sampled_ptr,
+    pending_ptr,
+    num_computed_ptr,
+    state_idx_ptr,
+    plan_ptr,  # [max_reqs, 5]: n, src_col, final_col, boundary_col, boundary_len
+    MAMBA_BLOCK_SIZE: tl.constexpr,
+):
+    row = tl.program_id(0)
+    slot = tl.load(idx_mapping_ptr + row)
+    if slot < 0:
+        return
+    pending = tl.load(pending_ptr + slot)
+    n = tl.minimum(tl.load(num_sampled_ptr + row), pending)
+    n = tl.where(pending > 0, tl.maximum(n, 0), 0)
+    new = tl.load(num_computed_ptr + slot)
+    old = new - n
+    src_col = tl.load(state_idx_ptr + slot)
+    final_col = (new - 1) // MAMBA_BLOCK_SIZE
+    next_boundary = (old // MAMBA_BLOCK_SIZE + 1) * MAMBA_BLOCK_SIZE
+    # A distinct boundary block only when the accepted prefix passes it; an
+    # exactly aligned end is the final state itself (same block).
+    has_boundary = new > next_boundary
+    boundary_col = tl.where(has_boundary, next_boundary // MAMBA_BLOCK_SIZE - 1, -1)
+    p = plan_ptr + slot * 5
+    tl.store(p + 0, n)
+    tl.store(p + 1, src_col)
+    tl.store(p + 2, final_col)
+    tl.store(p + 3, boundary_col)
+    tl.store(p + 4, next_boundary - old)
+
+
+@triton.jit
+def _finalize_kernel(
+    idx_mapping_ptr,
+    pending_ptr,
+    state_idx_ptr,
+    num_accepted_ptr,
+    plan_ptr,
+):
+    row = tl.program_id(0)
+    slot = tl.load(idx_mapping_ptr + row)
+    if slot < 0:
+        return
+    n = tl.load(plan_ptr + slot * 5)
+    tl.store(pending_ptr + slot, 0)
+    if n > 0:
+        tl.store(state_idx_ptr + slot, tl.load(plan_ptr + slot * 5 + 2))
+        tl.store(num_accepted_ptr + slot, 1)
+
+
+@triton.jit
+def _replay_kernel(
+    idx_mapping_ptr,
+    plan_ptr,
+    block_table_ptrs_ptr,
+    block_table_stride_req,
+    layer_group_ptr,
+    state_addrs_ptr,
+    state_block_strides_ptr,
+    rec_addrs_ptr,
+    state_ref_ptr,
+    H: tl.constexpr,
+    HV: tl.constexpr,
+    K: tl.constexpr,
+    V: tl.constexpr,
+    BV: tl.constexpr,
+    REC_T: tl.constexpr,
+    REC_F: tl.constexpr,
+    USE_DECAY: tl.constexpr = True,
+):
+    i_v = tl.program_id(0)
+    row = tl.program_id(1)
+    i_lh = tl.program_id(2)
+    layer = i_lh // HV
+    i_hv = i_lh % HV
+    i_h = i_hv // (HV // H)
+    slot = tl.load(idx_mapping_ptr + row).to(tl.int64)
+    if slot < 0:
+        return
+    p = plan_ptr + slot * 5
+    n = tl.load(p + 0)
+    if n <= 0:
+        return
+    src_col = tl.load(p + 1)
+    final_col = tl.load(p + 2)
+    boundary_col = tl.load(p + 3)
+    boundary_len = tl.load(p + 4)
+
+    group = tl.load(layer_group_ptr + layer)
+    bt = tl.load(block_table_ptrs_ptr + group).to(tl.pointer_type(tl.int32))
+    bt = bt + slot * block_table_stride_req
+    src_block = tl.load(bt + src_col).to(tl.int64)
+    final_block = tl.load(bt + final_col).to(tl.int64)
+    if (src_block <= 0) | (final_block <= 0):
+        return
+
+    state = tl.load(state_addrs_ptr + layer).to(tl.pointer_type(state_ref_ptr.dtype.element_ty))
+    block_stride = tl.load(state_block_strides_ptr + layer)
+    rec = tl.load(rec_addrs_ptr + layer).to(tl.pointer_type(tl.float32))
+
+    o_k = tl.arange(0, K)
+    o_v = i_v * BV + tl.arange(0, BV)
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & (o_k[None, :] < K)
+    tile = i_hv * V * K + o_v[:, None] * K + o_k[None, :]
+    b_h = tl.load(state + src_block * block_stride + tile, mask=mask_h, other=0).to(
+        tl.float32
+    )
+    for t in range(0, n):
+        p_rec = rec + (slot * REC_T + t) * REC_F
+        b_g = tl.load(p_rec + i_hv)
+        b_k = tl.load(p_rec + HV + i_h * K + o_k)
+        b_v = tl.load(p_rec + HV + H * K + i_hv * V + o_v, mask=mask_v, other=0)
+        # The verifying kernel's state update, operand for operand: the
+        # Triton kernel records the gate g (decay exp(g) recomputed here), the
+        # native CUDA kernel records the decay itself.
+        if USE_DECAY:
+            # Native kernel: h *= decay; h = fma(k, delta, h).
+            b_h *= b_g
+            b_h = tl.fma(b_v[:, None], b_k[None, :], b_h)
+        else:
+            b_h *= tl.exp(b_g)
+            b_h += b_v[:, None] * b_k[None, :]
+        if (boundary_col >= 0) & (t + 1 == boundary_len):
+            boundary_block = tl.load(bt + boundary_col).to(tl.int64)
+            if boundary_block > 0:
+                tl.store(
+                    state + boundary_block * block_stride + tile,
+                    b_h.to(state_ref_ptr.dtype.element_ty),
+                    mask=mask_h,
+                )
+    tl.store(
+        state + final_block * block_stride + tile,
+        b_h.to(state_ref_ptr.dtype.element_ty),
+        mask=mask_h,
+    )
+
+
+@triton.jit
+def _compact_conv_kernel(
+    idx_mapping_ptr,
+    plan_ptr,
+    block_table_ptrs_ptr,
+    block_table_stride_req,
+    conv_group_ptr,
+    conv_addrs_ptr,
+    conv_block_strides_ptr,
+    conv_dim_strides_ptr,
+    conv_tok_strides_ptr,
+    conv_dims_ptr,
+    conv_hist_ptr,
+    conv_ref_ptr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_HIST: tl.constexpr,
+):
+    pid_d = tl.program_id(0)
+    row = tl.program_id(1)
+    layer = tl.program_id(2)
+    slot = tl.load(idx_mapping_ptr + row).to(tl.int64)
+    if slot < 0:
+        return
+    p = plan_ptr + slot * 5
+    n = tl.load(p + 0)
+    if n <= 0:
+        return
+    src_col = tl.load(p + 1)
+    final_col = tl.load(p + 2)
+    boundary_col = tl.load(p + 3)
+    boundary_len = tl.load(p + 4)
+    dims = tl.load(conv_dims_ptr + layer)
+    hist = tl.load(conv_hist_ptr + layer)
+    if pid_d * BLOCK_D >= dims:
+        return
+
+    group = tl.load(conv_group_ptr + layer)
+    bt = tl.load(block_table_ptrs_ptr + group).to(tl.pointer_type(tl.int32))
+    bt = bt + slot * block_table_stride_req
+    src_block = tl.load(bt + src_col).to(tl.int64)
+    final_block = tl.load(bt + final_col).to(tl.int64)
+    if (src_block <= 0) | (final_block <= 0):
+        return
+    conv = tl.load(conv_addrs_ptr + layer).to(tl.pointer_type(conv_ref_ptr.dtype.element_ty))
+    block_stride = tl.load(conv_block_strides_ptr + layer)
+    dim_stride = tl.load(conv_dim_strides_ptr + layer)
+    tok_stride = tl.load(conv_tok_strides_ptr + layer)
+
+    o_d = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
+    o_t = tl.arange(0, BLOCK_HIST)
+    mask = (o_d[:, None] < dims) & (o_t[None, :] < hist)
+    src = conv + src_block * block_stride + o_d[:, None] * dim_stride
+    final_vals = tl.load(src + (n - 1 + o_t[None, :]) * tok_stride, mask=mask)
+    has_boundary = boundary_col >= 0
+    boundary_vals = tl.load(
+        src + (boundary_len - 1 + o_t[None, :]) * tok_stride,
+        mask=mask & has_boundary,
+    )
+    # All loads precede the stores: source and destination may be one block.
+    tl.debug_barrier()
+    if has_boundary:
+        boundary_block = tl.load(bt + boundary_col).to(tl.int64)
+        if boundary_block > 0:
+            tl.store(
+                conv
+                + boundary_block * block_stride
+                + o_d[:, None] * dim_stride
+                + o_t[None, :] * tok_stride,
+                boundary_vals,
+                mask=mask,
+            )
+    tl.store(
+        conv + final_block * block_stride + o_d[:, None] * dim_stride
+        + o_t[None, :] * tok_stride,
+        final_vals,
+        mask=mask,
+    )
+
+
+def _addrs(tensors, device):
+    return torch.tensor([t.data_ptr() for t in tensors], dtype=torch.int64, device=device)
+
+
+@dataclass
+class GDNRecoverContext:
+    """Static per-rank layout: GDN layers (state + record) and every conv
+    state (GDN conv and PLE short conv) with its Mamba group position."""
+
+    state_ref: torch.Tensor | None
+    layer_group: torch.Tensor
+    state_addrs: torch.Tensor
+    state_block_strides: torch.Tensor
+    rec_addrs: torch.Tensor
+    num_layers: int
+    H: int
+    HV: int
+    K: int
+    V: int
+    rec_t: int
+    rec_f: int
+    conv_ref: torch.Tensor | None
+    conv_group: torch.Tensor
+    conv_addrs: torch.Tensor
+    conv_block_strides: torch.Tensor
+    conv_dim_strides: torch.Tensor
+    conv_tok_strides: torch.Tensor
+    conv_dims: torch.Tensor
+    conv_hist: torch.Tensor
+    num_convs: int
+    max_dim: int
+    max_hist: int
+    plan: torch.Tensor
+    pending: torch.Tensor
+
+    @classmethod
+    def create(
+        cls,
+        kv_cache_config,
+        forward_context: dict[str, Any],
+        mamba_group_ids: list[int],
+        max_num_reqs: int,
+        num_spec: int,
+        device: torch.device,
+    ) -> "GDNRecoverContext":
+        gdn, gdn_groups, convs, conv_groups, hists = [], [], [], [], []
+        for pos, gid in enumerate(mamba_group_ids):
+            for name in kv_cache_config.kv_cache_groups[gid].layer_names:
+                layer = forward_context[name]
+                # Both layers canonicalise their conv cache to
+                # [block, channel, window] the same way.
+                conv = layer.kv_cache[0]
+                if not is_conv_state_dim_first():
+                    conv = conv.transpose(-1, -2)
+                if hasattr(layer, "_qwen38_rec"):
+                    gdn.append(layer)
+                    gdn_groups.append(pos)
+                    hists.append(conv.shape[2] - num_spec)
+                else:
+                    # PLE short conv uses the trailing window of its cache.
+                    capacity = layer.conv_state_len + layer.num_spec_tokens
+                    conv = conv[..., -capacity:]
+                    hists.append(layer.conv_state_len)
+                convs.append(conv)
+                conv_groups.append(pos)
+        states = [layer.kv_cache[1] for layer in gdn]
+        recs = [layer.qwen38_record_buffer(max_num_reqs) for layer in gdn]
+        ref = states[0] if states else None
+        if ref is not None:
+            assert all(
+                s.shape[1:] == ref.shape[1:]
+                and s.dtype == ref.dtype
+                and s.stride()[1:] == (ref.shape[2] * ref.shape[3], ref.shape[3], 1)
+                for s in states
+            ), "GDN RecoverSSM needs one contiguous state layout per rank"
+            HV, V, K = ref.shape[1:]
+            H = gdn[0].qwen38_rec_heads
+        else:
+            HV = V = K = H = 1
+        i32 = dict(dtype=torch.int32, device=device)
+        i64 = dict(dtype=torch.int64, device=device)
+        return cls(
+            state_ref=ref,
+            layer_group=torch.tensor(gdn_groups or [0], **i32),
+            state_addrs=_addrs(states, device) if states else torch.zeros(1, **i64),
+            state_block_strides=torch.tensor([s.stride(0) for s in states] or [0], **i64),
+            rec_addrs=_addrs(recs, device) if recs else torch.zeros(1, **i64),
+            num_layers=len(gdn),
+            H=H,
+            HV=HV,
+            K=K,
+            V=V,
+            rec_t=recs[0].shape[1] if recs else 1,
+            rec_f=recs[0].shape[2] if recs else 1,
+            conv_ref=convs[0] if convs else None,
+            conv_group=torch.tensor(conv_groups or [0], **i32),
+            conv_addrs=_addrs(convs, device) if convs else torch.zeros(1, **i64),
+            conv_block_strides=torch.tensor([c.stride(0) for c in convs] or [0], **i64),
+            conv_dim_strides=torch.tensor([c.stride(1) for c in convs] or [0], **i64),
