 vllm/model_executor/warmup/kernel_warmup.py   |   9 +
 vllm/models/qwen4_exp/nvidia/ops/thin_gemm.py | 618 ++++++++++++++++++
 3 files changed, 646 insertions(+)
 create mode 100644 vllm/models/qwen4_exp/nvidia/ops/thin_gemm.py

