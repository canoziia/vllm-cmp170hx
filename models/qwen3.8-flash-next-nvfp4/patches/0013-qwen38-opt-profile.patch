diff --git a/vllm/qwen38_opt_profile.py b/vllm/qwen38_opt_profile.py
new file mode 100644
index 0000000..a5cf1da
--- /dev/null
+++ b/vllm/qwen38_opt_profile.py
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One switch for the Qwen3.8 Flash Next NVFP4 CMP 170HX optimisation patches.
+
+VLLM_QWEN38_OPT_PROFILE=default sets every per-patch switch to its deployed
+value *unless that variable is already set*, so a single switch can still be
+overridden (e.g. VLLM_QWEN38_FAST_MOE_ALIGN=0). Unset / "0" / "off": nothing
+is changed (every patch stays at its own default, which is off). Applied from
+vllm.env_override, i.e. before any other vLLM module is imported, in the API
+server and in every spawned worker. The switch list is documented in
+models/qwen3.8-flash-next-nvfp4/README.md.
+"""
+import os
+
+PROFILES: dict[str, dict[str, str]] = {
+    "default": {
+        # single-kernel deterministic MoE block alignment
+        "VLLM_QWEN38_FAST_MOE_ALIGN": "1",
+        # fp8 copy of lm_head for MTP draft logits
+        "VLLM_QWEN38_DRAFT_HEAD_FP8": "1",
+        # sm80 thin-M BF16 GEMM for measured unquantized shapes
+        "VLLM_QWEN38_THIN_GEMM": "1",
+        # native n-gram hashing in the PLE offload worker
+        "VLLM_QWEN38_PLE_NATIVE_HASH": "1",
+        # MTP draft widths: draft k, verify exactly those k (per-batch k,
+        # per-step-count drafter graphs, manual vllm_xargs.spec_k)
+        "VLLM_QWEN38_VERIFICATION_WIDTHS": "1",
+        # measured per-request choice of k (DeepSeek measured policy)
+        "VLLM_QWEN38_ADAPTIVE_WIDTH": "1",
+        # PLE short conv without speculative state blocks (align mode)
+        "VLLM_QWEN38_PLE_NO_SPEC_BLOCKS": "1",
+        # GDN RecoverSSM: no speculative state blocks (native recording MTP
+        # kernel; falls back to the Triton recording path without it)
+        "VLLM_QWEN38_GDN_RECOVER": "1",
+        # shared-expert gate sigmoid*mul in one launch (bit-identical)
+        "VLLM_QWEN38_FUSED_SHARED_GATE": "1",
+    },
+}
+
+
+def apply() -> None:
+    name = os.environ.get("VLLM_QWEN38_OPT_PROFILE", "").strip().lower()
+    if name in ("", "0", "off", "none"):
+        return
+    if name not in PROFILES:
+        raise ValueError(
+            f"VLLM_QWEN38_OPT_PROFILE={name!r}: unknown profile "
+            f"(known: {', '.join(sorted(PROFILES))})")
+    for key, value in PROFILES[name].items():
+        os.environ.setdefault(key, value)
