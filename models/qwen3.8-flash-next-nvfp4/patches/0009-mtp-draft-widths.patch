diff --git a/vllm/v1/core/sched/qwen38_spec_k.py b/vllm/v1/core/sched/qwen38_spec_k.py
new file mode 100644
index 0000000..d7c3caa
--- /dev/null
+++ b/vllm/v1/core/sched/qwen38_spec_k.py
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.8 request-local verification width (``vllm_xargs.spec_k``).
+
+``vllm_xargs`` already reaches ``SamplingParams.extra_args`` unchanged for every
+model. Only Qwen3.8 architectures consult this module (two architecture-gated
+call sites: input validation and scheduler admission); every other model
+ignores the key exactly like the unpatched engine.
+"""
+import os
+
+from vllm.exceptions import VLLMValidationError
+
+
+def is_qwen38(architectures) -> bool:
+    return any(a.startswith(("Qwen4Exp", "Qwen3_8FlashNext")) for a in architectures or ())
+
+
+def _widths_enabled() -> bool:
+    return os.environ.get("VLLM_QWEN38_VERIFICATION_WIDTHS", "0") == "1"
+
+
+def validate_request(extra_args, speculative_config) -> None:
+    """Front-end validation; failures surface as HTTP 400."""
+    if not extra_args or "spec_k" not in extra_args:
+        return
+    value = extra_args["spec_k"]
+    if type(value) is not int or value < 0:
+        raise VLLMValidationError(
+            "vllm_xargs.spec_k must be a nonnegative integer",
+            parameter="vllm_xargs.spec_k",
+        )
+    if (
+        speculative_config is None
+        or speculative_config.method != "mtp"
+        or not _widths_enabled()
+    ):
+        raise VLLMValidationError(
+            "spec_k requires VLLM_QWEN38_VERIFICATION_WIDTHS=1 and Qwen3.8 MTP",
+            parameter="vllm_xargs.spec_k",
+        )
+    if not 0 <= value <= speculative_config.num_speculative_tokens:
+        raise VLLMValidationError(
+            "spec_k must be an integer between 0 and configured draft count",
+            parameter="vllm_xargs.spec_k",
+        )
+
+
+def draft_limit(request, spec, num_spec_tokens: int, use_v2_model_runner: bool) -> int | None:
+    """Scheduler admission: the request's verified-draft limit, or None."""
+    params = request.sampling_params
+    extra = params.extra_args if params is not None else None
+    limit = extra.get("spec_k") if extra else None
+    if limit is None:
+        return None
+    if spec is None or spec.method != "mtp" or not use_v2_model_runner or not _widths_enabled():
+        raise ValueError("spec_k requires Qwen3.8 MTP verification widths")
+    if type(limit) is not int or not 0 <= limit <= num_spec_tokens:
+        raise ValueError("spec_k must be an integer in the configured draft range")
+    return limit
diff --git a/vllm/v1/core/sched/qwen38_verification_policy.py b/vllm/v1/core/sched/qwen38_verification_policy.py
new file mode 100644
index 0000000..f75bff5
--- /dev/null
+++ b/vllm/v1/core/sched/qwen38_verification_policy.py
@@ -0,0 +1,372 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Request-local measured MTP verification width for Qwen3.8 (CPU only).
+
+VLLM_QWEN38_ADAPTIVE_WIDTH=1 (default 0 = unchanged; requires
+VLLM_QWEN38_VERIFICATION_WIDTHS=1). Port of the DeepSeek V4.1 measured
+verification policy (models/deepseek-v4.1-flash adaptive/0009) generalised from
+DSpark k<=5 to MTP k<=K:
+
+* per request, per verified width: discounted (decay 0.95) at-risk acceptance
+  per draft position, output tokens and CPU-visible feedback recurrence time;
+* each width's measured output/time is blended with one predicted pseudo-block
+  (prefix-acceptance expectation x Qwen's measured step cost at the current
+  concurrency), calibrated to the current width's observed level;
+* a cold first trim needs +3 % over the incumbent (choosing the widest width
+  within 98 % of the peak); afterwards a change needs +3 % plus a ratio and
+  paired-prefix uncertainty gate; growth is at most one width per decision;
+* manual vllm_xargs.spec_k always wins; any policy failure keeps full K.
+
+The choice is a draft count: when the scheduler schedules a batch it decides
+how many drafts the MTP drafter generates for it, and the next step verifies
+exactly those drafts (growing the width means drafting more next time). Qwen's
+decode graphs are exact only for uniform batches, so the choices of the
+requests in one scheduled batch are combined into one count: the width
+(between the smallest and largest member choice) with the highest summed
+relative policy score.
+No task labels, external IO, CUDA objects or fixed observation windows.
+"""
+
+import math
+import time
+from types import SimpleNamespace
+
+# Measured full-batch step time (ms) on 2x CMP 170HX, PP2, MTP5 build, by
+# concurrency and drafts generated = verified k = 1..5 (index k-1); drafting
+# k steps, verifying k (mean over counting/code/prose). c32 from the MTP3
+# build (k1..k3) extrapolated, because MTP5 does not fit 32 requests in the
+# fixed KV budget.
+COST_MS = {
+    1: (17.2, 19.4, 20.9, 22.5, 24.0),
+    8: (26.2, 28.5, 33.7, 38.9, 39.9),
+    32: (41.2, 51.3, 58.5, 65.7, 72.9),
+}
+
+
+def costs(c, k_max):
+    cs = sorted(COST_MS)
+
+    def row(v):
+        v = list(v)[:k_max]
+        while len(v) < k_max:  # extrapolate linearly in k if K > table width
+            v.append(v[-1] + (v[-1] - v[-2] if len(v) > 1 else 0.0))
+        return [x / 1000 for x in v]
+
+    if c <= cs[0]:
+        return row(COST_MS[cs[0]])
+    for lo, hi in zip(cs, cs[1:]):
+        if c <= hi:
+            w = (c - lo) / (hi - lo)
+            return row(a * (1 - w) + b * w for a, b in zip(COST_MS[lo], COST_MS[hi]))
+    return row(COST_MS[cs[-1]])
+
+
+class Policy:
+    def __init__(self, k_max, decay=0.95, prediction_weight=1.0):
+        if not 0 <= decay < 1 or not 0 < prediction_weight <= 100 or k_max < 1:
+            raise ValueError("invalid config")
+        K = self.K = int(k_max)
+        self.decay = float(decay)
+        self.w = float(prediction_weight)
+        self.k = K
+        self.n = [0.0] * K
+        self.y = [0.0] * K
+        self.t = [0.0] * K
+        self.risk = [0.0] * K
+        self.success = [0.0] * K
+        self.prior = 1.0
+        self.epoch = None
+        self.diagnostics = {}
+        self.latest = None
+        self.trimmed = False
+        self.history = [[0.0] * (K + 1) for _ in range(K)]
+        self.q = [0.0] * K
+        self.y2 = [0.0] * K
+        self.t2 = [0.0] * K
+        self.yt = [0.0] * K
+
+    def observe(self, e):
+        K = self.K
+        k = e["k"]
+        a = e["accepted"]
+        dt = e["seconds"]
+        if not 1 <= k <= K or not 0 <= a <= k:
+            raise ValueError("invalid feedback")
+        self.latest = e.copy()
+        self.history = [[v * self.decay for v in row] for row in self.history]
+        self.history[k - 1][a] += 1
+        self.prior *= self.decay
+        if self.epoch != e["load_epoch"]:
+            self.n = [0.0] * K
+            self.y = [0.0] * K
+            self.t = [0.0] * K
+            self.epoch = e["load_epoch"]
+            self.q = [0.0] * K
+            self.y2 = [0.0] * K
+            self.t2 = [0.0] * K
+            self.yt = [0.0] * K
+        for j in range(K):
+            self.n[j] *= self.decay
+            self.y[j] *= self.decay
+            self.t[j] *= self.decay
+            self.q[j] *= self.decay**2
+            self.y2[j] *= self.decay
+            self.t2[j] *= self.decay
+            self.yt[j] *= self.decay
+            self.risk[j] *= self.decay
+            self.success[j] *= self.decay
+            if j < k:
+                self.risk[j] += 1
+                self.success[j] += a > j
+        if e["timing_valid"]:
+            j = k - 1
+            y = e["output_tokens"]
+            self.n[j] += 1
+            self.y[j] += y
+            self.t[j] += dt
+            self.q[j] += 1
+            self.y2[j] += y * y
+            self.t2[j] += dt * dt
+            self.yt[j] += y * dt
+
+    def choose(self, context):
+        K = self.K
+        self.k = context["current_k"]
+        p = []
+        previous = 1.0
+        for n, s in zip(self.risk, self.success):
+            previous = min(
+                previous, (s + self.prior + 0.5 * previous) / (n + self.prior + 1)
+            )
+            p.append(previous)
+        E = [1 + sum(p[:k]) for k in range(1, K + 1)]
+        C = costs(context["concurrency"], K)
+        # Calibrate predictions to the current observed level; keep ratios.
+        i = self.k - 1
+        scale = self.y[i] / self.n[i] / E[i] if self.n[i] else 1.0
+        time_scale = self.t[i] / self.n[i] / C[i] if self.n[i] else 1.0
+        predicted_y = [e * scale for e in E]
+        predicted_t = [c * time_scale for c in C]
+        scores = [
+            (y + self.w * e) / (t + self.w * c)
+            for y, t, e, c in zip(self.y, self.t, predicted_y, predicted_t)
+        ]
+        se = []
+        for j in range(K):
+            n = self.n[j]
+            if n <= 0:
+                se.append(0.0)
+                continue
+            rate = self.y[j] / self.t[j]
+            variance = max(
+                0.0, (self.y2[j] - 2 * rate * self.yt[j] + rate * rate * self.t2[j]) / n
+            )
+            ess = min(n, n * n / self.q[j])
+            se.append((variance + 1.0) ** 0.5 / (self.t[j] / n) / (ess + 1) ** 0.5)
+        fractions = [t / (t + self.w * c) for t, c in zip(self.t, predicted_t)]
+        gate = [f * (s * s + se[self.k - 1] ** 2) ** 0.5 for f, s in zip(fractions, se)]
+        hist = self.history[i]
+        mass = sum(hist)
+        model_se = []
+        for j in range(K):
+            if j >= i:
+                model_se.append(0.0)
+                continue
+            diffs = [
+                ((1 + min(a, j + 1)) / C[j] - (1 + min(a, self.k)) / C[i])
+                * scale
+                / time_scale
+                for a in range(K + 1)
+            ]
+            mean = sum(w * d for w, d in zip(hist, diffs)) / mass if mass else 0.0
+            variance = (
+                sum(w * (d - mean) ** 2 for w, d in zip(hist, diffs)) / mass
+                if mass
+                else 0.0
+            )
+            model_se.append((variance / (mass + 1)) ** 0.5)
+        gate = [(a * a + b * b) ** 0.5 for a, b in zip(gate, model_se)]
+        ready = bool(
+            self.latest and self.latest["k"] == self.k and self.latest["timing_valid"]
+        )
+        best = self.k
+        if ready:
+            if not self.trimmed:
+                peak = max(scores)
+                cold = max(k for k in range(1, K + 1) if scores[k - 1] >= 0.98 * peak)
+                if scores[cold - 1] > scores[best - 1] * 1.03:
+                    best = cold
+            else:
+                for k in range(1, min(K, self.k + 1) + 1):
+                    if (
+                        scores[k - 1] - scores[self.k - 1]
+                        > 0.03 * scores[self.k - 1] + gate[k - 1]
+                        and scores[k - 1] > scores[best - 1]
+                    ):
+                        best = k
+        if best < K:
+            self.trimmed = True
+        self.diagnostics = dict(score=scores, se=se, gate=gate, ready=ready)
+        return best
+
+
+class MeasuredWidthPolicy:
+    """Scheduler adapter: generation-pinned per-request entries.
+
+    Only valid actual-width feedback advances selection; the retained width is
+    used between decisions. Feedback recurrence is CPU-visible cadence (PP
+    cadence and queueing included), not GPU kernel time.
+    """
+
+    def __init__(self, logger, k_max, decay=0.95):
+        if isinstance(decay, bool) or not math.isfinite(decay) or not 0 <= decay < 1:
+            raise ValueError("invalid history decay")
+        self.logger = logger
+        self.K = int(k_max)
+        self.decay = decay
+        self.active = {}
+        self.generation = 0
+        self.feedback_time = None
+        self.warned = False
+        logger.info(
+            "Qwen3.8 measured MTP verification width policy: K=%d decay=%s",
+            self.K,
+            decay,
+        )
+
+    def admit(self, request):
+        if getattr(request, "verification_draft_limit", None) is None:
+            self.generation += 1
+            self.active[request.request_id] = SimpleNamespace(
+                plugin=Policy(self.K, self.decay),
+                k=self.K,
+                generation=self.generation,
+                previous=None,
+                fresh=False,
+                failed=False,
+            )
+
+    def forget(self, request_id):
+        self.active.pop(request_id, None)
+
+    def _fail(self, entry, exc):
+        # Fail closed to full K. No retry until the next admission.
+        entry.failed = True
+        entry.k = self.K
+        entry.fresh = False
+        if not self.warned:
+            self.logger.warning(
+                "Qwen3.8 width policy failure (%s); full K retained",
+                type(exc).__name__,
+            )
+            self.warned = True
+
+    def manages(self, request):
+        return request.request_id in self.active
+
+    def next_width(self, requests, concurrency):
+        """Next draft count for one scheduled batch.
+
+        Each managed request's measured choice is updated only after fresh
+        feedback. One batch count is needed (exact uniform graphs): among the
+        widths between the smallest and the largest member choice, take the
+        one with the highest summed relative score, i.e. each request's
+        policy score at that width divided by its score at its own choice. A
+        single request (or a batch that agrees) gets exactly its choice."""
+        entries = []
+        for r in requests:
+            entry = self.active.get(r.request_id)
+            if entry is None:
+                continue
+            if not entry.failed and entry.fresh:
+                try:
+                    k = entry.plugin.choose(
+                        dict(current_k=entry.k, concurrency=concurrency)
+                    )
+                    if type(k) is not int or not 1 <= k <= self.K or k > entry.k + 1:
+                        raise ValueError("policy width outside allowed transition")
+                    entry.k = k
+                    entry.fresh = False
+                    entry.scores = list(entry.plugin.diagnostics.get("score", ()))
+                except Exception as exc:  # noqa: BLE001 - fail closed
+                    self._fail(entry, exc)
+            entries.append(entry)
+        if not entries:
+            return 1
+        lo = min(e.k for e in entries)
+        hi = max(e.k for e in entries)
+        if lo == hi:
+            return hi
+
+        def utility(k):
+            total = 0.0
+            for e in entries:
+                scores = getattr(e, "scores", None)
+                if e.failed or not scores or len(scores) < self.K or scores[e.k - 1] <= 0:
+                    # No usable model: this member only accepts its own width
+                    # or wider (never narrower than an unknown preference).
+                    total += 1.0 if k >= e.k else 0.0
+                else:
+                    total += scores[k - 1] / scores[e.k - 1]
+            return total
+
+        # Ties prefer the wider width (as the per-request cold rule does).
+        return max(range(lo, hi + 1), key=lambda k: (utility(k), k))
+
+    def scheduled(self, output, residents, concurrency):
+        if not self.active:
+            return
+        now = time.perf_counter()
+        key = tuple(sorted(r.request_id for r in residents))
+        prefilling = any(r.is_prefill_chunk for r in residents)
+        stamps = {}
+        for rid, drafts in output.scheduled_spec_decode_tokens.items():
+            entry = self.active.get(rid)
+            if entry is not None and not entry.failed:
+                stamps[rid] = (entry.generation, now, key, prefilling, len(drafts))
+        output._qwen38_width_stamps = stamps
+
+    def begin_feedback(self):
+        self.feedback_time = time.perf_counter()
+
+    def feedback(self, output, request, drafted, accepted, output_tokens, valid):
+        rid = request.request_id
+        entry = self.active.get(rid)
+        stamp = getattr(output, "_qwen38_width_stamps", {}).get(rid)
+        if entry is None or stamp is None or stamp[0] != entry.generation or entry.failed:
+            return
+        _, sent, key, prefilling, actual_k = stamp
+        now = self.feedback_time if self.feedback_time is not None else time.perf_counter()
+        previous = entry.previous
+        entry.previous = (now, key, prefilling, actual_k)
+        seconds = now - sent
+        timing_valid = bool(
+            valid
+            and not prefilling
+            and previous is not None
+            and previous[1] == key
+            and not previous[2]
+            and previous[3] == actual_k
+        )
+        if timing_valid:
+            seconds = now - previous[0]
+        if not valid:
+            entry.previous = None
+            return
+        if not 0 < seconds < 60 or actual_k != drafted or drafted < 1:
+            timing_valid = False
+        if drafted < 1:
+            return
+        try:
+            entry.plugin.observe(
+                dict(
+                    k=drafted,
+                    accepted=accepted,
+                    output_tokens=output_tokens,
+                    seconds=seconds,
+                    timing_valid=timing_valid,
+                    load_epoch=hash(key),
+                )
+            )
+            entry.fresh = True
+        except Exception as exc:  # noqa: BLE001 - fail closed
+            self._fail(entry, exc)
