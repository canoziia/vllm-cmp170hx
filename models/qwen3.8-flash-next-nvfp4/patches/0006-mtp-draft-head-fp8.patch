+    def build_fp8_draft_head(self) -> None:
+        """Build the weight-only fp8 draft head from the (shared) lm_head.
+
+        Must run after load_eagle_model shared the target lm_head and before
+        CUDA-graph capture. No-op on stages that do not host the head.
+        """
+        if not isinstance(self.lm_head, ParallelLMHead):
+            return
+        from .mtp_fp8_head import Fp8DraftHead
+
+        lp = self.logits_processor
+        if self.lm_head.tp_size != 1:
+            raise ValueError("VLLM_QWEN38_DRAFT_HEAD_FP8 requires TP=1")
+        if getattr(self.lm_head, "bias", None) is not None:
+            raise ValueError("VLLM_QWEN38_DRAFT_HEAD_FP8: lm_head has a bias")
+        if lp.head_dtype is not None and lp.head_dtype != self.lm_head.weight.dtype:
+            raise ValueError("VLLM_QWEN38_DRAFT_HEAD_FP8: head_dtype override set")
+        if lp.logits_as_input:
+            raise ValueError("VLLM_QWEN38_DRAFT_HEAD_FP8: logits_as_input set")
+        with torch.no_grad():
+            self._fp8_draft_head = Fp8DraftHead(self.lm_head.weight.data)
+        torch.cuda.empty_cache()
+        logger.info(
+            "Qwen3.8 MTP: fp8 draft lm_head built (%.2f GiB, shape %s)",
+            self._fp8_draft_head.nbytes() / 2**30,
+            tuple(self.lm_head.weight.shape),
+        )
+
     def compute_logits(
         self, hidden_states: torch.Tensor, spec_step_idx: int = 0
     ) -> torch.Tensor | None:
+        if self._fp8_draft_head is not None:
+            # Mirrors LogitsProcessor.forward at TP=1 with the projection
+            # swapped: drop vocab padding, then soft cap and scale.
+            lp = self.logits_processor
+            logits = self._fp8_draft_head(hidden_states)
+            logits = logits[..., : lp.org_vocab_size]
+            if lp.soft_cap is not None:
+                logits = torch.tanh(logits / lp.soft_cap) * lp.soft_cap
+            if lp.scale != 1.0:
+                logits = logits * lp.scale
+            return logits
         return self.logits_processor(self.lm_head, hidden_states)
 
