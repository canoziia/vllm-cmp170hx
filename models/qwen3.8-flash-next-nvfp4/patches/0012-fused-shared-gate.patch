From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] qwen3.8: shared-expert gate in one kernel

VLLM_QWEN38_FUSED_SHARED_GATE (default 0 = unchanged). The shared expert's
F.sigmoid(gate) * out (a sigmoid plus a broadcast multiply per MoE layer) runs
as one Triton kernel that rounds exactly where torch does (sigmoid in FP32 to
BF16, product in FP32 to BF16): bit-identical, one launch instead of two.
---
 vllm/model_executor/models/qwen2_moe.py       |  9 ++-
 .../qwen4_exp/nvidia/ops/shared_gate.py       | 69 +++++++++++++++++++
 2 files changed, 77 insertions(+), 1 deletion(-)
 create mode 100644 vllm/models/qwen4_exp/nvidia/ops/shared_gate.py

diff --git a/vllm/model_executor/models/qwen2_moe.py b/vllm/model_executor/models/qwen2_moe.py
index 3d13453..d0fa8d7 100644
--- a/vllm/model_executor/models/qwen2_moe.py
+++ b/vllm/model_executor/models/qwen2_moe.py
@@ -115,7 +115,14 @@ class Qwen2MoeMLP(nn.Module):
         out, _ = self.down_proj(out)
 
         if self.expert_gate is not None:
-            out = F.sigmoid(self.expert_gate(x)[0]) * out
+            gate = self.expert_gate(x)[0]
+            from vllm.models.qwen4_exp.nvidia.ops import shared_gate
+
+            if shared_gate.enabled() and shared_gate.supported(gate, out):
+                # One launch, bit-identical to sigmoid + broadcast multiply.
+                out = shared_gate.shared_gate_mul(gate, out)
+            else:
+                out = F.sigmoid(gate) * out
 
         return out
 
diff --git a/vllm/models/qwen4_exp/nvidia/ops/shared_gate.py b/vllm/models/qwen4_exp/nvidia/ops/shared_gate.py
new file mode 100644
index 0000000..2e6043f
--- /dev/null
+++ b/vllm/models/qwen4_exp/nvidia/ops/shared_gate.py
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.8 shared-expert gate in one kernel (VLLM_QWEN38_FUSED_SHARED_GATE).
+
+``F.sigmoid(gate_logits) * out`` runs as a sigmoid kernel plus a broadcast
+multiply ([T, 1] x [T, H]) per MoE layer. This kernel computes the identical
+values in one launch: torch evaluates sigmoid of a BF16 tensor in FP32 and
+rounds to BF16, then multiplies BF16 x BF16 in FP32 and rounds to BF16; the
+kernel does exactly that, so the result is bit-identical.
+"""
+
+import os
+
+import torch
+
+from vllm.triton_utils import tl, triton
+from vllm.utils.torch_utils import direct_register_custom_op
+
+
+def enabled() -> bool:
+    return os.environ.get("VLLM_QWEN38_FUSED_SHARED_GATE", "0") == "1"
+
+
+@triton.jit
+def _shared_gate_kernel(g_ptr, x_ptr, o_ptr, H, stride_g, stride_x, stride_o, BLOCK: tl.constexpr):
+    t = tl.program_id(0)
+    offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < H
+    g = tl.load(g_ptr + t * stride_g).to(tl.float32)
+    s = tl.sigmoid(g).to(tl.bfloat16).to(tl.float32)
+    x = tl.load(x_ptr + t * stride_x + offs, mask=m).to(tl.float32)
+    tl.store(o_ptr + t * stride_o + offs, (x * s).to(tl.bfloat16), mask=m)
+
+
+def supported(gate: torch.Tensor, out: torch.Tensor) -> bool:
+    return (
+        out.dtype == torch.bfloat16
+        and gate.dtype == torch.bfloat16
+        and out.dim() == 2
+        and gate.dim() == 2
+        and gate.shape == (out.shape[0], 1)
+        and out.stride(1) == 1
+        and out.is_cuda
+    )
+
+
+def _shared_gate_impl(gate: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    T, H = out.shape
+    res = torch.empty_like(out)
+    if T:
+        _shared_gate_kernel[(T, triton.cdiv(H, 1024))](
+            gate, out, res, H, gate.stride(0), out.stride(0), res.stride(0), BLOCK=1024
+        )
+    return res
+
+
+def _shared_gate_fake(gate: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    return torch.empty_like(out)
+
+
+direct_register_custom_op(
+    op_name="qwen38_shared_gate_mul",
+    op_func=_shared_gate_impl,
+    fake_impl=_shared_gate_fake,
+)
+
+
+def shared_gate_mul(gate: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    """sigmoid(gate) * out, bit-identical to the two torch ops."""
+    return torch.ops.vllm.qwen38_shared_gate_mul(gate, out)
