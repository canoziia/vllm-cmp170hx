# Copy to .env next to compose.yml, chmod 600. Never commit the real file.
VLLM_API_KEY=change-me

MIMO_IMAGE=localhost/vllm-backport:mimo-v2.6-flash
# Flat download dir (see /root/app/models/MiMo-V2.6-Flash-MOPD.PROVENANCE.txt)
MIMO_MODEL_DIR=/root/app/models/MiMo-V2.6-Flash-MOPD
MIMO_VLLM_CACHE=/root/app/vllm/cache/mimo-v2.6-flash
MIMO_PORT=8401

# GPUs (CDI nvidia.com/gpu=<index>) for PP ranks 0-3. podman-compose 1.3 does
# not expand ${VAR:-default} for variables missing from .env, so keep all four.
MIMO_GPU_0=5
MIMO_GPU_1=6
MIMO_GPU_2=7
MIMO_GPU_3=8

# 48 decoder layers; rank 0 also holds the embedding, rank 3 lm_head, the three
# MTP heads, the fp8 draft head and runs the drafter: 9 layers there. Peak
# GPU memory 59.2 / 61.2 / 61.2 / 47.8 GiB.
MIMO_PP_LAYER_PARTITION=13,13,13,9

MIMO_MAX_MODEL_LEN=1048576
MIMO_MAX_NUM_SEQS=32
MIMO_MAX_NUM_BATCHED_TOKENS=4096
# Per-rank GPU KV budget in bytes (skips memory profiling). One 1048576-token
# request needs 8.98 GiB/rank (hybrid SWA/global groups add up to 12.5% padding).
MIMO_KV_CACHE_MEMORY=12884901888

# One switch for the MiMo patch series (0003): "default" turns on every
# adopted optimisation (table in README.md); unset/off keeps upstream behaviour.
VLLM_MIMO26_OPT_PROFILE=default

# MTP width. With the profile, draft step k runs checkpoint MTP layer k (three
# parallel heads, patch 0002), so the width must be a multiple of 3; 3 is the
# measured best. Without the profile vLLM reuses MTP layer 0 for every step.
MIMO_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}

# Shared async-PP decode batch balancing (patches/vllm/0003), as DeepSeek/GLM.
# MiMo c32 +36-63 %, c1 bit-identical; 0 = upstream.
VLLM_PP_DECODE_COHORT_BALANCE=1

# --- prefill/decode (compose.pd.yml); decode uses MIMO_GPU_* and MIMO_VLLM_CACHE ---
MIMO_PREFILL_GPU_0=1
MIMO_PREFILL_GPU_1=2
MIMO_PREFILL_GPU_2=3
MIMO_PREFILL_GPU_3=4
MIMO_VLLM_CACHE_PREFILL=/root/app/vllm/cache/mimo-v2.6-flash-prefill
# router (public endpoint; 8401 = the single-engine port, so clients do not change)
MIMO_PD_PORT=8401
MIMO_PREFILL_PORT=8402
MIMO_DECODE_PORT=8403
MIMO_PREFILL_KV_PORT=14593
MIMO_DECODE_KV_PORT=14594
LMCACHE_IMAGE=localhost/lmcache-server:latest
ROUTER_IMAGE=localhost/vllm-router:latest
LMCACHE_L2_PATH=/root/app/lmcache/mimo-v2.6-flash
LMCACHE_MERGE_BOUNDED_PD=0
MIMO_LMCACHE_PORT=5561
MIMO_LMCACHE_HTTP_PORT=18561
# chunk = prefix-cache retention interval (SWA groups); multiple of the 32-token LCM block
MIMO_LMCACHE_CHUNK=256
MIMO_LMCACHE_L1_GB=32
MIMO_LMCACHE_L2_GB=400
