# Copy to .env next to compose.yml, chmod 600. Never commit the real file.
VLLM_API_KEY=change-me

MIMO_IMAGE=localhost/vllm-backport:mimo-v2.6-flash
# Flat download dir (see /srv/models/MiMo-V2.6-Flash-MOPD.PROVENANCE.txt)
MIMO_MODEL_DIR=/srv/models/MiMo-V2.6-Flash-MOPD
MIMO_VLLM_CACHE=/srv/vllm-cache/mimo-v2.6-flash
MIMO_PORT=8401

# GPUs (CDI nvidia.com/gpu=<index>) for PP ranks 0-3. podman-compose 1.3 does
# not expand ${VAR:-default} for variables missing from .env, so keep all four.
MIMO_GPU_0=5
MIMO_GPU_1=6
MIMO_GPU_2=7
MIMO_GPU_3=8

# 48 decoder layers; rank 0 also holds the embedding, rank 3 lm_head + MTP.
MIMO_PP_LAYER_PARTITION=12,12,12,12

MIMO_MAX_MODEL_LEN=1048576
MIMO_MAX_NUM_SEQS=8
MIMO_MAX_NUM_BATCHED_TOKENS=4096
# Per-rank GPU KV budget in bytes (skips memory profiling). One 1048576-token
# request needs 8.98 GiB/rank (hybrid SWA/global groups add up to 12.5% padding).
MIMO_KV_CACHE_MEMORY=12884901888

# MiMo MTP (vLLM uses MTP layer 0 of 3). Use null to disable.
MIMO_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":1}

# Shared async-PP decode batch balancing (patches/vllm/0003); 0 = upstream.
VLLM_PP_DECODE_COHORT_BALANCE=0
