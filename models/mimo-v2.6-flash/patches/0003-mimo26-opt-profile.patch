+# SPDX-License-Identifier: Apache-2.0
+"""One switch for the MiMo-V2.6-Flash patch series (models/mimo-v2.6-flash).
+
+VLLM_MIMO26_OPT_PROFILE=default sets every switch below to its deployed value
+*unless that variable is already set*, so a single switch can still be
+overridden (e.g. VLLM_MIMO26_MTP_LAYERS=1). Unset / "0" / "off": nothing is
+changed and every patch keeps its own default (off). Applied from
+vllm.env_override, before any other vLLM module is imported, in the API
+server and in every spawned worker. The switch table is in
+models/mimo-v2.6-flash/README.md.
+"""
+import os
+
+PROFILES: dict[str, dict[str, str]] = {
+    "default": {
+        # 0002 MTP layers as parallel heads (multi-module MTP)
+        "VLLM_MIMO26_MTP_LAYERS": "3",
+        # DeepSeek 0003 single-kernel deterministic MoE align (bitwise equal,
+        # <= 512 routed entries; generic, already in the image)
+        "VLLM_DSV4_FAST_DET_MOE_ALIGN": "1",
+        # 0004 single-sort align for every size up to 4096 entries
+        "VLLM_MIMO26_SORT_MOE_ALIGN": "1",
+        # 0005 fp8 copy of lm_head for MTP draft logits
+        "VLLM_MIMO26_DRAFT_HEAD_FP8": "1",
+        # 0007 MTP draft widths with the measured per-request width policy
+        "VLLM_MIMO26_DRAFT_WIDTHS": "1",
+        "VLLM_MIMO26_ADAPTIVE_WIDTH": "1",
+        # 0008 PP feedback receive posted when consumed (generic PP)
+        "VLLM_PP_DEFERRED_FEEDBACK_RECV": "1",
+        # 0009 weight-streaming MXFP4 MoE decode, v2 epilogues, cheaper dequant
+        "VLLM_MIMO26_MXFP4_DECODE": "1",
+        "VLLM_MIMO26_MXFP4_V2": "1",
+        "VLLM_MIMO26_MXFP4_DQ": "2",
+        # 0010 prefill attention: 128-row query tiles (8 tokens/program; error
+        # vs fp64 equal; 64 is the bitwise-equal alternative) and the qk head
+        # dim split 128 + 64 instead of padding to 256 (bitwise equal)
+        "VLLM_MIMO26_DIFFKV_PREFILL_BM": "128",
+        "VLLM_MIMO26_DIFFKV_QK_SPLIT": "1",
+    },
+}
+
+
+def apply() -> None:
+    name = os.environ.get("VLLM_MIMO26_OPT_PROFILE", "").strip().lower()
+    if name in ("", "0", "off", "none"):
+        return
+    if name not in PROFILES:
+        raise ValueError(
+            f"VLLM_MIMO26_OPT_PROFILE={name!r}: unknown profile "
+            f"(known: {', '.join(sorted(PROFILES))})")
+    for key, value in PROFILES[name].items():
+        os.environ.setdefault(key, value)
