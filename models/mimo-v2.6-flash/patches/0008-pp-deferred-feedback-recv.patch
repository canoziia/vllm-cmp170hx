         if slot is None:
             return None
+        if slot.deferred_num_reqs is not None:
+            # Post the broadcasts now (FIFO = the sender's order), before any
+            # early return: every rank must issue them.
+            self._post_recv(slot)
 
         # Skip requests which did not need sampled output and/or those already
         # finished. The post_update kernel skips the -1 entries.
@@ -172,6 +192,59 @@ class PPHandler:
             idx_mapping=idx_mapping,
         )
 
+    def flush_deferred(self) -> None:
+        """Post every still-deferred receive (FIFO). Called before anything
+        that may synchronize the device (profiling run, graph capture) and on
+        empty steps, so the last rank's sends never wait on an idle receiver."""
+        if not self.deferred_recv:
+            return
+        for slot in self.queue:
+            if slot is not None and slot.deferred_num_reqs is not None:
+                self._post_recv(slot)
+
+    def _post_recv(self, slot: PendingRecv) -> None:
+        """Issue a deferred slot's receives (same collectives and order as
+        `receive`) and fill its tensors and event."""
+        num_reqs = slot.deferred_num_reqs
+        with torch.cuda.stream(self.broadcast_stream):
+            self.broadcast_stream.wait_stream(self.main_stream)
+            sampled_tokens = torch.empty(
+                num_reqs, self.max_sample_len, dtype=torch.int64, device=self.device
+            )
+            combined = torch.empty(2, num_reqs, dtype=torch.int32, device=self.device)
+            torch.distributed.broadcast(
+                sampled_tokens, src=self.last_rank, group=self.broadcast_group
+            )
+            torch.distributed.broadcast(
+                combined, src=self.last_rank, group=self.broadcast_group
+            )
+            draft_payload = None
+            if self.num_speculative_steps > 0:
+                draft_payload = torch.empty(
+                    num_reqs,
+                    self.num_speculative_steps * (2 if self.relay_draft_confidences else 1),
+                    dtype=torch.int64,
+                    device=self.device,
+                )
+                torch.distributed.broadcast(
+                    draft_payload, src=self.last_rank, group=self.broadcast_group
+                )
+                slot.draft_tokens = draft_payload[:, :self.num_speculative_steps]
+                if self.relay_draft_confidences:
+                    slot.draft_confidences = draft_payload[
+                        :, self.num_speculative_steps:
+                    ].to(torch.int32).view(torch.float32)
+            slot.event = self.broadcast_stream.record_event()
+            slot.num_sampled, slot.num_rejected = combined.unbind(dim=0)
+            slot.sampled_tokens = sampled_tokens
+            sampled_tokens.record_stream(self.main_stream)
+            combined.record_stream(self.main_stream)
+            if draft_payload is not None:
+                draft_payload.record_stream(self.main_stream)
+            if slot.draft_confidences is not None:
+                slot.draft_confidences.record_stream(self.main_stream)
+        slot.deferred_num_reqs = None
+
     def broadcast_drafts(
         self, draft_tokens: torch.Tensor, input_batch: InputBatch,
         draft_confidences: torch.Tensor | None = None,
@@ -216,6 +289,19 @@ class PPHandler:
         gen_at_receive_np = self.req_idx_gen_np[input_batch.idx_mapping_np]
 
         num_reqs = input_batch.num_reqs
+        if self.deferred_recv:
