From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] mimo-v2: run the bundled DFlash drafter under PP

The checkpoint ships a 5-layer DFlash drafter (dflash/, block 8, target
layers 0/11/23/35/47, separate mask_embedding.pt, attention sinks, SWA
1024). vLLM's qwen3_dflash already handles the sinks, sliding window and
mask embedding; this adds what MiMo needs on top:

- MiMoV2Model: auxiliary hidden states over pipeline parallelism, as in
  llama (absolute layer indices, embedding output only on the first rank,
  local states packed into the intermediate tensors, the last rank returns
  upstream + local ones); supports_aux_hidden_states_over_pp.
- MiMoV2OmniForCausalLM: SupportsEagle3, so the aux layers can be set.
- qwen3_dflash: dflash_config.attention_value_scale (0.612 for MiMo) scales
  V before attention, for the query block and for the precomputed target
  context K/V. Only drafters whose config carries the key are affected.
- MiMoV2Model: builds embed_tokens on the last PP rank too when the
  speculator needs the target embedding (spec_decode_needs_target_embed, as
  DeepSeek V4.1); the drafter has no embedding of its own. +1.25 GiB there.
- qwen3_dflash: after_target_sharing() / compute_logits can use the 0005 fp8
  draft head for the draft logits of every block position, behind its own
  switch VLLM_MIMO26_DFLASH_DRAFT_HEAD_FP8 (default 0, not in the profile:
  on MiMo it lowers deep-position acceptance, code 4.68 -> 4.21 tok/step).

Selected only by --speculative-config method "dflash" with the dflash/
directory; MTP deployments are unchanged.

diff --git a/vllm/model_executor/models/mimo_v2.py b/vllm/model_executor/models/mimo_v2.py
index d65d6ea..f6cf95d 100644
--- a/vllm/model_executor/models/mimo_v2.py
+++ b/vllm/model_executor/models/mimo_v2.py
@@ -67,6 +67,7 @@ from .utils import (
     make_empty_intermediate_tensors_factory,
     make_layers,
     maybe_prefix,
+    spec_decode_needs_target_embed,
 )
 
 logger = init_logger(__name__)
@@ -542,6 +543,7 @@ def _shard_fp8_qkv_proj(
 
 
 class MiMoV2Model(nn.Module, EagleModelMixin):
+    supports_aux_hidden_states_over_pp = True
     def __init__(self, *, vllm_config: VllmConfig, prefix: str = ""):
         super().__init__()
 
@@ -554,8 +556,12 @@ class MiMoV2Model(nn.Module, EagleModelMixin):
         self.vocab_size = config.vocab_size
         self.num_redundant_experts = eplb_config.num_redundant_experts
 
-        if get_pp_group().is_first_rank or (
-            config.tie_word_embeddings and get_pp_group().is_last_rank
+        # The last rank also needs the input embedding when its drafter
+        # (DFlash) embeds tokens with the target's table.
+        if (
+            get_pp_group().is_first_rank
+            or (config.tie_word_embeddings and get_pp_group().is_last_rank)
+            or spec_decode_needs_target_embed(vllm_config)
         ):
             self.embed_tokens = VocabParallelEmbedding(
                 config.vocab_size,
@@ -604,11 +610,19 @@ class MiMoV2Model(nn.Module, EagleModelMixin):
             hidden_states = intermediate_tensors["hidden_states"]
             residual = intermediate_tensors["residual"]
 
-        aux_hidden_states = self._maybe_add_hidden_state(
-            [], self.start_layer, hidden_states, residual
-        )
+        # Aux hidden states (EAGLE-3 / DFlash targets) over PP, as in llama:
+        # absolute layer indices, the embedding output only on the first rank,
+        # local states packed into the intermediate tensors, the last rank
+        # returns upstream + local ones.
+        remote_aux = self.collect_remote_aux_hidden_states(intermediate_tensors)
+        aux_hidden_states: list[torch.Tensor] = []
+        if get_pp_group().is_first_rank:
+            self._maybe_add_hidden_state(
+                aux_hidden_states, self.start_layer, hidden_states, residual
+            )
         for idx, layer in enumerate(
-            islice(self.layers, self.start_layer, self.end_layer)
+            islice(self.layers, self.start_layer, self.end_layer),
+            start=self.start_layer,
         ):
             hidden_states, residual = layer(positions, hidden_states, residual)
             self._maybe_add_hidden_state(
@@ -617,11 +631,16 @@ class MiMoV2Model(nn.Module, EagleModelMixin):
 
         if not get_pp_group().is_last_rank:
             return IntermediateTensors(
-                {"hidden_states": hidden_states, "residual": residual}
+                {
+                    "hidden_states": hidden_states,
+                    "residual": residual,
+                    **self.pack_local_aux_hidden_states(aux_hidden_states),
+                }
             )
 
         hidden_states, _ = self.norm(hidden_states, residual)
 
+        aux_hidden_states = remote_aux + aux_hidden_states
         if len(aux_hidden_states) > 0:
             return hidden_states, aux_hidden_states
         return hidden_states
