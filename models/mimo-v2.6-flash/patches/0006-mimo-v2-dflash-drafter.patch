diff --git a/vllm/model_executor/models/qwen3_dflash.py b/vllm/model_executor/models/qwen3_dflash.py
index ce3884a..89b998f 100644
--- a/vllm/model_executor/models/qwen3_dflash.py
+++ b/vllm/model_executor/models/qwen3_dflash.py
@@ -168,6 +168,7 @@ class DFlashQwen3Attention(nn.Module):
         attention_bias: bool = False,
         add_swa_attention_sink_bias: bool = False,
         sliding_window: int | None = None,
+        value_scale: float | None = None,
         causal: bool = False,
         is_neox_style: bool = True,
         cache_config: CacheConfig | None = None,
@@ -224,6 +225,10 @@ class DFlashQwen3Attention(nn.Module):
         )
 
         self.sliding_window = sliding_window
+        # dflash_config.attention_value_scale (MiMo-V2 drafters): V is scaled
+        # before attention, for the query block here and for the target
+        # context K/V in precompute_and_store_context_kv.
+        self.value_scale = value_scale
         self.attn = Attention(
             self.num_heads,
             self.head_dim,
@@ -262,6 +267,8 @@ class DFlashQwen3Attention(nn.Module):
         ).view(k_shape)
 
         q, k = self.rotary_emb(positions, q, k)
+        if self.value_scale is not None:
+            v = v * self.value_scale
 
         attn_output = self.attn(q, k, v)
         output, _ = self.o_proj(attn_output)
@@ -312,6 +319,7 @@ class DFlashQwen3DecoderLayer(nn.Module):
             attention_bias=getattr(config, "attention_bias", False),
             add_swa_attention_sink_bias=add_swa_attention_sink_bias,
             sliding_window=sliding_window,
+            value_scale=dflash_config.get("attention_value_scale"),
             causal=causal,
             is_neox_style=is_neox_style,
             head_dim=getattr(config, "head_dim", None),
@@ -602,6 +610,9 @@ class DFlashQwen3Model(nn.Module):
 
         all_k, all_v = self._project_context_kv(context_states, num_ctx, L, nkv, hd)
         all_k_normed = self._normalize_context_k(all_k)
+        value_scale = self.layers[0].self_attn.value_scale
+        if value_scale is not None:
+            all_v.mul_(value_scale)
 
         # --- Fused RoPE across all layers ---
         # View as [L * num_ctx, kv] so RoPE sees one big batch (no copy).
@@ -743,10 +754,31 @@ class DFlashQwen3ForCausalLM(Qwen3ForCausalLM):
         get_draft_kv_cache_layer_names."""
         return [layer.self_attn.causal for layer in self.model.layers]
 
+    def after_target_sharing(self) -> None:
+        """VLLM_MIMO26_DFLASH_DRAFT_HEAD_FP8: fp8 copy of the shared lm_head
+        for the draft logits of every block position (fp8_draft_head.py). Only
+        with a full-vocabulary draft head that is shared with the target."""
+        from vllm.model_executor.layers import fp8_draft_head
+
+        self._fp8_draft_head = (
+            fp8_draft_head.build(
+                self.lm_head, "DFlash", "VLLM_MIMO26_DFLASH_DRAFT_HEAD_FP8"
+            )
+            if self.draft_id_to_target_id is None
+            else None
+        )
+
     def compute_logits(
         self,
         hidden_states: torch.Tensor,
     ) -> torch.Tensor | None:
+        head = getattr(self, "_fp8_draft_head", None)
+        if head is not None:
+            from vllm.model_executor.layers import fp8_draft_head
+
+            return fp8_draft_head.logits(
+                head, self.lm_head, self.logits_processor, hidden_states
+            )
         logits = self.logits_processor(self.lm_head, hidden_states)
         if self.draft_id_to_target_id is None:
             return logits
