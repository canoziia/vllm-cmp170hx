         head_size_v_padded = next_power_of_2(head_size_v)
+        # VLLM_MIMO26_DIFFKV_SEGMENTS (default 0 = the shared 16): split-KV
+        # segments per sequence for full-attention groups. 16 segments leave
+        # most of the GPU idle for a c1 decode / MTP verify over a long
+        # context; segments past the sequence end exit early, so a fixed
+        # larger count keeps every CUDA graph shape. Sliding-window groups
+        # keep 16.
+        segments = int(os.environ.get("VLLM_MIMO26_DIFFKV_SEGMENTS", "0"))
+        if (
+            segments in (32, 64, 128)
+            and getattr(kv_cache_spec, "sliding_window", None) is None
+        ):
+            self.num_par_softmax_segments = segments
+            self.softmax_segm_max = torch.empty(
+                (self.seq_threshold_3D, self.num_heads_q, segments),
+                dtype=torch.float32,
+                device=device,
+            )
+            self.softmax_segm_expsum = torch.empty(
+                (self.seq_threshold_3D, self.num_heads_q, segments),
+                dtype=torch.float32,
+                device=device,
+            )
         self.softmax_segm_output = torch.empty(
             (
                 self.seq_threshold_3D,
