+    def _mimo26_plan_drafts(self, scheduler_output: SchedulerOutput) -> None:
+        """Decide how many drafts the last PP rank generates for this batch.
+
+        One count per scheduled batch keeps the next verification uniform
+        (exact decode graphs on every PP stage). Manual spec_k requests bring
+        their pinned width, policy-managed requests their measured choice,
+        anything else the full K. Every scheduled request records the count,
+        which is exactly what its next verification may consume."""
