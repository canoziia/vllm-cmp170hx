+    def _observe_unpriced_step_cost(self) -> None:
+        """Record how much of the step that just ran no cost curve priced."""
+        if not envs.VLLM_ADAPTIVE_VERIFICATION_PRICED_FIXED_COST:
+            return
+        now_ns = time.monotonic_ns()
+        previous_ns, self._last_decision_ns = self._last_decision_ns, now_ns
+        if not previous_ns or self._last_priced_cost_ms <= 0.0:
+            return
+        gap_ms = (now_ns - previous_ns) / 1e6
+        if not 0.0 < gap_ms < _FIXED_COST_MAX_GAP_MS:
+            return
+        num_reqs = self._last_priced_num_reqs
+        reference = self._fixed_cost_median.get(num_reqs)
+        if reference is not None and not (
+            _FIXED_COST_BAND[0] * reference <= gap_ms <= _FIXED_COST_BAND[1] * reference
+        ):
+            # Not one step of the same kind of batch; no evidence about its cost.
+            return
+        unpriced_ms = gap_ms - self._last_priced_cost_ms
+        if unpriced_ms < 0.0:
+            # The curves over-priced the step (a faster shape, or replay bias).
+            # Nothing to learn from a negative cost.
+            return
+        samples = self._fixed_cost[num_reqs]
+        samples.append(unpriced_ms)
+        if len(samples) < _FIXED_COST_MIN_SAMPLES:
+            return
+        estimate = float(np.median(samples))
+        self._fixed_cost_median[num_reqs] = estimate
+        if num_reqs not in self._fixed_cost_reported:
+            self._fixed_cost_reported.add(num_reqs)
+            logger.info(
+                "Adaptive verification: %.1f ms of per-step cost at %d request(s) "
+                "is not covered by the profiled draft/verify curves; including it "
+                "in the budget objective.",
+                estimate,
+                num_reqs,
+            )
+
+    def unpriced_step_cost_ms(self, num_reqs: int) -> float:
+        """Estimated unpriced cost for a step of this size, 0 until evidence exists."""
+        if not envs.VLLM_ADAPTIVE_VERIFICATION_PRICED_FIXED_COST:
+            return 0.0
+        if len(self._fixed_cost.get(num_reqs, ())) < _FIXED_COST_MIN_SAMPLES:
+            return 0.0
+        return self._fixed_cost_median.get(num_reqs, 0.0)
+
