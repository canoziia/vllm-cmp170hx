     )
 
 
+def _is_qwen4_exp_mtp(vllm_config: VllmConfig) -> bool:
+    spec_config = vllm_config.speculative_config
+    if spec_config is None or spec_config.method != "mtp":
+        return False
+    draft_config = spec_config.draft_model_config
+    return (
+        draft_config is not None
+        and draft_config.hf_config.model_type == "qwen4_exp_mtp"
+    )
+
+
 def _annotate_eagle_groups(
     vllm_config: VllmConfig,
     kv_cache_spec: dict[str, KVCacheSpec],
@@ -2137,6 +2150,45 @@ def _annotate_eagle_groups(
         ):
             group.is_eagle_group = True
 
+    if _is_qwen4_exp_mtp(vllm_config):
+        # Qwen4Exp registers its native MTP full-attention layers under
+        # ``mtp.layers.<target_num_hidden_layers + idx>``. Their specs are
+        # otherwise indistinguishable from target full attention, so identify
+        # the owning merged group by this stable model path. Never flag the
+        # target's recurrent groups: widening their lookup window makes a
+        # Mamba checkpoint impossible to satisfy and disables all reuse.
+        qwen_mtp_groups = [
+            group
+            for group in kv_cache_groups
+            if any(
+                layer_name.startswith("mtp.layers.")
+                or ".mtp.layers." in layer_name
+                for layer_name in group.layer_names
+            )
+        ]
+        if not qwen_mtp_groups:
+            raise ValueError(
+                "Qwen4Exp MTP did not resolve to a draft attention KV cache group"
+            )
+        if any(
+            isinstance(spec, MambaSpec)
+            for group in qwen_mtp_groups
+            for spec in iter_layer_specs(group.kv_cache_spec)
+        ):
+            raise ValueError(
+                "Qwen4Exp MTP draft attention group unexpectedly contains Mamba state"
+            )
+        for group in qwen_mtp_groups:
+            group.is_eagle_group = True
+        logger.info(
+            "Identified %d Qwen4Exp MTP draft attention KV cache groups: %s",
+            len(qwen_mtp_groups),
+            [
+                [name for name in group.layer_names if "mtp.layers." in name]
+                for group in qwen_mtp_groups
+            ],
+        )
+
     if not use_deepseek_v4_fallback:
         return
     last_layer = next(reversed(kv_cache_spec))
