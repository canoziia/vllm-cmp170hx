+@triton.jit
+def _cap_decode_checkpoint_acceptance(
+    idx_mapping_ptr,
+    computed_ptr,
+    prompt_len_ptr,
+    sampled_ptr,
+    rejected_ptr,
+    UNIT: tl.constexpr,
+):
+    """Keep MTP verification uniform but do not accept past a checkpoint."""
+    row = tl.program_id(0)
+    slot = tl.load(idx_mapping_ptr + row)
+    if slot < 0:
+        return
+    start = tl.load(computed_ptr + slot)
+    prompt = tl.load(prompt_len_ptr + slot)
+    if start < prompt:
+        return
+    count = tl.load(sampled_ptr + row)
+    cap = UNIT - start % UNIT
+    keep = tl.minimum(count, cap)
+    tl.store(sampled_ptr + row, keep)
+    tl.store(rejected_ptr + row, tl.load(rejected_ptr + row) + count - keep)
+
