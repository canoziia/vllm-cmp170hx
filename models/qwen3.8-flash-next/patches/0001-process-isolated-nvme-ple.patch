diff --git a/vllm/models/qwen4_exp/nvidia/ple_nvme.py b/vllm/models/qwen4_exp/nvidia/ple_nvme.py
new file mode 100644
index 00000000..e3467f4b
--- /dev/null
+++ b/vllm/models/qwen4_exp/nvidia/ple_nvme.py
@@ -0,0 +1,354 @@
+# SPDX-License-Identifier: Apache-2.0
+"""mmap-backed FP8 PLE table for Qwen3.8-Flash-Next.
+
+This correctness-first backend keeps the large n-gram table in its original
+sharded safetensors files and copies only selected rows into the PLE CPU
+worker's pinned output buffer. Linux page cache provides the first-stage cache;
+an io_uring/O_DIRECT backend can replace this reader after PP correctness is
+established.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import json
+import mmap
+import os
+import re
+import struct
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+from torch import nn
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_SHARD_RE = re.compile(r"\.ngram_embedding\.shard_(\d+)\.weight$")
+
+
+@dataclass(frozen=True)
+class _Shard:
+    index: int
+    row_start: int
+    row_end: int
+    path: Path
+    byte_offset: int
+    row_bytes: int
+
+
+class MMapNGramEmbedding(nn.Module):
+    """FP8 E4M3 embedding table backed by safetensors row reads."""
+
+    supports_prefetch = False
+
+    def __init__(
+        self,
+        snapshot: str | os.PathLike[str],
+        *,
+        expected_rows: int,
+        embedding_dim: int,
+        expected_shards: int,
+    ) -> None:
+        super().__init__()
+        self.snapshot = Path(snapshot).resolve()
+        self.embedding_dim = int(embedding_dim)
+        self.org_vocab_size = int(expected_rows)
+        self.register_buffer(
+            "weight_scale", torch.ones(1, dtype=torch.bfloat16), persistent=True
+        )
+        self._handles: dict[Path, Any] = {}
+        self._maps: dict[Path, mmap.mmap] = {}
+        self._arrays: dict[int, np.ndarray] = {}
+        self._shards = self._build_manifest(expected_shards)
+        self._row_ends = np.asarray([s.row_end for s in self._shards], dtype=np.int64)
+        self._backend = os.getenv("VLLM_PLE_NVME_BACKEND", "pread").strip().lower()
+        if self._backend not in {"pread", "mmap"}:
+            raise ValueError(
+                f"unsupported VLLM_PLE_NVME_BACKEND={self._backend!r}; "
+                "expected 'pread' or 'mmap'"
+            )
+        self._fds: dict[Path, int] = {}
+        self._pread_pool: ThreadPoolExecutor | None = None
+        self._native_pread: Any | None = None
+        self._pread_workers = max(
+            1, int(os.getenv("VLLM_PLE_NVME_PREAD_WORKERS", "48"))
+        )
+        self._shard_fds: np.ndarray | None = None
+        self._shard_row_starts: np.ndarray | None = None
+        self._shard_byte_offsets: np.ndarray | None = None
+        if self._backend == "pread":
+            paths = {shard.path for shard in self._shards}
+            self._fds = {path: os.open(path, os.O_RDONLY) for path in paths}
+            self._shard_fds = np.asarray(
+                [self._fds[shard.path] for shard in self._shards], dtype=np.int32
+            )
+            self._shard_row_starts = np.asarray(
+                [shard.row_start for shard in self._shards], dtype=np.int64
+            )
+            self._shard_byte_offsets = np.asarray(
+                [shard.byte_offset for shard in self._shards], dtype=np.int64
+            )
+            native_path = os.getenv(
+                "VLLM_PLE_NATIVE_PREAD_LIBRARY",
+                "/usr/local/lib/libvllm_ple_pread.so",
+            )
+            try:
+                native_library = ctypes.CDLL(native_path)
+                native_pread = native_library.ple_pread_rows
+                native_pread.argtypes = [
+                    ctypes.POINTER(ctypes.c_int),
+                    ctypes.POINTER(ctypes.c_int64),
+                    ctypes.c_void_p,
+                    ctypes.c_size_t,
+                    ctypes.c_size_t,
+                    ctypes.c_int,
+                ]
+                native_pread.restype = ctypes.c_int
+                self._native_pread = native_pread
+            except (OSError, AttributeError):
+                logger.warning(
+                    "PLE native pread helper unavailable; using Python fallback"
+                )
+                self._pread_pool = ThreadPoolExecutor(
+                    max_workers=self._pread_workers, thread_name_prefix="ple-pread"
+                )
+        logger.info(
+            "PLE %s table ready: %.2f GiB, rows=%d, dim=%d, shards=%d, files=%d",
+            self._backend,
+            self.org_vocab_size * self.embedding_dim / (1024**3),
+            self.org_vocab_size,
+            self.embedding_dim,
+            len(self._shards),
+            len({s.path for s in self._shards}),
+        )
+
+    @staticmethod
+    def _read_header(path: Path) -> tuple[int, dict[str, Any]]:
+        with path.open("rb") as handle:
+            header_len_raw = handle.read(8)
+            if len(header_len_raw) != 8:
+                raise ValueError(f"short safetensors header in {path}")
+            header_len = struct.unpack("<Q", header_len_raw)[0]
+            if header_len <= 0 or header_len > 128 * 1024 * 1024:
+                raise ValueError(f"invalid safetensors header length {header_len} in {path}")
+            header = json.loads(handle.read(header_len))
+        return 8 + header_len, header
+
+    def _build_manifest(self, expected_shards: int) -> tuple[_Shard, ...]:
+        index_path = self.snapshot / "model.safetensors.index.json"
+        with index_path.open() as handle:
+            weight_map = json.load(handle)["weight_map"]
+
+        matches: list[tuple[int, str, str]] = []
+        for name, filename in weight_map.items():
+            match = _SHARD_RE.search(name)
+            if match:
+                matches.append((int(match.group(1)), name, filename))
+        matches.sort()
+        if len(matches) != expected_shards:
+            raise ValueError(
+                f"expected {expected_shards} PLE shards, found {len(matches)} in {index_path}"
+            )
+        if [x[0] for x in matches] != list(range(expected_shards)):
+            raise ValueError("PLE shard indices are not contiguous")
+
+        header_cache: dict[Path, tuple[int, dict[str, Any]]] = {}
+        records: list[tuple[int, Path, int, int, int]] = []
+        for shard_index, name, filename in matches:
+            path = (self.snapshot / filename).resolve()
+            if not path.is_file():
+                raise FileNotFoundError(path)
+            data_start, header = header_cache.setdefault(path, self._read_header(path))
+            metadata = header.get(name)
+            if metadata is None:
+                raise ValueError(f"{name!r} missing from {path}")
+            if metadata.get("dtype") != "F8_E4M3":
+                raise ValueError(
+                    f"NVMe PLE requires F8_E4M3, got {metadata.get('dtype')} for {name}"
+                )
+            shape = tuple(int(x) for x in metadata["shape"])
+            if len(shape) != 2 or shape[1] != self.embedding_dim:
+                raise ValueError(
+                    f"invalid PLE shard shape {shape}; expected (*, {self.embedding_dim})"
+                )
+            begin, end = (int(x) for x in metadata["data_offsets"])
+            expected_bytes = shape[0] * self.embedding_dim
+            if end - begin != expected_bytes:
+                raise ValueError(f"invalid byte length for {name}")
+            records.append(
+                (shard_index, path, data_start + begin, shape[0], self.embedding_dim)
+            )
+
+        row_start = 0
+        shards: list[_Shard] = []
+        for shard_index, path, byte_offset, rows, row_bytes in records:
+            shards.append(
+                _Shard(
+                    index=shard_index,
+                    row_start=row_start,
+                    row_end=row_start + rows,
+                    path=path,
+                    byte_offset=byte_offset,
+                    row_bytes=row_bytes,
+                )
+            )
+            row_start += rows
+        if row_start != self.org_vocab_size:
+            raise ValueError(
+                f"PLE snapshot has {row_start} rows; expected {self.org_vocab_size}"
+            )
+        return tuple(shards)
+
+    def _array(self, shard: _Shard) -> np.ndarray:
+        array = self._arrays.get(shard.index)
+        if array is not None:
+            return array
+        mapping = self._maps.get(shard.path)
+        if mapping is None:
+            handle = shard.path.open("rb")
+            mapping = mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ)
+            self._handles[shard.path] = handle
+            self._maps[shard.path] = mapping
+        array = np.ndarray(
+            (shard.row_end - shard.row_start, shard.row_bytes),
+            dtype=np.uint8,
+            buffer=mapping,
+            offset=shard.byte_offset,
+        )
+        self._arrays[shard.index] = array
+        return array
+
+    @staticmethod
+    def _pread_one(location: tuple[int, int, int]) -> bytes:
+        fd, nbytes, offset = location
+        data = os.pread(fd, nbytes, offset)
+        if len(data) != nbytes:
+            raise OSError(
+                f"short PLE pread at offset {offset}: {len(data)} != {nbytes}"
+            )
+        return data
+
+    @torch.inference_mode()
+    def gather(self, indices: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+        """Copy selected FP8 rows byte-for-byte into a CPU float8 tensor."""
+        if indices.device.type != "cpu" or out.device.type != "cpu":
+            raise ValueError("PLE disk gather requires CPU tensors")
+        if out.dtype != torch.float8_e4m3fn:
+            raise ValueError(f"PLE mmap output must be FP8 E4M3, got {out.dtype}")
+        ids = indices.reshape(-1).to(torch.int64).numpy()
+        output = out.reshape(-1, self.embedding_dim)
+        if output.shape[0] != ids.size:
+            raise ValueError("PLE mmap output shape does not match indices")
+        output_bytes = output.view(torch.uint8).numpy().reshape(-1, self.embedding_dim)
+
+        # Match the author's pinned/UVA lookup semantics: CUDA graph capture
+        # can supply dummy IDs outside this rank's vocabulary, and the native
+        # kernel emits an all-zero row for them. Never clamp an invalid ID to a
+        # real row; gather only valid IDs and preserve zeros at their positions.
+        valid_mask = (ids >= 0) & (ids < self.org_vocab_size)
+        valid_positions = np.flatnonzero(valid_mask)
+        valid_ids = ids[valid_mask]
+        if valid_positions.size != ids.size:
+            output_bytes.fill(0)
+            logger.info_once(
+                "PLE NVMe zero-filled %d out-of-range capture row(s)",
+                ids.size - valid_positions.size,
+            )
+        if not valid_ids.size:
+            return out
+
+        shard_ids = np.searchsorted(self._row_ends, valid_ids, side="right")
+        direct_output = valid_positions.size == ids.size
+        gathered_bytes = (
+            output_bytes
+            if direct_output
+            else np.empty((valid_ids.size, self.embedding_dim), dtype=np.uint8)
+        )
+        if self._backend == "pread":
+            if self._native_pread is not None:
+                assert self._shard_fds is not None
+                assert self._shard_row_starts is not None
+                assert self._shard_byte_offsets is not None
+                file_descriptors = np.ascontiguousarray(
+                    self._shard_fds[shard_ids], dtype=np.int32
+                )
+                offsets = np.ascontiguousarray(
+                    self._shard_byte_offsets[shard_ids]
+                    + (valid_ids - self._shard_row_starts[shard_ids])
+                    * self.embedding_dim,
+                    dtype=np.int64,
+                )
+                status = self._native_pread(
+                    file_descriptors.ctypes.data_as(ctypes.POINTER(ctypes.c_int)),
+                    offsets.ctypes.data_as(ctypes.POINTER(ctypes.c_int64)),
+                    ctypes.c_void_p(gathered_bytes.ctypes.data),
+                    valid_ids.size,
+                    self.embedding_dim,
+                    self._pread_workers,
+                )
+                if status != 0:
+                    raise OSError(f"PLE native pread failed for {-status} row(s)")
+            else:
+                assert self._pread_pool is not None
+                locations = []
+                for row, shard_id in zip(valid_ids, shard_ids, strict=True):
+                    shard = self._shards[int(shard_id)]
+                    offset = (
+                        shard.byte_offset
+                        + (int(row) - shard.row_start) * shard.row_bytes
+                    )
+                    locations.append(
+                        (self._fds[shard.path], shard.row_bytes, offset)
+                    )
+                rows = self._pread_pool.map(self._pread_one, locations)
+                gathered_bytes[:] = np.frombuffer(
+                    b"".join(rows), dtype=np.uint8
+                ).reshape(-1, self.embedding_dim)
+        else:
+            for shard_id in np.unique(shard_ids):
+                positions = np.nonzero(shard_ids == shard_id)[0]
+                shard = self._shards[int(shard_id)]
+                local_ids = valid_ids[positions] - shard.row_start
+                gathered_bytes[positions] = self._array(shard)[local_ids]
+        if not direct_output:
+            output_bytes[valid_positions] = gathered_bytes
+        return out
+
+    def forward(self, indices: torch.Tensor) -> torch.Tensor:
+        output = torch.empty(
+            (*indices.shape, self.embedding_dim),
+            dtype=torch.float8_e4m3fn,
+            device="cpu",
+        )
+        return self.gather(indices, output)
+
+    def close(self) -> None:
+        pool, self._pread_pool = self._pread_pool, None
+        if pool is not None:
+            pool.shutdown(wait=True)
+        for fd in self._fds.values():
+            os.close(fd)
+        self._fds.clear()
+        self._native_pread = None
+        self._shard_fds = None
+        self._shard_row_starts = None
+        self._shard_byte_offsets = None
+        self._arrays.clear()
+        for mapping in self._maps.values():
+            mapping.close()
+        for handle in self._handles.values():
+            handle.close()
+        self._maps.clear()
+        self._handles.clear()
+
+    def __del__(self) -> None:
+        try:
+            self.close()
+        except Exception:
+            pass
