VLLM_API_KEY=replace-me
QWEN_MODEL_CACHE=/root/app/vllm/cache/huggingface/hub/models--nvidia--Qwen3.8-Flash-Next-NVFP4
VLLM_CACHE=/root/app/vllm/cache/qwen38-flash-next-nvfp4
LMCACHE_L1_SIZE_GB=64
LMCACHE_L2_PATH=/mnt/lmcache-sdb/nvidia/Qwen3.8-Flash-Next-NVFP4
QWEN_REVISION=fc694b54fb0174e0913e6adf86691ef85a4ead47
QWEN_IMAGE=localhost/vllm-backport:qwen38-flash-next-nvfp4

# Opt-in shared async-PP decode batch balancing (models/deepseek-v41 uses the same
# switch). Steps can only carry about running/pp_size requests, so earlier ranks
# starve at large pp_size; 0 keeps upstream behaviour. Default: 0
VLLM_PP_DECODE_COHORT_BALANCE=1

# Shared LMCache server image (built by scripts/build-lmcache-server-image.sh);
# the same image serves every deployment in this repository. The client image
# carries the identical patched payload for its own LMCacheMPConnector.
LMCACHE_IMAGE=localhost/lmcache-server:latest
