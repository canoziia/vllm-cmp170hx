+                    [cur[i] for i in range(4)],
+                )
+                poll_no_reset(
+                    local + self.hdb_slot(generation, Int32(hf + qf), Int32(qf), row, tid),
+                    words,
+                )
+                for i in cutlass.range_constexpr(4):
