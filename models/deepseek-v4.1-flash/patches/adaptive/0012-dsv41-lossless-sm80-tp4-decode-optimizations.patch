+def _markov_gemm_blockmax_tc(
+    prev_ptr,  # [B] int64 previous token id
+    w1_ptr,  # [target_vocab, R] bf16/fp16
+    w2_ptr,  # [shard_width, R] bf16/fp16
+    base_ptr,  # [B, n_spec, shard_width] bf16/fp16
+    part_ptr,  # [B, nblk] int64 out
