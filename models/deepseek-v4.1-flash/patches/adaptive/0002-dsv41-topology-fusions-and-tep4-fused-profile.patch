+            T.i64(),
+            [Int64(address).ir_value(loc=loc, ip=ip)],
+            "ld.volatile.global.u64 $0, [$1];",
+            "=l,l",
+            True,
+            loc,
+            ip,
+        )
+    )
+
+
+@dsl_user_op
+def store_volatile_u64(address: Int64, value: Int64, *, loc=None, ip=None) -> None:
+    _asm(
+        None,
