+                            prev_post_loc.mean(dim=1)
+                        )
+                    res_loc = _engram_local(
+                        nxt.engram,
+                        prev_post_loc,
+                        engram_hashes[:, nxt.engram.layer_hash_index],
+                        engram_mask,
+                    )
+                    del prev_post_loc
+                    pm_loc, rm_loc, x_nxt_loc, attn_pre_loc = _mhc_pre_fn(nxt)(
