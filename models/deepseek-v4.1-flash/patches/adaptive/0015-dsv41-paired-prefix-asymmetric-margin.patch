From 52aeb69c21f3e3a82043ef1a36f22812f94c8c35 Mon Sep 17 00:00:00 2001
From: Canoziia <canoziia@projectk.org>
Date: Thu, 26 Nov 2026 15:06:39 +0800
Subject: [PATCH] feat(deepseek-v4.1): paired-prefix asymmetric trim margin
 (0.01 down / 0.03 up, min-tie)

---
 vllm/v1/core/sched/dsv41_measured_policy.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/vllm/v1/core/sched/dsv41_measured_policy.py b/vllm/v1/core/sched/dsv41_measured_policy.py
index 058331a..494db5b 100644
--- a/vllm/v1/core/sched/dsv41_measured_policy.py
+++ b/vllm/v1/core/sched/dsv41_measured_policy.py
@@ -577,12 +577,15 @@ class Policy:
                     and scores[k - 1] > scores[best - 1] * 1.03
                 ]
                 if cands:
-                    best = max(cands)
+                    best = min(cands)
             else:
                 for k in range(1, min(5, self.k + 1) + 1):
+                    # Exact paired-prefix downward trim (less compute) vs
+                    # extrapolated upward expansion (more compute).
+                    margin = 0.01 if k < self.k else 0.03
                     if (
                         scores[k - 1] - scores[self.k - 1]
-                        > 0.03 * scores[self.k - 1] + gate[k - 1]
+                        > margin * scores[self.k - 1] + gate[k - 1]
                         and scores[k - 1] > scores[best - 1]
                     ):
                         best = k
-- 
2.56.0

