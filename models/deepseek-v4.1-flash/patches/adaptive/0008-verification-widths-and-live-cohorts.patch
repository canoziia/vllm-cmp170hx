diff --git a/vllm/v1/attention/backends/mla/decode_metadata.py b/vllm/v1/attention/backends/mla/decode_metadata.py
new file mode 100644
index 0000000..d15ed49
--- /dev/null
+++ b/vllm/v1/attention/backends/mla/decode_metadata.py
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Device-driven flattened indexer metadata; no host read of query lengths."""
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _flatten_decode(seq, bt, starts, out_seq, out_bt, out_lens,
+                    N: tl.constexpr, ROWS: tl.constexpr,
+                    IN_STRIDE: tl.constexpr, OUT_STRIDE: tl.constexpr,
+                    REQS: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    reqs = tl.arange(0, REQS)
+    ends = tl.load(starts + reqs + 1, reqs < N, other=0)
+    # Zero-length padding requests do not own a row. Actual device lengths,
+    # not the CPU's evenly-distributed adaptive placeholders, define ownership.
+    owner = tl.sum(((row >= ends) & (reqs < N)).to(tl.int32), 0)
+    valid = owner < N
+    owner = tl.minimum(owner, N - 1)
+    begin = tl.load(starts + owner)
+    end = tl.load(starts + owner + 1)
+    length = tl.load(seq + owner)
+    value = length - (end - begin) + row - begin + 1
+    tl.store(out_seq + row, tl.where(valid, value, 0))
+    tl.store(out_lens + row, 1)
+    for base in range(tl.cdiv(OUT_STRIDE, BLOCK)):
+        col = base * BLOCK + tl.arange(0, BLOCK)
+        v = tl.load(bt + owner * IN_STRIDE + col,
+                    valid & (col < OUT_STRIDE), other=0)
+        tl.store(out_bt + row * OUT_STRIDE + col, v, col < OUT_STRIDE)
+
+
+@triton.jit
+def _token_owners(starts, out, N: tl.constexpr, TOKENS: tl.constexpr,
+                  REQS: tl.constexpr, BLOCK: tl.constexpr):
+    rows = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    reqs = tl.arange(0, REQS)
+    ends = tl.load(starts + reqs + 1, reqs < N, other=0)
+    owner = tl.sum(((rows[:, None] >= ends[None, :])
+                    & (reqs[None, :] < N)).to(tl.int32), axis=1)
+    # CommonAttentionMetadata's incumbent pads unmapped rows with request 0.
+    tl.store(out + rows, tl.where(owner < N, owner, 0), rows < TOKENS)
+
+
+def prepare_token_owners(starts, out, num_tokens):
+    n = starts.numel() - 1
+    if num_tokens:
+        _token_owners[(triton.cdiv(num_tokens, 128),)](
+            starts, out, n, num_tokens, triton.next_power_of_2(n), 128)
+    return out[:num_tokens]
+
+
+def prepare_flattened_decode(seq, block_table, query_start_loc,
+                             out_seq, out_bt, out_lens, num_rows):
+    """Write persistent buffers, including safe zeros for graph-padding rows.
+
+    out_lens may alias the builder's per-request decode_lens: the kernel never
+    reads that tensor. All ownership is derived from immutable query_start_loc.
+    """
+    n = seq.shape[0]
+    _flatten_decode[(num_rows,)](
+        seq, block_table, query_start_loc, out_seq, out_bt, out_lens,
+        n, num_rows, block_table.stride(0), out_bt.stride(0),
+        triton.next_power_of_2(n), 256)
+    out_seq[num_rows:] = 0
