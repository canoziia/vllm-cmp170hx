+    def retained_limits(self, requests):
+        """Keep authenticated pinned widths when new decisions are ineligible.
+
+        In-flight/stale-output and cohort-capacity gates may omit a resident
+        from choose(). Absence must not mean full5 for an active experiment.
+        Failed revisions and manual requests retain the ordinary fallback path.
+        """
+        result = {}
+        for request in requests:
+            entry = self.active.get(request.request_id)
+            if (entry is not None and not entry.failed
+                    and entry.version not in self.disabled
+                    and getattr(request, 'verification_draft_limit', None) is None):
+                result[request.request_id] = entry.k
+        return result
