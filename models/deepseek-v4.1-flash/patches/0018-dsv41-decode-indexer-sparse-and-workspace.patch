+@triton.jit(do_not_specialize=["max_model_len", "topk_tokens"])
+def _prepare_decode_candidates_kernel(
+    cands_ptr,
+    out_ptr,
+    lens_ptr,
+    context_lens_ptr,
+    stride_cr,
+    stride_ck,
+    stride_or,
+    stride_cl_b,
+    stride_cl_n,
+    max_model_len,
+    topk_tokens,
+    next_n: tl.constexpr,
+    K_CAND: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    CAND_BLK: tl.constexpr,
+    FALLBACK_BLKS: tl.constexpr,
+    IS_2D_LENS: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    batch_id = row // next_n
+    next_n_id = row % next_n
+
+    if IS_2D_LENS:
+        raw_len = tl.load(
+            context_lens_ptr + batch_id * stride_cl_b + next_n_id * stride_cl_n
+        )
+    else:
+        ctx_len = tl.load(context_lens_ptr + batch_id * stride_cl_b)
+        raw_len = ctx_len - next_n + next_n_id.to(tl.int32) + 1
+
+    L = tl.minimum(tl.maximum(raw_len, 0), max_model_len)
+    if L <= topk_tokens:
+        tl.store(lens_ptr + row, L)
+        tl.store(out_ptr + row * stride_or, -1)
+        return
+
+    cols = tl.arange(0, BLOCK_K)
+    raw = tl.load(
+        cands_ptr + row * stride_cr + cols * stride_ck,
+        mask=cols < K_CAND,
+        other=-1,
+    )
+    SENTINEL: tl.constexpr = 0x7FFFFFFF
+    is_edge = (cols < K_CAND) & (raw >= 0) & (raw.to(tl.int64) * CAND_BLK >= max_model_len)
+    in_range = (cols < K_CAND) & (raw >= 0) & (raw.to(tl.int64) * CAND_BLK < L)
+    last_blk = (max_model_len - 1) // CAND_BLK
+    edge_key = tl.where(L >= max_model_len, (last_blk << 2) | 1, SENTINEL)
+    keys = tl.where(in_range, raw << 2, tl.where(is_edge, edge_key, SENTINEL))
+    s_keys = tl.sort(keys)
+
+    tl.store(out_ptr + row * stride_or + cols, s_keys)
+    tl.debug_barrier()
+    prev = tl.load(out_ptr + row * stride_or + cols - 1, mask=cols > 0, other=-4)
+    blk = s_keys >> 2
+    prev_blk = prev >> 2
+    is_uniq = (s_keys < SENTINEL) & ((cols == 0) | (blk != prev_blk))
+    n_uniq = tl.sum(is_uniq.to(tl.int32), axis=0)
+
+    if n_uniq > FALLBACK_BLKS:
+        dst = tl.cumsum(is_uniq.to(tl.int32), axis=0) - 1
+        tl.store(out_ptr + row * stride_or + cols, -1, mask=cols >= n_uniq)
+        tl.debug_barrier()
+        tl.store(out_ptr + row * stride_or + dst, s_keys, mask=is_uniq)
+        last_b = tl.max(tl.where(is_uniq, blk, 0), axis=0)
+        tail = tl.minimum(CAND_BLK, L - last_b * CAND_BLK)
+        c_len = (n_uniq - 1) * CAND_BLK + tail
+        tl.store(lens_ptr + row, c_len)
+    else:
+        # Fewer than FALLBACK_BLKS kept blocks on a row with L > topk_tokens:
+        # include fallback blocks 0..FALLBACK_BLKS-1 with tag=2 (-inf) so
+        # persistent_topk breaks ties among -inf columns identically to full width.
+        is_hi = is_uniq & (blk >= FALLBACK_BLKS)
+        dst_hi = tl.cumsum(is_hi.to(tl.int32), axis=0) - 1
+        n_hi = tl.sum(is_hi.to(tl.int32), axis=0)
+        total_out = FALLBACK_BLKS + n_hi
+        fb_val = tl.where(cols < FALLBACK_BLKS, (cols << 2) | 2, -1)
+        tl.store(out_ptr + row * stride_or + cols, fb_val)
+        tl.debug_barrier()
+        is_lo = is_uniq & (blk < FALLBACK_BLKS)
+        tl.store(out_ptr + row * stride_or + blk, s_keys, mask=is_lo)
+        tl.store(out_ptr + row * stride_or + FALLBACK_BLKS + dst_hi, s_keys, mask=is_hi)
+        last_b = tl.maximum(
+            FALLBACK_BLKS - 1, tl.max(tl.where(is_uniq, blk, 0), axis=0)
+        )
+        tail = tl.minimum(CAND_BLK, L - last_b * CAND_BLK)
+        c_len = (total_out - 1) * CAND_BLK + tail
+        tl.store(lens_ptr + row, c_len)
