+def _decode_chunk_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_DECODE_LOGITS_CHUNK", "0") == "1"
+
+
+def _has_filtered_topk_smem(device: torch.device) -> bool:
+    return (
+        torch.cuda.get_device_properties(device).shared_memory_per_block_optin
+        >= 128 * 1024
+    )
+
+
+def _decode_sparse_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_INDEXER_DECODE_SPARSE", "0") == "1"
+
+
+def _decode_chunk_plan(
+    batch_size: int, next_n: int, width: int, cap_elems: int
+) -> list[tuple[int, int]] | None:
+    """Split ``batch_size`` requests into groups whose ``rows x width`` fp32
+    logits fit ``cap_elems``. ``None`` when one request alone does not fit."""
+    rows_per_req = next_n * width
+    if batch_size <= 0 or rows_per_req <= 0:
+        return None
+    reqs = cap_elems // rows_per_req
+    if reqs < 1:
+        return None
+    return [(b0, min(b0 + reqs, batch_size)) for b0 in range(0, batch_size, reqs)]
+
+
+def _maybe_decode_sparse_candidates(
+    q: torch.Tensor,
+    kv_cache: torch.Tensor,
+    weights: torch.Tensor,
+    seq_lens: torch.Tensor,
+    block_table: torch.Tensor,
+    decode_metadata,
+    topk_indices_buffer: torch.Tensor,
+    topk_tokens: int,
+    next_n: int,
+    row_lo: int,
+    num_padded_tokens: int,
+    candidate_blocks: torch.Tensor | None,
+    candidate_block_size: int,
+    candidate_write: bool,
+    use_sparse: bool,
+) -> bool:
+    """Score only candidate blocks on v4.1 reader layers (opt-in)."""
+    if not (use_sparse and _decode_sparse_enabled()):
+        return False
+    if not current_platform.is_cuda():
+        return False
+    if candidate_blocks is None or candidate_write:
+        return False
+    if (
+        candidate_block_size <= 0
+        or (candidate_block_size & (candidate_block_size - 1)) != 0
+        or candidate_block_size > 64
+    ):
+        return False
+    if topk_tokens not in (512, 1024, 2048):
+        return False
+    if (
+        num_padded_tokens <= 64
+        and current_platform.has_device_capability(90)
+        and not current_platform.is_device_capability_family(120)
+    ):
+        return False
+
+    batch_size = q.shape[0]
+    num_rows = batch_size * next_n
+    if batch_size <= 0 or seq_lens.numel() != num_rows:
+        return False
+
+    k_cand = candidate_blocks.shape[1]
+    cand_width = k_cand * candidate_block_size
+    fallback_blks = topk_tokens // candidate_block_size + 1
+    if k_cand < 2 * fallback_blks:
+        return False
+
+    width = int(decode_metadata.max_seq_len)
+    if width <= cand_width:
+        return False
+
+    block_k = max(
+        triton.next_power_of_2(k_cand), triton.next_power_of_2(2 * fallback_blks)
+    )
+    ws_mgr = current_workspace_manager()
+    capturing = torch.cuda.is_current_stream_capturing()
+    _, _, num_heads, head_dim = q.shape
+    q_elems_f32 = (num_heads * head_dim + 1) // 2
+    if capturing and not ws_mgr.is_locked():
+        try:
+            (topk_workspace,) = ws_mgr.get_simultaneous(
+                ((RADIX_TOPK_WORKSPACE_SIZE,), torch.uint8),
+            )
+        except AssertionError:
+            return False
+        logits_workspace = None
+        cands_workspace = None
+        lens_workspace = None
+        q_bf16_workspace = None
+        plan = [(0, batch_size)]
+    else:
+        cap_elems = envs.VLLM_SPARSE_INDEXER_MAX_LOGITS_MB * 1024 * 1024 // 4
+        elems_per_col = cand_width + block_k + 1 + q_elems_f32
+        plan = _decode_chunk_plan(batch_size, next_n, elems_per_col, cap_elems)
+        if plan is None:
+            return False
+        chunk_rows = (plan[0][1] - plan[0][0]) * next_n
+        try:
+            (
+                topk_workspace,
+                logits_workspace,
+                cands_workspace,
+                lens_workspace,
+                q_bf16_workspace,
+            ) = ws_mgr.get_simultaneous(
+                ((RADIX_TOPK_WORKSPACE_SIZE,), torch.uint8),
+                ((chunk_rows * cand_width,), torch.float32),
+                ((chunk_rows * block_k,), torch.int32),
+                ((chunk_rows,), torch.int32),
+                ((chunk_rows * num_heads * head_dim,), torch.bfloat16),
+            )
+        except AssertionError:
+            return False
+
+    for b0, b1 in plan:
+        r0, r1 = b0 * next_n, b1 * next_n
+        seq_chunk = seq_lens[b0:b1]
+        cand_chunk = candidate_blocks[row_lo + r0 : row_lo + r1]
+        topk_chunk = topk_indices_buffer[row_lo + r0 : row_lo + r1, :topk_tokens]
+        compact_logits, sorted_cands, compact_lens = (
+            fp8_paged_mqa_logits_candidates_triton(
+                q[b0:b1],
+                kv_cache,
+                weights[r0:r1],
+                seq_chunk,
+                block_table[b0:b1],
+                cand_chunk,
+                max_model_len=width,
+                candidate_block_size=candidate_block_size,
+                topk_tokens=topk_tokens,
+                clean_logits=False,
+                out=logits_workspace,
+                sorted_cands_out=cands_workspace,
+                compact_lens_out=lens_workspace,
+                q_bf16_out=q_bf16_workspace,
+            )
+        )
+        torch.ops._C.persistent_topk(
+            compact_logits,
+            compact_lens,
+            topk_chunk,
+            topk_workspace,
+            topk_tokens,
+            cand_width,
+        )
+        remap_paged_mqa_candidates_topk_triton(
+            topk_chunk,
+            sorted_cands,
+            compact_lens,
+            candidate_block_size=candidate_block_size,
+            topk_tokens=topk_tokens,
+        )
+    return True
+
+
+def _maybe_decode_chunked(
+    q: torch.Tensor,
+    kv_cache: torch.Tensor,
+    weights: torch.Tensor,
+    seq_lens: torch.Tensor,
+    block_table: torch.Tensor,
+    decode_metadata,
+    topk_indices_buffer: torch.Tensor,
+    topk_tokens: int,
+    next_n: int,
+    row_lo: int,
+    candidate_blocks: torch.Tensor | None,
+    candidate_block_size: int,
+    candidate_write: bool,
+    use_chunk: bool,
+) -> bool:
+    """Decode logits/candidates/top-k in the fixed workspace (opt-in).
+
+    Returns False (caller runs the original path) unless enabled, eager, on
+    the SM80 Triton fallback with the portable persistent top-k, and the
+    bounded workspace is available. Rows are processed in groups of whole
+    requests; each row's logits, candidate selection and top-k depend only on
+    that row, so results are unchanged (validated by the GPU test).
+    """
+    if not (use_chunk and _decode_chunk_enabled()):
+        return False
+    if not current_platform.is_cuda() or torch.cuda.is_current_stream_capturing():
+        return False
+    if topk_tokens not in (512, 1024, 2048):
+        return False  # persistent_topk is the only kernel reproduced here
+    batch_size = q.shape[0]
+    num_rows = batch_size * next_n
+    if seq_lens.numel() != num_rows:
+        return False
+    if (
+        num_rows <= 64
+        and current_platform.has_device_capability(90)
+        and not current_platform.is_device_capability_family(120)
+    ):
+        return False  # the original would pick cooperative_topk
+    width = int(decode_metadata.max_seq_len)
+    cap_elems = envs.VLLM_SPARSE_INDEXER_MAX_LOGITS_MB * 1024 * 1024 // 4
+    plan = _decode_chunk_plan(batch_size, next_n, width, cap_elems)
+    if plan is None:
+        return False
+    chunk_elems = (plan[0][1] - plan[0][0]) * next_n * width
+    try:
+        topk_workspace, logits_workspace = current_workspace_manager().get_simultaneous(
+            ((RADIX_TOPK_WORKSPACE_SIZE,), torch.uint8),
+            ((chunk_elems,), torch.float32),
+        )
+    except AssertionError:
+        return False  # locked workspace too small: keep the original path
+    for b0, b1 in plan:
+        r0, r1 = b0 * next_n, b1 * next_n
+        seq_chunk = seq_lens[b0:b1]
+        logits = fp8_paged_mqa_logits_triton(
+            q[b0:b1],
+            kv_cache,
+            weights[r0:r1],
+            seq_chunk,
+            block_table[b0:b1],
+            max_model_len=width,
+            clean_logits=False,
+            out=logits_workspace,
+        )
+        rows = logits.shape[0]
+        if candidate_blocks is not None:
+            vis = seq_chunk.reshape(-1)
+            row_repeat = next_n if vis.numel() != rows else 1
+            vis = vis[:rows]
+            cand = candidate_blocks[row_lo + r0 : row_lo + r1]
+            if candidate_write:
+                _select_candidate_blocks(
+                    logits,
+                    None,
+                    vis,
+                    cand.shape[1],
+                    candidate_block_size,
+                    cand,
+                    row_repeat,
+                )
+            else:
+                _apply_candidate_mask(
+                    logits, None, vis, cand, candidate_block_size, row_repeat
+                )
+        topk_max_len = (
+            topk_tokens
+            if num_rows > 32 and _has_filtered_topk_smem(q.device)
+            else logits.shape[1]
+        )
+        torch.ops._C.persistent_topk(
+            logits,
+            seq_chunk,
+            topk_indices_buffer[row_lo + r0 : row_lo + r1, :topk_tokens],
+            topk_workspace,
+            topk_tokens,
+            topk_max_len,
+        )
+    return True
+
