+    BLOCK_H = max(16, triton.next_power_of_2(num_heads))
+    BLOCK_D = triton.next_power_of_2(head_dim)
+    BLOCK_N = 128 if cand_width >= 128 and candidate_block_size <= 128 else 64
+
+    fp8_lut = _get_e4m3fn_bf16_lut(q.device)
+    if q_is_bf16 and q_byte.is_contiguous():
+        q_in = paged_q_lut_decode(q_byte, fp8_lut, out=q_bf16_out)
+    elif q_is_bf16:
+        q_in = fp8_lut.index_select(0, q_byte.reshape(-1).to(torch.int32)).view(
+            q_byte.shape
+        )
+    else:
+        q_in = q_byte
+
+    grid = (rows, triton.cdiv(cand_width, BLOCK_N))
+    _fp8_paged_mqa_logits_candidates_kernel[grid](
+        q_in,
+        kv_byte,
+        kv_scale,
+        weights,
+        fp8_lut,
+        sorted_cands,
+        compact_lens,
+        block_tables,
+        logits,
+        q_in.stride(0),
+        q_in.stride(1),
+        q_in.stride(2),
+        q_in.stride(3),
+        kv_byte.stride(0),
+        kv_byte.stride(1),
+        kv_byte.stride(2),
+        kv_scale.stride(0),
+        kv_scale.stride(1),
+        weights.stride(0),
+        weights.stride(1),
+        sorted_cands.stride(0),
+        block_tables.stride(0),
+        block_tables.stride(1),
+        logits.stride(0),
+        logits.stride(1),
+        max_model_len,
+        topk_tokens,
+        next_n=next_n,
+        num_heads=num_heads,
+        head_dim=head_dim,
+        page_block_size=page_block_size,
+        CAND_BLK=candidate_block_size,
+        BLOCK_H=BLOCK_H,
+        BLOCK_D=BLOCK_D,
+        BLOCK_N=BLOCK_N,
+        Q_IS_BF16=q_is_bf16,
+        num_warps=4,
+        num_stages=4,
+    )
+    return logits, sorted_cands, compact_lens
