+@triton.jit(do_not_specialize=["topk_tokens"])
+def _remap_compact_topk_kernel(
+    topk_ptr,
+    sorted_cands_ptr,
+    compact_lens_ptr,
+    stride_tr,
+    stride_tk,
+    stride_scr,
+    topk_tokens,
+    CAND_BLK: tl.constexpr,
+    BLOCK_TOPK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    compact_len = tl.load(compact_lens_ptr + row)
+    if compact_len <= topk_tokens:
+        return
+
+    offs = tl.arange(0, BLOCK_TOPK)
+    mask = offs < topk_tokens
+    c_idx = tl.load(topk_ptr + row * stride_tr + offs * stride_tk, mask=mask, other=-1)
+    valid = mask & (c_idx >= 0)
+    cand_slot = tl.where(valid, c_idx // CAND_BLK, 0)
+    in_cand = c_idx % CAND_BLK
+    cand_enc = tl.load(
+        sorted_cands_ptr + row * stride_scr + cand_slot, mask=valid, other=-1
+    )
+    cand_blk = cand_enc >> 2
+    k_pos = tl.where(valid & (cand_enc >= 0), cand_blk * CAND_BLK + in_cand, -1)
+    tl.store(topk_ptr + row * stride_tr + offs * stride_tk, k_pos, mask=mask)
+
