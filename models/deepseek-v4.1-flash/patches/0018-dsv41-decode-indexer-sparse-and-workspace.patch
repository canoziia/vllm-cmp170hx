+@triton.jit(do_not_specialize=["max_model_len", "topk_tokens"])
+def _fp8_paged_mqa_logits_candidates_kernel(
+    q_ptr,
+    kv_fp8_ptr,
+    kv_scale_ptr,
+    weights_ptr,
+    fp8_lut_ptr,
+    sorted_cands_ptr,
+    compact_lens_ptr,
+    block_tables_ptr,
+    logits_ptr,
+    stride_q_b,
+    stride_q_n,
+    stride_q_h,
+    stride_q_d,
+    stride_kvf_block,
+    stride_kvf_s,
+    stride_kvf_d,
+    stride_kvs_block,
+    stride_kvs_s,
+    stride_w_t,
+    stride_w_h,
+    stride_sc_r,
+    stride_bt_b,
+    stride_bt_k,
+    stride_l_t,
+    stride_l_n,
+    max_model_len,
+    topk_tokens,
+    next_n: tl.constexpr,
+    num_heads: tl.constexpr,
+    head_dim: tl.constexpr,
+    page_block_size: tl.constexpr,
+    CAND_BLK: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    Q_IS_BF16: tl.constexpr,
+):
+    token_id = tl.program_id(0)
+    tile_id = tl.program_id(1)
+
+    compact_len = tl.load(compact_lens_ptr + token_id)
+    if (compact_len <= topk_tokens) | (tile_id * BLOCK_N >= compact_len):
+        return
+
+    batch_id = token_id // next_n
+    next_n_id = token_id % next_n
+
+    offs_n = tl.arange(0, BLOCK_N)
+    col_idx = tile_id * BLOCK_N + offs_n
+    cand_slot = col_idx // CAND_BLK
+    in_cand = col_idx % CAND_BLK
+
+    cand_enc = tl.load(
+        sorted_cands_ptr + token_id * stride_sc_r + cand_slot,
+        mask=col_idx < compact_len,
+        other=-1,
+    )
+    cand_tag = cand_enc & 3
+    cand_blk = cand_enc >> 2
+    k_pos = cand_blk * CAND_BLK + in_cand
+    need_score = (
+        (col_idx < compact_len)
+        & (cand_enc >= 0)
+        & ((cand_tag == 0) | ((cand_tag == 1) & (k_pos == max_model_len - 1)))
+    )
+
+    safe_k_pos = tl.where(need_score, k_pos, 0)
+    page_rk = safe_k_pos // page_block_size
+    page_off = safe_k_pos % page_block_size
+    phys_block = tl.load(
+        block_tables_ptr + batch_id * stride_bt_b + page_rk * stride_bt_k,
+        mask=need_score,
+        other=0,
+    ).to(tl.int64)
+
+    offs_h = tl.arange(0, BLOCK_H)
+    offs_d = tl.arange(0, BLOCK_D)
+    mask_h = offs_h < num_heads
+    mask_d = offs_d < head_dim
+
+    q_base = q_ptr + batch_id * stride_q_b + next_n_id * stride_q_n
+    q_offs = offs_h[:, None] * stride_q_h + offs_d[None, :] * stride_q_d
+    q_mask = mask_h[:, None] & mask_d[None, :]
+    if Q_IS_BF16:
+        q = tl.load(q_base + q_offs, mask=q_mask, other=0.0)
+    else:
+        q = _decode_e4m3fn_bf16_lut(
+            tl.load(q_base + q_offs, mask=q_mask, other=0), fp8_lut_ptr
+        )
+
+    k_byte = tl.load(
+        kv_fp8_ptr
+        + phys_block[:, None] * stride_kvf_block
+        + page_off[:, None] * stride_kvf_s
+        + offs_d[None, :] * stride_kvf_d,
+        mask=need_score[:, None] & mask_d[None, :],
+        other=0,
+    )
+    k_scale = tl.load(
+        kv_scale_ptr + phys_block * stride_kvs_block + page_off * stride_kvs_s,
+        mask=need_score,
+        other=0.0,
+    )
+    k = _decode_e4m3fn_bf16_lut(k_byte, fp8_lut_ptr)
+    s = tl.dot(q, tl.trans(k)) * k_scale[None, :]
+
+    w = tl.load(
+        weights_ptr + token_id * stride_w_t + offs_h * stride_w_h,
+        mask=mask_h,
+        other=0.0,
+    )
+    s = tl.where(s > 0, s, 0.0) * w[:, None]
