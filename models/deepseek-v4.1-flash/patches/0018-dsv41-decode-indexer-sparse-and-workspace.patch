+def fp8_paged_mqa_logits_candidates_triton(
+    q: torch.Tensor,
+    kv_cache: torch.Tensor,
+    weights: torch.Tensor,
+    context_lens: torch.Tensor,
+    block_tables: torch.Tensor,
+    candidate_blocks: torch.Tensor,
+    max_model_len: int,
+    candidate_block_size: int = 8,
+    topk_tokens: int = 512,
+    clean_logits: bool = False,
+    out: torch.Tensor | None = None,
+    sorted_cands_out: torch.Tensor | None = None,
+    compact_lens_out: torch.Tensor | None = None,
+    q_bf16_out: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Candidate-block sparse paged MQA logits for DeepSeek V4.1 decode.
+
+    Scores only the ``K_cand = candidate_blocks.shape[1]`` candidate blocks of
+    size ``candidate_block_size`` into a compact ``[B * next_n, K_cand *
+    candidate_block_size]`` fp32 buffer with bit-identical operands and
+    reduction tree to :func:`fp8_paged_mqa_logits_triton`. Candidate blocks are
+    canonicalized (sorted by ascending block ID, deduplicated, and edge-clamped
+    identically to ``apply_candidate_mask``) so ``persistent_topk`` on the
+    compact buffer produces exact tie-breaking and ascending index order.
+    """
+    B, next_n, num_heads, head_dim = q.shape
+    rows = B * next_n
+    _, page_block_size, one, d_plus_4 = kv_cache.shape
+    assert one == 1
+    assert d_plus_4 == head_dim + 4
+    assert candidate_blocks.shape[0] == rows
+    k_cand = candidate_blocks.shape[1]
+    fallback_blks = topk_tokens // candidate_block_size + 1
+    block_k = max(
+        triton.next_power_of_2(k_cand), triton.next_power_of_2(2 * fallback_blks)
+    )
+    cand_width = k_cand * candidate_block_size
+    assert k_cand >= 2 * fallback_blks
+
+    num_blocks = kv_cache.shape[0]
+    kv_flat = kv_cache.view(num_blocks, -1)
+    k_end = page_block_size * head_dim
+    kv_byte = kv_flat[:, :k_end].as_strided(
+        (num_blocks, page_block_size, head_dim),
+        (kv_flat.stride(0), head_dim, 1),
+    )
+    kv_scale = kv_flat[:, k_end:].view(torch.float32)
+    q_byte = q.view(torch.uint8)
+    q_is_bf16 = _paged_q_bf16_default(q.device)
+
+    n_logits = rows * cand_width
+    if out is not None:
+        if (
+            out.dtype != torch.float32
+            or out.device != q.device
+            or not out.is_contiguous()
+            or out.numel() < n_logits
+        ):
+            raise ValueError("Invalid sparse-candidates logits workspace")
+        logits = out.view(-1)[:n_logits].view(rows, cand_width)
+        if clean_logits:
+            logits.fill_(float("-inf"))
+    elif clean_logits:
+        logits = torch.full(
+            (rows, cand_width), float("-inf"), dtype=torch.float32, device=q.device
+        )
+    else:
+        logits = torch.empty((rows, cand_width), dtype=torch.float32, device=q.device)
+
+    n_cands = rows * block_k
+    if sorted_cands_out is not None:
+        if (
+            sorted_cands_out.dtype != torch.int32
+            or sorted_cands_out.device != q.device
+            or not sorted_cands_out.is_contiguous()
+            or sorted_cands_out.numel() < n_cands
+        ):
+            raise ValueError("Invalid sorted_cands workspace")
+        sorted_cands = sorted_cands_out.view(-1)[:n_cands].view(rows, block_k)
+    else:
+        sorted_cands = torch.empty((rows, block_k), dtype=torch.int32, device=q.device)
+
+    if compact_lens_out is not None:
+        if (
+            compact_lens_out.dtype != torch.int32
+            or compact_lens_out.device != q.device
+            or not compact_lens_out.is_contiguous()
+            or compact_lens_out.numel() < rows
+        ):
+            raise ValueError("Invalid compact_lens workspace")
+        compact_lens = compact_lens_out.view(-1)[:rows]
+    else:
+        compact_lens = torch.empty((rows,), dtype=torch.int32, device=q.device)
+
+    if rows == 0:
+        return logits, sorted_cands, compact_lens
+
+    is_2d_lens = (
+        context_lens.ndim == 2 and next_n > 1 and context_lens.shape == (B, next_n)
+    )
+    prep_warps = 8 if block_k >= 1024 else 4
+    _prepare_decode_candidates_kernel[(rows,)](
+        candidate_blocks,
+        sorted_cands,
+        compact_lens,
+        context_lens,
+        candidate_blocks.stride(0),
+        candidate_blocks.stride(1),
+        sorted_cands.stride(0),
+        context_lens.stride(0),
+        context_lens.stride(1) if is_2d_lens else 0,
+        max_model_len,
+        topk_tokens,
+        next_n=next_n,
+        K_CAND=k_cand,
+        BLOCK_K=block_k,
+        CAND_BLK=candidate_block_size,
+        FALLBACK_BLKS=fallback_blks,
+        IS_2D_LENS=is_2d_lens,
+        num_warps=prep_warps,
+    )
