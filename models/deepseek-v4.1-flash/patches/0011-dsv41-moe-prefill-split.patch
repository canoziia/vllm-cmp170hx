@@ -3093,6 +3093,15 @@ def _rocm_sparse_attn_prefill_ragged_triton(
     block_d = triton.next_power_of_2(head_dim)
     block_k = _prefill_block_k(head_dim)
     num_warps = 4
+    # PP6/TP1: reuse gathered rows across all 64 heads, preserving BLOCK_K=32
+    # and the incumbent per-head arithmetic (bitwise checked on sm80).
+    if (os.getenv("VLLM_DSV41_SPARSE_PREFILL_64H", "0") == "1"
+            and current_platform.is_cuda()
+            and torch.cuda.get_device_capability(q.device) == (8, 0)
+            and 512 <= num_queries <= 4096 and num_heads == 64
+            and head_dim == 512 and nope_head_dim == 448 and rope_head_dim == 64
+            and q.dtype == kv.dtype == torch.bfloat16 and block_k == 32):
+        block_h, num_warps = 64, 8
     # When the tile covers the data exactly, every head/dim mask in the kernel
     # is all-true and buys nothing but predication on its hottest instructions.
     # Specialize rather than delete: ranks whose head count is not the tile
