From 3df20aa63fe68d42667b7214efe263ed338738fb Mon Sep 17 00:00:00 2001
From: Canoziia <canoziia@projectk.org>
Date: Wed, 25 Nov 2026 00:15:41 +0800
Subject: [PATCH] fix(sm80): lazy Marlin aux-stream locks and chunked 1M
 indexer metadata copy

---
 .../layers/quantization/utils/marlin_utils.py | 31 +++++++++++++++++--
 vllm/v1/attention/ops/metadata.py             | 28 +++++++++++------
 2 files changed, 47 insertions(+), 12 deletions(-)

diff --git a/vllm/model_executor/layers/quantization/utils/marlin_utils.py b/vllm/model_executor/layers/quantization/utils/marlin_utils.py
index e7b3ca7..944de3a 100644
--- a/vllm/model_executor/layers/quantization/utils/marlin_utils.py
+++ b/vllm/model_executor/layers/quantization/utils/marlin_utils.py
@@ -428,14 +428,41 @@ def get_marlin_workspace(device: torch.device) -> torch.Tensor:
     if not is_workspace_manager_initialized():
         return marlin_make_workspace_new(device, MARLIN_MAX_BLOCKS_PER_SM)
 
-    return current_workspace_manager().get_persistent(
-        ("marlin_locks", current_stream()),
+    stream = current_stream()
+    manager = current_workspace_manager()
+    if manager.is_locked() and not torch.cuda.is_current_stream_capturing():
+        # Eager side streams (shared-expert aux stream for 193..256 tokens,
+        # multi-stream attention GEMMs up to 1024 tokens) can reach Marlin
+        # with a stream that no warmup or capture ever used. The locks are a
+        # few KiB, never resized and outside every CUDA graph, so allocate
+        # them lazily per stream instead of failing the request.
+        key = (device.index, stream.cuda_stream)
+        locks = _EAGER_STREAM_MARLIN_LOCKS.get(key)
+        if locks is None:
+            try:
+                return manager.get_persistent(
+                    ("marlin_locks", stream),
+                    (num_compute_units(device.index) * MARLIN_MAX_BLOCKS_PER_SM,),
+                    torch.int,
+                    zero_init=True,
+                )
+            except AssertionError:
+                locks = marlin_make_workspace_new(device, MARLIN_MAX_BLOCKS_PER_SM)
+                _EAGER_STREAM_MARLIN_LOCKS[key] = locks
+        return locks
+
+    return manager.get_persistent(
+        ("marlin_locks", stream),
         (num_compute_units(device.index) * MARLIN_MAX_BLOCKS_PER_SM,),
         torch.int,
         zero_init=True,
     )
 
 
+# Marlin locks of eager side streams first seen after the workspace locked.
+_EAGER_STREAM_MARLIN_LOCKS: dict[tuple[int | None, int], torch.Tensor] = {}
+
+
 def _marlin_gemm(
     a: torch.Tensor,
     b_q_weight: torch.Tensor,
diff --git a/vllm/v1/attention/ops/metadata.py b/vllm/v1/attention/ops/metadata.py
index 98bc72b..65b87bc 100644
--- a/vllm/v1/attention/ops/metadata.py
+++ b/vllm/v1/attention/ops/metadata.py
@@ -77,7 +77,6 @@ def _indexer_decode_metadata_kernel(
     BLOCK_COLS: tl.constexpr,
 ):
     token = tl.program_id(0)
-    cols = tl.arange(0, triton.next_power_of_2(BLOCK_COLS))
     actual_tokens = tl.load(query_start_loc + num_reqs)
     if token < num_tokens:
         req = _token_request(query_start_loc, tl.full((1,), token, tl.int32), num_reqs)
@@ -92,16 +91,25 @@ def _indexer_decode_metadata_kernel(
         tl.store(
             indices + token, tl.where(valid, req, num_reqs + token - actual_tokens)
         )
-        blocks = tl.load(
-            block_table + req.to(tl.int64) * input_stride + cols,
-            valid & (cols < BLOCK_COLS),
-            other=0,
-        )
-        tl.store(
-            output_block_table + token.to(tl.int64) * output_stride + cols,
-            blocks,
-            cols < BLOCK_COLS,
+        req_cols = tl.where(
+            valid, tl.minimum(BLOCK_COLS, (length >> 6) + 2), 0
         )
+        col_offs = tl.arange(0, 256)
+        col_base = 0
+        while col_base < req_cols:
+            cols = col_base + col_offs
+            mask = cols < req_cols
+            blocks = tl.load(
+                block_table + req.to(tl.int64) * input_stride + cols,
+                mask,
+                other=0,
+            )
+            tl.store(
+                output_block_table + token.to(tl.int64) * output_stride + cols,
+                blocks,
+                mask,
+            )
+            col_base += 256
     else:
         tail = num_tokens + (token - num_tokens) * 256 + tl.arange(0, 256)
         tl.store(output_seq_lens + tail, 0, tail < capacity)
-- 
