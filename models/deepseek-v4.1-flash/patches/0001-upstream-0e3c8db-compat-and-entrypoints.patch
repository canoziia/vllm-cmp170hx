+class _LazyOpArity:
+    """Resolve torch.ops schema arity lazily after WorkerProc loads C++ libs."""
+
+    __slots__ = ("ns_name", "op_name", "default", "_cached")
+
+    def __init__(self, ns_name: str, op_name: str, default: int) -> None:
+        self.ns_name = ns_name
+        self.op_name = op_name
+        self.default = default
+        self._cached: int | None = None
+
+    def _val(self) -> int:
+        if self._cached is not None:
+            return self._cached
+        try:
+            ns = getattr(torch.ops, self.ns_name, None)
+            if ns is None or not hasattr(ns, self.op_name):
+                return self.default
+            packet = getattr(ns, self.op_name)
+            overload = getattr(packet, "default", packet)
+            val = len(overload._schema.arguments)
+            self._cached = val
+            return val
+        except Exception:
+            return self.default
+
+    def __int__(self) -> int:
+        return self._val()
+
+    def __lt__(self, other: int) -> bool:
+        return self._val() < other
+
+    def __le__(self, other: int) -> bool:
+        return self._val() <= other
+
+    def __gt__(self, other: int) -> bool:
+        return self._val() > other
+
+    def __ge__(self, other: int) -> bool:
+        return self._val() >= other
+
+    def __eq__(self, other: object) -> bool:
+        if isinstance(other, int):
+            return self._val() == other
+        return NotImplemented
+
+
+def _op_num_args(ns_name: str, op_name: str, default: int) -> _LazyOpArity:
+    return _LazyOpArity(ns_name, op_name, default)
+
