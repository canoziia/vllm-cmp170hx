+    float f;
+    std::memcpy(&f, &b, sizeof(f));
+    return f;
+}
+
+static inline uint32_t f32_to_bits(float f) {
+    uint32_t b;
+    std::memcpy(&b, &f, sizeof(b));
+    return b;
+}
+
