+def _engram_packed_stride(min_row_bytes: int) -> int:
+    # Default 16-byte alignment (e.g. 264 -> 272 bytes) preserves 128-bit
+    # vectorized LDG.E.128 UVA loads on SM80 while keeping host overhead ~3%.
+    default_stride = ((min_row_bytes + 15) // 16) * 16
+    stride = int(os.environ.get("VLLM_DSV41_ENGRAM_PACKED_STRIDE", str(default_stride)))
+    if stride < min_row_bytes:
+        raise ValueError(
+            f"VLLM_DSV41_ENGRAM_PACKED_STRIDE={stride} < minimum row size {min_row_bytes}"
+        )
+    return stride
+
