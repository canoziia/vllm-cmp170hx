+class _AsyncPrefetchTask:
+    __slots__ = ("done", "exc")
+
+    def __init__(self) -> None:
+        self.done = threading.Event()
+        self.exc: BaseException | None = None
+
+    def wait(self) -> None:
+        self.done.wait()
+        if self.exc is not None:
+            raise self.exc
+
