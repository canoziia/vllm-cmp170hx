+    import os as _os
+    eager_pf = (
+        not dummy_run
+        and cg_mode == CUDAGraphMode.NONE
+        and input_batch.has_prefill
+    )
+    if (
+        not eager_pf
+        or _os.environ.get("VLLM_DSV41_YOCO_PREFILL_TRUNC", "0") != "1"
+        or input_batch.num_reqs <= 0
+        or not bool(input_batch.is_prefilling_np.all())
+    ):
+        return False, 0, eager_pf
+    from vllm.v1.core.sched.dsv41_prefill_sched import yoco_keep_tokens
+
+    keep = yoco_keep_tokens()
+    c_end = input_batch.num_computed_prefill_tokens_np + input_batch.num_scheduled_tokens
+    gaps = input_batch.prefill_len_np - c_end
+    if int(input_batch.cu_num_logits_np[-1]) == 0 and int(gaps.min()) >= keep:
+        return True, 0, eager_pf
+    if (
+        _os.environ.get("VLLM_DSV41_YOCO_PARTIAL_FFN", "0") == "1"
+        and input_batch.num_reqs == 1
+        and int(input_batch.cu_num_logits_np[-1]) <= 1
+    ):
+        c_start = int(input_batch.num_computed_prefill_tokens_np[0])
+        cutoff = int(input_batch.prefill_len_np[0]) - keep
+        drop = cutoff - c_start
+        sched = int(input_batch.num_scheduled_tokens[0])
+        if 0 < drop < sched:
+            return False, drop, eager_pf
+    return False, 0, eager_pf
