+def _dsv41_lm_target(model: nn.Module) -> nn.Module | None:
+    if hasattr(model, "set_dsv41_prefill_yoco_state"):
+        return model
+    lm = getattr(model, "language_model", None)
+    if lm is not None and hasattr(lm, "set_dsv41_prefill_yoco_state"):
+        return lm
+    return None
+
+
+def _unwrap_dsv41_pp_wire(
+    model: nn.Module,
+    local_it: IntermediateTensors | None,
+    wire_it: IntermediateTensors,
+    num_tokens: int,
+) -> None:
+    tdict = wire_it.tensors
+    if tdict.pop("__yoco_skip", False) and local_it is not None:
+        tdict["hidden_states"] = local_it.tensors["hidden_states"][:num_tokens]
+        tdict["pre_mix"] = local_it.tensors["pre_mix"][:num_tokens]
+    lm = _dsv41_lm_target(model)
+    if lm is not None:
+        lm.clear_dsv41_relayed_shadow()
+    relayed_keys = [
+        k
+        for k in list(tdict.keys())
+        if k.startswith(("__shadow_topk_", "__shadow_cand_"))
+    ]
+    if relayed_keys:
+        sources = {int(k.rsplit("_", 1)[-1]) for k in relayed_keys}
+        for s_id in sources:
+            tk = tdict.pop(f"__shadow_topk_{s_id}", None)
+            cb = tdict.pop(f"__shadow_cand_{s_id}", None)
+            if lm is not None:
+                lm.set_dsv41_relayed_shadow(s_id, tk, cb)
