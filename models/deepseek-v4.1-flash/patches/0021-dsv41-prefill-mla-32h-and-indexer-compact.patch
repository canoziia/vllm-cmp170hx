index 5840b73..b579f13 100644
--- a/vllm/model_executor/layers/sparse_attn_indexer.py
+++ b/vllm/model_executor/layers/sparse_attn_indexer.py
@@ -853,13 +853,13 @@ def sparse_attn_indexer(
         logits_workspace = workspace[2] if fixed_logits else None
         # VLLM_DSV41_INDEXER_PREFILL_FAST: tensor-core logits + pruned top-k
         # (bit-identical logits, identical top-k set). Default off.
-        fast_prefill = (
+        fast_prefill_capable = (
             fixed_logits
             and logits_workspace is not None
             and not use_fp4_cache
             and dcp_world_size <= 1
             and not current_platform.is_xpu()
-            and _dsv41_prefill.enabled()
+            and _dsv41_prefill.any_enabled()
         )
         fast_k_bf16 = None
         for chunk in prefill_metadata.chunks:
@@ -922,12 +922,24 @@ def sparse_attn_indexer(
                         clean_logits=False,
                     )
                 elif (
-                    fast_prefill
+                    fast_prefill_capable
+                    and _dsv41_prefill.layer_enabled(
+                        k_quant_cast.shape[0],
+                        candidate_blocks,
+                        candidate_block_size,
+                        candidate_write,
+                    )
                     and _dsv41_prefill.supported(
                         q_slice_cast, k_quant_cast, topk_tokens, dcp_world_size
                     )
-                    and q_slice_cast.shape[0] * k_quant_cast.shape[0]
-                    <= logits_workspace.numel()
+                    and _dsv41_prefill.fits_workspace(
+                        q_slice_cast.shape[0],
+                        k_quant_cast.shape[0],
