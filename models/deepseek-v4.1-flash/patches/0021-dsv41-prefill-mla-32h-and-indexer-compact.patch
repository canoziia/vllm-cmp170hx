                 ):
                     # Same K rows across a request's query sub-chunks: decode
                     # once and reuse while the gather is skipped.
@@ -1498,7 +1510,7 @@ class SparseAttnIndexer(CustomOp):
             elif not use_fp4_cache:
                 device = topk_indices_buffer.device
                 warmup_fp8_mqa_logits_triton(num_heads, head_dim, device)
-                if _dsv41_prefill.enabled():
+                if _dsv41_prefill.any_enabled():
                     # Load the extension and its decode table outside capture.
                     _dsv41_prefill.warmup(device)
                 # 64/256 are the V3.2 and V4 indexer kernel block sizes, 128
diff --git a/vllm/v1/attention/ops/dsv41_indexer_prefill.py b/vllm/v1/attention/ops/dsv41_indexer_prefill.py
index 0ee5db4..a148c02 100644
--- a/vllm/v1/attention/ops/dsv41_indexer_prefill.py
+++ b/vllm/v1/attention/ops/dsv41_indexer_prefill.py
@@ -1,26 +1,16 @@
 # SPDX-License-Identifier: Apache-2.0
 """SM80 DeepSeek V4.1 sparse-indexer prefill: tensor-core logits + pruned top-k.
 
-Opt-in with ``VLLM_DSV41_INDEXER_PREFILL_FAST=1`` (default off: the original
-Triton logits + ``top_k_per_row_prefill`` path is untouched).
-
-* ``_dsv41_indexer_C.logits`` reproduces ``fp8_mqa_logits_triton`` inside each
-  row's ``[ks, ke)`` bit for bit (same bf16 operands, same MMA k-order, same
-  relu/weight/head-sum/k_scale tree as the Triton kernel's PTX) but tiles 8
-  query rows per CTA so a K tile is staged in shared memory once and reused,
-  instead of every query row re-reading K from L2/HBM.  The candidate mask
-  (``apply_candidate_mask``) is fused into the epilogue, and tiles without any
-  kept column are skipped.  It also emits, per 32-column chunk, the maximum
-  order-preserving key.
-* ``_dsv41_indexer_C.topk`` returns exactly the top-k set over ``[ks, ke)``
-  (lowest column wins exact ties, output sorted by column, relative to ks;
-  short rows give ``0..L-1`` then ``-1`` like ``top_k_per_row_prefill``).  It
-  only touches chunks whose max can reach the k-th largest value.
-
-Columns outside ``[ks, ke)`` are not written (the original fills them with
--inf; nothing downstream reads them).  No host synchronisation, no persistent
-state beyond a 256-entry decode table created at first use (outside capture);
-deterministic.
+Opt-in switches (all default to ``"0"``, keeping original behavior unchanged):
+* ``VLLM_DSV41_INDEXER_PREFILL_FAST=1``: tensor-core MQA logits + pruned radix top-k.
+* ``VLLM_DSV41_INDEXER_WRITER_FAST=1``: branch-free fused 8-column NaN-propagating
+  block keys inside the logits epilogue + 512-thread register-resident exact
+  radix top-2048 candidate block selection, eliminating the 1.9 GB FP32 logits
+  re-read and ``torch.topk``. Set ``VLLM_DSV41_INDEXER_WRITER_SORT=1`` (default
+  ``"0"``) to also sort candidate blocks in descending ``(score, -block)`` order.
+* ``VLLM_DSV41_INDEXER_READER_COMPACT=1``: per-row active 8-key candidate block
+  compaction + cp.async gathered tensor-core logits + compact pruned top-k
+  (enabled for ``N >= 32768``, where it beats the uncompacted reader up to 2.74x).
 """
 
 from __future__ import annotations
@@ -33,12 +23,86 @@ _OPS = None
 _LUT: dict[torch.device, torch.Tensor] = {}
 CHUNK = 32
 KEYS_PER_CTA = int(os.environ.get("VLLM_DSV41_INDEXER_KEYS_PER_CTA", "2048"))
+READER_GROUPS_PER_CTA = int(os.environ.get("VLLM_DSV41_INDEXER_READER_GPC", "128"))
+READER_MIN_N = int(os.environ.get("VLLM_DSV41_INDEXER_READER_MIN_N", "32768"))
 
 
 def enabled() -> bool:
     return os.environ.get("VLLM_DSV41_INDEXER_PREFILL_FAST", "0") == "1"
 
 
+def writer_fast_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_INDEXER_WRITER_FAST", "0") == "1"
+
+
+def writer_sort_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_INDEXER_WRITER_SORT", "0") == "1"
+
+
+def reader_compact_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_INDEXER_READER_COMPACT", "0") == "1"
+
+
+def any_enabled() -> bool:
+    return enabled() or writer_fast_enabled() or reader_compact_enabled()
+
+
+def reader_compact_eligible(
+    width: int,
+    candidate_blocks: torch.Tensor | None,
+    candidate_block_size: int,
+    candidate_write: bool,
+) -> bool:
+    return (
+        candidate_blocks is not None
+        and not candidate_write
+        and reader_compact_enabled()
+        and candidate_block_size == 8
+        and width >= READER_MIN_N
+        and ((width + 7) // 8 + 1) <= 65536
+    )
+
+
+def writer_fast_eligible(
+    candidate_blocks: torch.Tensor | None,
+    candidate_block_size: int,
+    candidate_write: bool,
+) -> bool:
+    return (
+        candidate_blocks is not None
+        and candidate_write
+        and writer_fast_enabled()
+        and candidate_block_size == 8
+        and 0 < candidate_blocks.shape[1] <= 2048
+    )
+
+
+def layer_enabled(
+    width: int,
+    candidate_blocks: torch.Tensor | None = None,
+    candidate_block_size: int = 0,
+    candidate_write: bool = False,
+) -> bool:
+    if enabled():
+        return True
+    if writer_fast_eligible(candidate_blocks, candidate_block_size, candidate_write):
+        return True
+    return reader_compact_eligible(width, candidate_blocks, candidate_block_size, candidate_write)
+
+
+def fits_workspace(
+    rows: int,
+    width: int,
+    workspace_numel: int,
+    candidate_blocks: torch.Tensor | None = None,
+    candidate_block_size: int = 0,
+    candidate_write: bool = False,
+) -> bool:
+    if reader_compact_eligible(width, candidate_blocks, candidate_block_size, candidate_write):
+        return True
+    return rows * width <= workspace_numel
+
+
 def ops():
     global _OPS
     if _OPS is None:
@@ -156,6 +220,94 @@ def logits(
     return mx
 
 
+def logits_writer(
+    q_bf16: torch.Tensor,
+    k_bf16: torch.Tensor,
+    k_scale: torch.Tensor,
+    weights: torch.Tensor,
+    ks: torch.Tensor,
+    ke: torch.Tensor,
+    out: torch.Tensor,
+    block_size: int = 8,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Fill ``out[:, :N]``, chunk-max keys ``mx``, and 8-col block keys ``bkeys``."""
+    R, N = q_bf16.shape[0], k_bf16.shape[0]
+    nblocks = max(1, (N + block_size - 1) // block_size)
+    mx = torch.empty((R, (N + CHUNK - 1) // CHUNK), dtype=torch.int32, device=q_bf16.device)
+    bkeys = torch.empty((R, nblocks), dtype=torch.int32, device=q_bf16.device)
+    ops().logits_writer(
+        q_bf16, k_bf16, k_scale.reshape(-1), weights, ks, ke, out, mx, bkeys, block_size, KEYS_PER_CTA
+    )
+    return mx, bkeys
+
+
+def cand_topk(
+    logits_: torch.Tensor,
+    bkeys: torch.Tensor,
+    ks: torch.Tensor,
+    ke: torch.Tensor,
+    out: torch.Tensor,
+    width: int,
+    block_size: int = 8,
+    topk_blocks: int | None = None,
+    bkeys_all_rows: bool = False,
+    sort_order: bool = False,
+) -> None:
+    if topk_blocks is None:
+        topk_blocks = out.shape[1]
+    ops().cand_topk(logits_, bkeys, ks, ke, out, width, block_size, topk_blocks, bkeys_all_rows, sort_order)
+
+
+def reader_compact(
+    q_bf16: torch.Tensor,
+    k_bf16: torch.Tensor,
+    k_scale: torch.Tensor,
+    weights: torch.Tensor,
+    ks: torch.Tensor,
+    ke: torch.Tensor,
+    candidate_blocks: torch.Tensor,
+    topk_out: torch.Tensor,
+    topk_tokens: int,
+    logits_workspace: torch.Tensor | None = None,
+    block_size: int = 8,
+    groups_per_cta: int | None = None,
+    full_out: torch.Tensor | None = None,
+) -> None:
+    R, N = q_bf16.shape[0], k_bf16.shape[0]
+    nblocks = (N + block_size - 1) // block_size
+    K_cand = candidate_blocks.shape[1]
+    max_groups = (min(K_cand, nblocks) + 1 + 3) // 4
+    max_blks = max_groups * 4
+    comp_cols = max(32, max_groups * 32)
+    if logits_workspace is not None and logits_workspace.numel() >= R * comp_cols:
+        comp_logits = logits_workspace.view(-1)[: R * comp_cols].view(R, comp_cols)
+    else:
+        comp_logits = torch.empty((R, comp_cols), dtype=torch.float32, device=q_bf16.device)
+    comp_mx = torch.empty((R, max(1, max_groups)), dtype=torch.int32, device=q_bf16.device)
+    comp_blks = torch.empty((R, max(4, max_blks)), dtype=torch.int32, device=q_bf16.device)
+    comp_ngroups = torch.empty((R,), dtype=torch.int32, device=q_bf16.device)
+    gpc = READER_GROUPS_PER_CTA if groups_per_cta is None else groups_per_cta
+    ops().reader_compact(
+        q_bf16,
+        k_bf16,
+        k_scale.reshape(-1),
+        weights,
+        ks,
+        ke,
+        candidate_blocks,
+        comp_logits,
+        comp_mx,
+        comp_blks,
+        comp_ngroups,
+        topk_out,
+        topk_tokens,
+        block_size,
+        gpc,
+        0,
+        full_out,
+    )
+
+
 def topk(
     logits_: torch.Tensor,
     mx: torch.Tensor,
@@ -192,15 +344,52 @@ def indexer_prefill_topk(
 ) -> torch.Tensor | None:
     """One prefill metadata chunk. Writes ``topk_out[R, topk_tokens]``.
 
-    Returns the logits view (needed only by the candidate writer) or None.
+    Returns the logits view or None (when compact reader skips full logits).
     """
     R, N = q_fp8.shape[0], k_fp8.shape[0]
     ks = ks.contiguous()
     ke = ke.contiguous()
-    lg = logits_workspace.view(-1)[: R * N].view(R, N)
     if k_bf16 is None:
         k_bf16 = decode_fp8(k_fp8)
     q_bf16 = decode_fp8(q_fp8)
+
+    if reader_compact_eligible(N, candidate_blocks, candidate_block_size, candidate_write):
+        assert candidate_blocks is not None
+        reader_compact(
+            q_bf16,
+            k_bf16,
+            k_scale,
+            weights,
+            ks,
+            ke,
+            candidate_blocks,
+            topk_out,
+            topk_tokens,
+            logits_workspace=logits_workspace,
+            block_size=candidate_block_size,
+        )
+        return None
+
+    lg = logits_workspace.view(-1)[: R * N].view(R, N)
+
+    if writer_fast_eligible(candidate_blocks, candidate_block_size, candidate_write):
+        assert candidate_blocks is not None
+        mx, bkeys = logits_writer(q_bf16, k_bf16, k_scale, weights, ks, ke, lg, candidate_block_size)
+        cand_topk(
+            lg,
+            bkeys,
+            ks,
+            ke,
+            candidate_blocks,
+            N,
+            candidate_block_size,
+            candidate_blocks.shape[1],
+            False,
+            writer_sort_enabled(),
+        )
+        topk(lg, mx, ks, ke, topk_out, topk_tokens)
+        return lg
+
     flags = None
     if candidate_blocks is not None and not candidate_write:
         flags = candidate_flags(ks, candidate_blocks, N, candidate_block_size)
diff --git a/vllm/v1/attention/ops/rocm_aiter_mla_sparse.py b/vllm/v1/attention/ops/rocm_aiter_mla_sparse.py
index dbd3149..f554fb0 100644
--- a/vllm/v1/attention/ops/rocm_aiter_mla_sparse.py
+++ b/vllm/v1/attention/ops/rocm_aiter_mla_sparse.py
@@ -3093,20 +3093,27 @@ def _rocm_sparse_attn_prefill_ragged_triton(
     block_d = triton.next_power_of_2(head_dim)
     block_k = _prefill_block_k(head_dim)
     num_warps = 4
-    # PP6/TP1: reuse gathered rows across all 64 heads, preserving BLOCK_K=32
-    # and the incumbent per-head arithmetic (bitwise checked on sm80).
+    stage_kwargs: dict[str, int] = {}
+    exact_tile_override = False
+    # PP6/TP1 on sm80: 32H (warps=4, stages=2, exact_tile=True, 0 spills) beats
+    # both 16H and 64H across all M >= 20 while keeping BLOCK_K=32 and per-head
+    # online softmax bit-for-bit identical; M < 20 keeps 16H (single wave on
+    # CMP 170HX's 74 SMs) with exact_tile=True.
     if (os.getenv("VLLM_DSV41_SPARSE_PREFILL_64H", "0") == "1"
             and current_platform.is_cuda()
             and torch.cuda.get_device_capability(q.device) == (8, 0)
-            and 512 <= num_queries <= 4096 and num_heads == 64
+            and num_queries >= 1 and num_heads == 64
             and head_dim == 512 and nope_head_dim == 448 and rope_head_dim == 64
             and q.dtype == kv.dtype == torch.bfloat16 and block_k == 32):
-        block_h, num_warps = 64, 8
+        exact_tile_override = True
+        if num_queries >= 20:
+            block_h, num_warps = 32, 4
+            stage_kwargs = {"num_stages": 2}
     # When the tile covers the data exactly, every head/dim mask in the kernel
     # is all-true and buys nothing but predication on its hottest instructions.
     # Specialize rather than delete: ranks whose head count is not the tile
     # width (num_heads=4 at TP=16) and non-power-of-2 head dims still need them.
-    exact_tile = (
+    exact_tile = exact_tile_override or (
         envs.VLLM_SPARSE_PREFILL_EXACT_TILE
         and num_heads == block_h
         and head_dim == block_d
@@ -3137,6 +3144,7 @@ def _rocm_sparse_attn_prefill_ragged_triton(
         BLOCK_K=block_k,
         EXACT_TILE=exact_tile,
         num_warps=num_warps,
+        **stage_kwargs,
     )
     return out
 
-- 
