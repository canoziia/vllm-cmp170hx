+def _fused_act() -> bool:
+    return os.environ.get("VLLM_DSV4_MXFP4_FUSED_ACT", "0") == "1"
+
+
+def _fused_sum() -> bool:
+    return os.environ.get("VLLM_DSV4_MXFP4_FUSED_SUM", "0") == "1"
