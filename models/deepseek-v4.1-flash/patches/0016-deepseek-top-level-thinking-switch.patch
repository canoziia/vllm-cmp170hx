From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] deepseek-v4/v4.1: honour the top-level thinking {type} request
 switch

DeepSeek API clients turn thinking off with "thinking": {"type": "disabled"}
at the top level of a chat request. vLLM kept the field in model_extra and
ignored it, so the DeepSeek tokenizers and output parsers stayed in thinking
mode.

One shared implementation for DeepseekV4ForCausalLM,
DeepseekV4ForConditionalGeneration and DeepseekV41ForCausalLM (the V4-Flash
image stacks its series on the V4.1 series; this replaces V4-Flash 0013). The
chat serving copies thinking.type into chat_template_kwargs.thinking and
.enable_thinking (enabled -> true, disabled -> false) before the parser and the
renderer read the kwargs. Explicit chat_template_kwargs.thinking /
enable_thinking win; any other value returns 400. Both keys are set because
build_chat_params derives enable_thinking from reasoning_effort unless present.
---
diff --git a/vllm/entrypoints/openai/chat_completion/deepseek_thinking.py b/vllm/entrypoints/openai/chat_completion/deepseek_thinking.py
new file mode 100644
index 0000000..fd636ee
--- /dev/null
+++ b/vllm/entrypoints/openai/chat_completion/deepseek_thinking.py
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DeepSeek V4 / V4.1 request-level ``thinking`` switch (DeepSeek API format).
+
+DeepSeek's API takes ``"thinking": {"type": "enabled" | "disabled"}`` at the
+top level of a chat request. vLLM keeps unknown top-level fields in
+``model_extra`` and otherwise ignores them, so the DeepSeek tokenizers and
+output parsers (which read ``chat_template_kwargs``) fell back to thinking mode.
+
+One shared implementation for every DeepSeek architecture listed in
+``DEEPSEEK_THINKING_ARCHITECTURES`` (the V4-Flash image stacks its series on
+the V4.1 series, so both models use this file). The switch is copied into
+``chat_template_kwargs["thinking"]`` once, before the parser and the renderer
+read the kwargs, so both see the same value (and a PD prefill/decode pair
+renders the same prompt). An explicit ``chat_template_kwargs.thinking`` /
+``enable_thinking`` wins.
+"""
+
+from typing import Any
+
+# V4: Vision-Exp checkpoints declare DeepseekV4ForCausalLM and resolve to
+# DeepseekV4ForConditionalGeneration. V4.1: DeepseekV41ForCausalLM (declared
+# and resolved).
+DEEPSEEK_THINKING_ARCHITECTURES = frozenset(
+    {
+        "DeepseekV4ForCausalLM",
+        "DeepseekV4ForConditionalGeneration",
+        "DeepseekV41ForCausalLM",
+    }
+)
+_TYPES = {"enabled": True, "disabled": False}
+
+
+def is_deepseek_thinking_model(architectures: Any) -> bool:
+    return any(a in DEEPSEEK_THINKING_ARCHITECTURES for a in (architectures or ()))
+
+
+def apply_deepseek_thinking(request: Any, architectures: Any) -> str | None:
+    """Fold a top-level ``thinking`` into ``chat_template_kwargs``.
+
+    Returns an error message for an invalid value, otherwise None. Requests
+    for other architectures, or without a top-level ``thinking``, are not
+    modified.
+    """
+    if not is_deepseek_thinking_model(architectures):
+        return None
+    extra = getattr(request, "model_extra", None) or {}
+    if "thinking" not in extra:
+        return None
+    value = extra["thinking"]
+    kind = value.get("type") if isinstance(value, dict) else None
+    if kind not in _TYPES:
+        return (
+            "'thinking' must be an object {\"type\": \"enabled\"} or "
+            f"{{\"type\": \"disabled\"}}; got {value!r}"
+        )
+    kwargs = dict(request.chat_template_kwargs or {})
+    if "thinking" not in kwargs and "enable_thinking" not in kwargs:
+        # both keys: build_chat_params derives enable_thinking from
+        # reasoning_effort unless it is present, and the tokenizers OR them
+        kwargs["thinking"] = kwargs["enable_thinking"] = _TYPES[kind]
+        request.chat_template_kwargs = kwargs
+    return None
diff --git a/vllm/entrypoints/openai/chat_completion/serving.py b/vllm/entrypoints/openai/chat_completion/serving.py
index 06e7315..62659fb 100644
--- a/vllm/entrypoints/openai/chat_completion/serving.py
+++ b/vllm/entrypoints/openai/chat_completion/serving.py
@@ -42,6 +42,9 @@ from vllm.entrypoints.openai.chat_completion.protocol import (
     ChatCompletionStreamResponse,
     ChatMessage,
 )
+from vllm.entrypoints.openai.chat_completion.deepseek_thinking import (
+    apply_deepseek_thinking,
+)
 from vllm.entrypoints.openai.models.serving import OpenAIServingModels
 from vllm.entrypoints.serve.engine.protocol import (
     CompletionTokenUsageInfo,
@@ -263,6 +266,17 @@ class OpenAIServingChat(GenerateBaseServing):
         # Streaming response
         tokenizer = self.renderer.tokenizer
         assert tokenizer is not None
+        # DeepSeek V4 / V4.1: top-level thinking {type} -> chat_template_kwargs,
+        # before the parser and the renderer read them
+        thinking_error = apply_deepseek_thinking(
+            request,
+            [
+                *(getattr(self.model_config, "architectures", None) or ()),
+                *(getattr(self.model_config.hf_config, "architectures", None) or ()),
+            ],
+        )
+        if thinking_error is not None:
+            return self.create_error_response(thinking_error, param="thinking")
         chat_template_kwargs = self._effective_chat_template_kwargs(request)
         parser: Parser | None = None
         if self.parser_cls is not None:
