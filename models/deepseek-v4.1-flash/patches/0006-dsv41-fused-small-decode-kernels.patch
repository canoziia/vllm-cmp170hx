+        # VLLM_DSV41_INDEXER_Q_LUT_FUSED: one gather launch instead of the
+        # uint8->int32 cast + index_select pair; same table, same bits.
+        q_in = paged_q_lut_decode(q_byte, fp8_lut)
+    elif q_is_bf16:
