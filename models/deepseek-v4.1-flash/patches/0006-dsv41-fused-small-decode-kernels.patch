-from vllm.models.deepseek_v4_1.attention import DeepseekV4Attention
+from vllm.models.deepseek_v4_1.attention import DeepseekV4Attention, topk_epoch
 from vllm.models.deepseek_v4_1.common.ops import dequantize_and_gather_k_cache
 from vllm.models.deepseek_v4_1.sparse_mla import (
     DeepseekV4FlashMLAMetadata,
@@ -363,6 +364,247 @@ def compute_global_topk_ragged_indices_and_indptr(
     return global_topk_ragged, topk_indptr, topk_lens
 
 
+# ---------------------------------------------------------------------------
+# VLLM_DSV41_TOPK_RAGGED_FUSED / VLLM_DSV41_TOPK_RAGGED_REUSE
+# ---------------------------------------------------------------------------
+
+
+@functools.cache
+def _topk_ragged_fused_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_TOPK_RAGGED_FUSED", "0") == "1"
+
+
+@functools.cache
+def _topk_ragged_reuse_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_TOPK_RAGGED_REUSE", "0") == "1"
+
+
+# Above this many decode rows the per-program recount (O(rows^2 * topk) L2
+# reads) stops paying; fall back to the 3-kernel chain.
+_FUSED_TOPK_RAGGED_MAX_ROWS = 256
+
+
+@triton.jit
+def _fused_topk_ragged_kernel(
+    global_topk_ragged_ptr,
+    topk_indptr_ptr,
+    topk_lens_ptr,
+    topk_indices_ptr,
+    topk_indices_stride,
+    token_to_req_indices_ptr,
+    block_table_ptr,
+    block_table_stride,
+    is_valid_token_ptr,
+    block_size,
+    topk,
+    num_tokens,
+    BLOCK_TOPK: tl.constexpr,
+    ROWS: tl.constexpr,
+):
+    """compute_topk_lens + exclusive scan + pack_global_topk_ragged, 1 launch.
+
+    Program ``t`` recounts the valid entries of rows ``0..t`` (ROWS rows per
+    2-D load) to get its own exclusive prefix, then packs its row exactly as
+    ``_pack_global_topk_ragged_kernel`` does. Integer-only, so indptr / lens
+    / packed slot ids are bit-identical to the unfused chain.
+    """
+    t = tl.program_id(0)
+    cols = tl.arange(0, BLOCK_TOPK)
+    col_mask = cols < topk
+    row_off = tl.arange(0, ROWS)
+
+    prefix = tl.zeros((), dtype=tl.int32)
+    own = tl.zeros((), dtype=tl.int32)
+    for r0 in range(0, t + 1, ROWS):
+        rows = r0 + row_off
+        rmask = rows <= t
+        vals = tl.load(
+            topk_indices_ptr + rows[:, None] * topk_indices_stride + cols[None, :],
+            mask=rmask[:, None] & col_mask[None, :],
+            other=-1,
+        )
+        cnt = tl.sum((vals >= 0).to(tl.int32), axis=1)
+        valid = tl.load(is_valid_token_ptr + rows, mask=rmask, other=0) != 0
+        cnt = tl.where(valid & rmask, cnt, 0)
+        prefix += tl.sum(tl.where(rows < t, cnt, 0), axis=0)
+        own += tl.sum(tl.where(rows == t, cnt, 0), axis=0)
+
+    tl.store(topk_lens_ptr + t, own)
+    tl.store(topk_indptr_ptr + t + 1, prefix + own)
+    if t == 0:
+        tl.store(topk_indptr_ptr, 0)
+
+    # Pack: identical arithmetic to _pack_global_topk_ragged_kernel.
+    if own > 0:
+        req_idx = tl.load(token_to_req_indices_ptr + t)
+        mask = (cols < own) & col_mask
+        local_idx = tl.load(
+            topk_indices_ptr + t * topk_indices_stride + cols,
+            mask=mask,
+            other=-1,
+        )
+        valid_e = mask & (local_idx >= 0)
+        block_indices = local_idx // block_size
+        block_numbers = tl.load(
+            block_table_ptr + req_idx * block_table_stride + block_indices,
+            mask=valid_e,
+            other=0,
+        )
+        block_offsets = local_idx % block_size
+        slot_ids = tl.where(valid_e, block_numbers * block_size + block_offsets, -1)
+        tl.store(global_topk_ragged_ptr + prefix + cols, slot_ids, mask=mask)
+
+
+def fused_global_topk_ragged_indices_and_indptr(
+    topk_indices: torch.Tensor,
+    token_to_req_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    block_size: int,
+    is_valid_token: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Single-launch drop-in for compute_global_topk_ragged_indices_and_indptr.
+
+    Same outputs (dtype, shape, values in every position a reader may touch:
+    ``indptr``, ``lens`` and ``ragged[:indptr[-1]]``).
+    """
+    topk_indices = topk_indices.reshape(topk_indices.shape[0], -1).contiguous()
+    num_tokens = topk_indices.shape[0]
+    topk = topk_indices.shape[1]
+    if (
+        num_tokens == 0
+        or topk == 0
+        or num_tokens > _FUSED_TOPK_RAGGED_MAX_ROWS
+        or topk > 2048
+        or block_table.stride(-1) != 1
+    ):
+        return compute_global_topk_ragged_indices_and_indptr(
+            topk_indices, token_to_req_indices, block_table, block_size,
+            is_valid_token,
+        )
+    device = topk_indices.device
+    topk_lens = torch.empty(num_tokens, dtype=torch.int32, device=device)
+    topk_indptr = torch.empty(num_tokens + 1, dtype=torch.int32, device=device)
+    global_topk_ragged = torch.empty(
+        num_tokens * topk, dtype=torch.int32, device=device
+    )
+    block_topk = triton.next_power_of_2(topk)
+    # Keep the 2-D recount tile at <= 8K int32 (32 per thread at 8 warps).
+    rows = max(1, min(16, 8192 // block_topk))
+    _fused_topk_ragged_kernel[(num_tokens,)](
+        global_topk_ragged,
+        topk_indptr,
+        topk_lens,
+        topk_indices,
+        topk_indices.stride(0),
+        token_to_req_indices,
+        block_table,
+        block_table.stride(0),
+        is_valid_token,
+        block_size,
+        topk,
+        num_tokens,
+        BLOCK_TOPK=block_topk,
+        ROWS=rows,
+        num_warps=8,
+    )
+    return global_topk_ragged, topk_indptr, topk_lens
+
+
+# Cross-layer reuse of the decode topk ragged metadata. Every compressed layer
+# up to the next index source reads the same topk_indices_buffer, the same
+# token->request map / validity mask and (per compressed cache) the same block
+# table, so the packed slot ids are identical; only the first consumer has to
+# build them. ``topk_epoch()`` advances every time an indexer is about to
+# (re)write the topk buffer (Indexer.forward, the eager indexer_op break and
+# shadow-source replays),
+# so an entry can never outlive the buffer contents it was derived from.
+_TOPK_RAGGED_CACHE: dict[tuple, tuple[int, tuple]] = {}
+
+
+def _topk_ragged_cache_key(
+    topk_indices: torch.Tensor,
+    token_to_req_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    block_size: int,
+    is_valid_token: torch.Tensor,
+) -> tuple:
+    def sig(x: torch.Tensor) -> tuple:
+        return (x.data_ptr(), tuple(x.shape), tuple(x.stride()), x.dtype)
+
+    return (
+        sig(topk_indices),
+        sig(token_to_req_indices),
+        sig(block_table),
+        sig(is_valid_token),
+        int(block_size),
+        topk_indices.device,
+    )
+
+
+def decode_global_topk_ragged(
+    topk_indices: torch.Tensor,
+    token_to_req_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    block_size: int,
+    is_valid_token: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Dispatch for the decode topk ragged build (both flags default off)."""
+    build = (
+        fused_global_topk_ragged_indices_and_indptr
+        if _topk_ragged_fused_enabled()
+        else compute_global_topk_ragged_indices_and_indptr
+    )
+    if not _topk_ragged_reuse_enabled():
+        return build(
+            topk_indices, token_to_req_indices, block_table, block_size,
+            is_valid_token,
+        )
+    key = _topk_ragged_cache_key(
+        topk_indices, token_to_req_indices, block_table, block_size,
+        is_valid_token,
+    )
+    hit = _TOPK_RAGGED_CACHE.get(key)
+    epoch = topk_epoch()
+    if hit is not None and hit[0] == epoch:
+        return hit[1]
+    result = build(
+        topk_indices, token_to_req_indices, block_table, block_size,
+        is_valid_token,
+    )
+    if len(_TOPK_RAGGED_CACHE) > 64:
+        _TOPK_RAGGED_CACHE.clear()
+    _TOPK_RAGGED_CACHE[key] = (epoch, result)
+    return result
+
+
+@functools.cache
+def _swa_ragged_inplace_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_SWA_RAGGED_INPLACE", "0") == "1"
+
+
+def _build_ragged_into_graph_buffers(
+    dense_indices: torch.Tensor,
+    lengths: torch.Tensor,
+    ragged_indices_buffer: torch.Tensor,
+    ragged_indptr_buffer: torch.Tensor,
+    num_rows: int,
+    max_entries_per_row: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """VLLM_DSV41_SWA_RAGGED_INPLACE: build straight into the persistent
+    buffers (V4 already does this) instead of build + two DtoD copies.
+    Returns the same views ``_copy_ragged_to_graph_buffers`` returns off
+    gfx950; every value a reader can reach (indptr and the first NNZ
+    indices) is bit-identical."""
+    max_entries = max(num_rows * max_entries_per_row, 1)
+    build_ragged_indices_from_dense(
+        dense_indices,
+        lengths,
+        indices_out=ragged_indices_buffer[:max_entries],
+        indptr_out=ragged_indptr_buffer[: num_rows + 1],
+    )
+    return ragged_indices_buffer[:max_entries], ragged_indptr_buffer[: num_rows + 1]
+
+
 def _copy_ragged_to_graph_buffers(
     ragged_indices: torch.Tensor,
     ragged_indptr: torch.Tensor,
@@ -439,6 +681,22 @@ class DeepseekV4ROCMAiterSparseSWAMetadataBuilder(DeepseekV41SparseSWAMetadataBu
             and base.decode_swa_indices is not None
             and base.decode_swa_lens is not None
         ):
+            if _swa_ragged_inplace_enabled() and not _ON_GFX950:
+                ragged_indices, ragged_indptr = _build_ragged_into_graph_buffers(
+                    base.decode_swa_indices.reshape(
+                        base.num_decode_tokens, base.decode_swa_width
+                    ),
+                    base.decode_swa_lens,
+                    self.decode_swa_ragged_indices_buffer,
+                    self.decode_swa_ragged_indptr_buffer,
+                    base.num_decode_tokens,
+                    base.decode_swa_width,
+                )
+                return DeepseekV4ROCMAiterSparseSWAMetadata(
+                    **vars(base),
+                    decode_swa_ragged_indices=ragged_indices,
+                    decode_swa_ragged_indptr=ragged_indptr,
+                )
             ragged_indices, ragged_indptr = build_ragged_indices_from_dense(
                 base.decode_swa_indices.reshape(
                     base.num_decode_tokens, base.decode_swa_width
@@ -757,7 +1015,7 @@ class DeepseekV41ROCMAiterMLAAttention(DeepseekV4Attention):
                 topk_ragged_indices,
                 topk_ragged_indptr,
                 topk_lens,
-            ) = compute_global_topk_ragged_indices_and_indptr(
+            ) = decode_global_topk_ragged(
                 self.topk_indices_buffer[:num_decode_tokens],
                 swa_metadata.token_to_req_indices,
                 attn_metadata.block_table[:num_decodes],
