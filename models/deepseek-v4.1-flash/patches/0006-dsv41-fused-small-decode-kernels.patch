@@ -132,6 +132,37 @@ def _get_e4m3fn_bf16_lut(device: torch.device) -> torch.Tensor:
     return get_e4m3fn_bf16_lut(device, nan_value=_INDEXER_LUT_NAN_VALUE)
 
 
+@functools.cache
+def _paged_q_lut_fused_enabled() -> bool:
+    return os.environ.get("VLLM_DSV41_INDEXER_Q_LUT_FUSED", "0") == "1"
+
+
+@triton.jit
+def _paged_q_lut_decode_kernel(src_ptr, lut_ptr, dst_ptr, n, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < n
+    u = tl.load(src_ptr + offs, mask=mask, other=0)
+    v = tl.load(lut_ptr + u.to(tl.int32), mask=mask)
+    tl.store(dst_ptr + offs, v, mask=mask)
+
+
+def paged_q_lut_decode(q_byte: torch.Tensor, lut: torch.Tensor) -> torch.Tensor:
+    """``lut[q_byte]`` (uint8 -> lut.dtype) as a single gather launch.
+
+    Bit-identical to ``lut.index_select(0, q_byte.reshape(-1).to(int32))``.
+    """
+    assert q_byte.dtype == torch.uint8 and q_byte.is_contiguous()
+    assert lut.numel() == 256 and lut.is_contiguous()
+    out = torch.empty(q_byte.shape, dtype=lut.dtype, device=q_byte.device)
+    n = q_byte.numel()
+    if n:
+        block = 1024
+        _paged_q_lut_decode_kernel[(triton.cdiv(n, block),)](
+            q_byte, lut, out, n, BLOCK=block, num_warps=4
+        )
+    return out
+
+
 @triton.jit
 def _decode_e4m3fn_bf16_lut(u, lut_ptr):
     return tl.load(lut_ptr + u.to(tl.uint32))
