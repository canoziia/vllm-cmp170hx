From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] deepseek: weight-streaming MXFP4 MoE decode kernels

VLLM_DSV4_MXFP4_DECODE (default 0 = unchanged). For decode batches of at most
VLLM_DSV4_MXFP4_DECODE_MAX_TOKENS (64) tokens, fused_marlin_moe runs the two
expert GEMMs with the _dsv4_moe_C kernels (native/dsv4_moe, compiled into the
image as vllm/_dsv4_moe_C.abi3.so) instead of moe_wna16_marlin_gemm. They
read the same Marlin-packed MXFP4 weights and e8m0 scales, dequantise them
exactly (layers with an e8m0 scale above 128 keep Marlin), stream weights
through a per-lane cp.async ring with tokens as the mma N dimension, and
split w13 over K into fixed-order fp32 partials. The activation is the
caller's own activation_func on the bf16 w13 result and the slot sum stays
moe_sum; only the fp32 accumulation order differs from Marlin.

diff --git a/vllm/model_executor/layers/fused_moe/dsv4_mxfp4_decode.py b/vllm/model_executor/layers/fused_moe/dsv4_mxfp4_decode.py
new file mode 100644
index 0000000..fee5473
--- /dev/null
+++ b/vllm/model_executor/layers/fused_moe/dsv4_mxfp4_decode.py
@@ -0,0 +1,157 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Weight-streaming MXFP4 MoE decode for DeepSeek V4.1 Flash on sm_80.
+
+VLLM_DSV4_MXFP4_DECODE=1 (default 0 = unchanged). For small decode batches,
+replaces the two ``moe_wna16_marlin_gemm`` calls of ``fused_marlin_moe`` with
+the ``_dsv4_moe_C`` kernels (built from models/deepseek-v4.1-flash/native),
+which read the same Marlin-packed MXFP4 weights and e8m0 scales. The weights
+are dequantised exactly; only the fp32 accumulation order differs from
+Marlin. The activation is the caller's own ``activation_func`` on the bf16
+w13 result (same op as the Marlin path) and the slot sum stays
+``moe_sum``.
+
+Eligible calls: sm_80, bf16 activations, float4_e2m1f weights, no bias /
+zero points / global scales / expert map / 8-bit activations, router weight
+applied on the output, block-8 alignment, at most
+VLLM_DSV4_MXFP4_DECODE_MAX_TOKENS (default 64) tokens, the compiled shapes
+(hidden 5120, intermediate 2304), and every e8m0 scale of the layer <= 128
+(checked once per weight tensor outside CUDA-graph capture). Anything else
+uses the unchanged Marlin path.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_K, _NI = 5120, 2304
+_OPS = None
+_LOAD_ERROR: str | None = None
+_SCALE_OK: dict[int, bool] = {}
+_CTR: dict[tuple, torch.Tensor] = {}
+_LOGGED = False
+
+
+def enabled() -> bool:
+    return os.environ.get("VLLM_DSV4_MXFP4_DECODE", "0") == "1"
+
+
+def _max_tokens() -> int:
+    return int(os.environ.get("VLLM_DSV4_MXFP4_DECODE_MAX_TOKENS", "64"))
+
+
+def _ops():
+    global _OPS, _LOAD_ERROR
+    if _OPS is not None or _LOAD_ERROR is not None:
+        return _OPS
+    try:
+        path = os.environ.get("VLLM_DSV4_MXFP4_DECODE_LIB")
+        if not path:
+            path = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(
+                os.path.dirname(os.path.abspath(__file__))))), "_dsv4_moe_C.abi3.so")
+        torch.ops.load_library(path)
+        ops = torch.ops._dsv4_moe_C
+        if int(ops.abi()) != 1:
+            raise RuntimeError("unexpected _dsv4_moe_C ABI")
+        _OPS = ops
+    except Exception as e:  # noqa: BLE001
+        _LOAD_ERROR = repr(e)
+        raise RuntimeError(
+            f"VLLM_DSV4_MXFP4_DECODE=1 but _dsv4_moe_C could not be loaded: {e}") from e
+    return _OPS
+
+
+def _scales_ok(s: torch.Tensor) -> bool | None:
+    key = s.data_ptr()
+    ok = _SCALE_OK.get(key)
+    if ok is None:
+        if torch.cuda.is_current_stream_capturing():
+            return None
+        ok = int(s.view(torch.uint8).max().item()) <= 128
+        _SCALE_OK[key] = ok
+        if not ok:
+            logger.warning("VLLM_DSV4_MXFP4_DECODE: a layer has e8m0 scales > 128; "
+                           "it keeps the Marlin path")
+    return ok
+
+
+def _counters(dev: torch.device) -> torch.Tensor | None:
+    key = (str(dev), torch.cuda.current_stream(dev).cuda_stream)
+    ctr = _CTR.get(key)
+    if ctr is None:
+        if torch.cuda.is_current_stream_capturing():
+            return None
+        ctr = torch.zeros(2, dtype=torch.int32, device=dev)
+        _CTR[key] = ctr
+    return ctr
+
+
+def try_run(*, hidden_states, w1, w2, w1_scale, w2_scale, topk_weights, topk_ids,
+            quant_type, bias1, bias2, global_scale1, global_scale2,
+            input_global_scale1, input_global_scale2, w1_zeros, w2_zeros,
+            expert_map, apply_router_weight_on_input, block_size_m, input_dtype,
+            activation, activation_func, activation_config,
+            sorted_token_ids, expert_ids, num_tokens_post_padded,
+            intermediate_cache13, intermediate_cache2):
+    """Return the [M*topk, K] w2 output, or None to keep the Marlin path."""
+    from vllm.scalar_type import scalar_types
+
+    M, K = hidden_states.shape
+    topk = topk_ids.size(1)
+    if (quant_type != scalar_types.float4_e2m1f or K != _K or w2.size(1) * 16 != _NI
+            or M > _max_tokens() or block_size_m != 8
+            or hidden_states.dtype != torch.bfloat16 or not hidden_states.is_cuda
+            or input_dtype is not None or apply_router_weight_on_input
+            or expert_map is not None
+            or any(t is not None for t in (bias1, bias2, global_scale1, global_scale2,
+                                           input_global_scale1, input_global_scale2,
+                                           w1_zeros, w2_zeros))
+            or not activation.is_gated
+            or w1_scale.element_size() != 1 or w2_scale.element_size() != 1
+            or torch.cuda.get_device_capability(hidden_states.device) != (8, 0)):
+        return None
+    ops = _ops()
+    if not (_scales_ok(w1_scale) and _scales_ok(w2_scale)):
+        return None
+    slots = M * topk
+    ctr = _counters(hidden_states.device)
+    if ctr is None:
+        return None
+    if (intermediate_cache13.numel() < slots * max(2 * _NI, _K)
+            or intermediate_cache2.numel() < slots * _NI
+            or not intermediate_cache13.is_contiguous()
+            or not intermediate_cache2.is_contiguous()):
+        return None
+    global _LOGGED
+    if not _LOGGED:
+        _LOGGED = True
+        logger.info("VLLM_DSV4_MXFP4_DECODE: weight-streaming MXFP4 MoE decode active "
+                    "(<= %d tokens)", _max_tokens())
+    dev = hidden_states.device
+    cfg = 2 if M <= 6 else 5
+    part = torch.empty(4 * slots * 2 * _NI, dtype=torch.float32, device=dev)
+    act_in = intermediate_cache13.reshape(-1)[: slots * 2 * _NI].view(slots, 2 * _NI)
+    h = intermediate_cache2.reshape(-1)[: slots * _NI].view(slots, _NI)
+    tw = topk_weights.view(-1)
+    ks = ops.gemm(hidden_states, w1, w1_scale.view(torch.uint8), sorted_token_ids,
+                  expert_ids, num_tokens_post_padded, tw, topk, slots, _K, 2 * _NI, True,
+                  cfg, ctr, part)
+    ops.sum(part, ks, slots, 2 * _NI, act_in)
+    if activation_func is None:
+        from vllm.model_executor.layers.fused_moe.activation import (
+            ApplyMoEActivationConfig, apply_moe_activation)
+        apply_moe_activation(activation, h, act_in,
+                             activation_config=activation_config or ApplyMoEActivationConfig(),
+                             topk_ids=topk_ids, expert_map=None)
+    else:
+        activation_func(activation, h, act_in, topk_ids=topk_ids, expert_map=None)
+    out = intermediate_cache13.reshape(-1)[: slots * _K].view(slots, _K)
+    ops.gemm(h, w2, w2_scale.view(torch.uint8), sorted_token_ids, expert_ids,
+             num_tokens_post_padded, tw, topk, slots, _NI, _K, False, cfg, ctr, out)
+    return out
diff --git a/vllm/model_executor/layers/fused_moe/experts/marlin_moe.py b/vllm/model_executor/layers/fused_moe/experts/marlin_moe.py
