@@ -24,6 +24,7 @@ from vllm.model_executor.layers.fused_moe.config import (
 from vllm.model_executor.layers.fused_moe.experts.lora_experts_mixin import (
     LoRAExpertsMixin,
 )
+from vllm.model_executor.layers.fused_moe import dsv4_mxfp4_decode as _dsv4_mxfp4_decode
 from vllm.model_executor.layers.fused_moe.moe_align_block_size import (
     batched_moe_align_block_size,
     moe_align_block_size,
@@ -325,39 +326,70 @@ def fused_marlin_moe(
     )
 
     assert activation is not None
-    moe_output = _fused_marlin_moe(
-        hidden_states=hidden_states,
-        w1=w1,
-        w2=w2,
-        bias1=bias1,
-        bias2=bias2,
-        w1_scale=w1_scale,
-        w2_scale=w2_scale,
-        topk_weights=topk_weights,
-        topk_ids=topk_ids,
-        num_topk=topk,
-        quant_type=quant_type,
-        apply_router_weight_on_input=apply_router_weight_on_input,
-        expert_map=expert_map,
-        block_size_m=block_size_m,
-        sorted_token_ids=sorted_token_ids,
-        expert_ids=expert_ids,
-        num_tokens_post_padded=num_tokens_post_padded,
-        activation=activation,
-        activation_func=activation_func,
-        activation_config=activation_config,
-        input_global_scale1=input_global_scale1,
-        input_global_scale2=input_global_scale2,
-        global_scale1=global_scale1,
-        global_scale2=global_scale2,
-        w1_zeros=w1_zeros,
-        w2_zeros=w2_zeros,
-        workspace=workspace,
-        intermediate_cache13=intermediate_cache13,
-        intermediate_cache2=intermediate_cache2,
-        output=None,
-        input_dtype=input_dtype,
-    ).view(-1, topk, K)
+    moe_output = None
+    if _dsv4_mxfp4_decode.enabled():
+        # VLLM_DSV4_MXFP4_DECODE: weight-streaming MXFP4 decode kernels for
+        # eligible small batches; None keeps the Marlin path below.
+        if intermediate_cache13 is None:
+            intermediate_cache13 = torch.empty(
+                (hidden_states.size(0) * topk * max(2 * w2.size(1) * 16, K),),
+                device=hidden_states.device, dtype=hidden_states.dtype)
+        if intermediate_cache2 is None:
+            intermediate_cache2 = torch.empty(
+                (hidden_states.size(0) * topk * w2.size(1) * 16,),
+                device=hidden_states.device, dtype=hidden_states.dtype)
+        moe_output = _dsv4_mxfp4_decode.try_run(
+            hidden_states=hidden_states, w1=w1, w2=w2, w1_scale=w1_scale,
+            w2_scale=w2_scale, topk_weights=topk_weights, topk_ids=topk_ids,
+            quant_type=quant_type, bias1=bias1, bias2=bias2,
+            global_scale1=global_scale1, global_scale2=global_scale2,
+            input_global_scale1=input_global_scale1,
+            input_global_scale2=input_global_scale2, w1_zeros=w1_zeros,
+            w2_zeros=w2_zeros, expert_map=expert_map,
+            apply_router_weight_on_input=apply_router_weight_on_input,
+            block_size_m=block_size_m, input_dtype=input_dtype,
+            activation=activation, activation_func=activation_func,
+            activation_config=activation_config,
+            sorted_token_ids=sorted_token_ids, expert_ids=expert_ids,
+            num_tokens_post_padded=num_tokens_post_padded,
+            intermediate_cache13=intermediate_cache13,
+            intermediate_cache2=intermediate_cache2)
+        if moe_output is not None:
+            moe_output = moe_output.view(-1, topk, K)
+    if moe_output is None:
+        moe_output = _fused_marlin_moe(
+            hidden_states=hidden_states,
+            w1=w1,
+            w2=w2,
+            bias1=bias1,
+            bias2=bias2,
+            w1_scale=w1_scale,
+            w2_scale=w2_scale,
+            topk_weights=topk_weights,
+            topk_ids=topk_ids,
+            num_topk=topk,
+            quant_type=quant_type,
+            apply_router_weight_on_input=apply_router_weight_on_input,
+            expert_map=expert_map,
+            block_size_m=block_size_m,
+            sorted_token_ids=sorted_token_ids,
+            expert_ids=expert_ids,
+            num_tokens_post_padded=num_tokens_post_padded,
+            activation=activation,
+            activation_func=activation_func,
+            activation_config=activation_config,
+            input_global_scale1=input_global_scale1,
+            input_global_scale2=input_global_scale2,
+            global_scale1=global_scale1,
+            global_scale2=global_scale2,
+            w1_zeros=w1_zeros,
+            w2_zeros=w2_zeros,
+            workspace=workspace,
+            intermediate_cache13=intermediate_cache13,
+            intermediate_cache2=intermediate_cache2,
+            output=None,
+            input_dtype=input_dtype,
+        ).view(-1, topk, K)
 
     if output is None:
         output = torch.empty_like(hidden_states)
