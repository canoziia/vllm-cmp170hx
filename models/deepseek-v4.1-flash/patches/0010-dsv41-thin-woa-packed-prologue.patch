diff --git a/vllm/v1/worker/gpu/prologue_packed.py b/vllm/v1/worker/gpu/prologue_packed.py
new file mode 100644
index 0000000..bdfecfb
--- /dev/null
+++ b/vllm/v1/worker/gpu/prologue_packed.py
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Decode-only packed H2D + input-preparation kernel (default off).
+
+Fresh pinned allocation uses PyTorch's event-tracked caching host allocator.
+Fresh device views retain per-step lifetime for delayed PP readers. No global
+workspace and no host reads from GPU. Persistent graph inputs keep addresses.
+The host preparation runs OUTSIDE model graphs; the kernel is capturable.
+"""
+import functools
+import os
+
+import numpy as np
+import torch
+import triton
+import triton.language as tl
+
+
+@functools.cache
+def enabled():
+    return os.getenv('VLLM_DSV41_PACKED_PROLOGUE', '0') == '1'
+
+
+def upload(idx, cu, query, device):
+    # Segments stay naturally aligned for dtype views. No widening of payload.
+    arrays = [np.ascontiguousarray(a) for a in (idx, cu, query)]
+    offsets, size = [], 0
+    for a in arrays:
+        offsets.append(size)
+        size += (a.nbytes + 15) // 16 * 16
+    host = torch.empty(size, dtype=torch.uint8, pin_memory=True)
+    hn = host.numpy()
+    for a, off in zip(arrays, offsets):
+        hn[off:off+a.nbytes] = a.view(np.uint8)
+    dev = torch.empty(size, dtype=torch.uint8, device=device)
+    dev.copy_(host, non_blocking=True)
+    return tuple(dev[off:off+a.nbytes].view(torch.from_numpy(a).dtype)
+                 for a, off in zip(arrays, offsets))
+
+
+@triton.jit
+def unpack_prepare(I, C, Q, Qout, Computed, Prefill, Last, Draft,
+                   Pos, Seq, Ids, EI, EL, LI,
+                   NR: tl.constexpr, CAP: tl.constexpr,
+                   DS: tl.constexpr, BLOCK: tl.constexpr):
+    r = tl.program_id(0)
+    j = tl.arange(0, BLOCK)
+    if r == NR:
+        # Tail query_start_loc must remain nondecreasing; seq padding = 0.
+        for s in range(NR, CAP + 1, BLOCK):
+            off = s + j
+            q = tl.load(Q + off, off <= CAP, 0)
+            tl.store(Qout + off, q, off <= CAP)
+            tl.store(Seq + off, 0, off < CAP)
+    else:
+        state = tl.load(I + r)
+        start = tl.load(Q + r)
+        end = tl.load(Q + r + 1)
+        cstart = tl.load(C + r)
+        cend = tl.load(C + r + 1)
+        count = cend - cstart
+        computed = tl.load(Computed + state)
+        seq = computed + end - start
+        prefill = tl.load(Prefill + state)
+        tl.store(Qout + r, start)
+        tl.store(Seq + r, seq)
+        tl.store(Pos + start + j, computed + j, j < end - start)
+        tl.store(EI + cstart + j, state, j < count)
+        tl.store(EL + cstart + j, j, j < count)
+        tl.store(LI + cstart + j, end - count + j, j < count)
+        if seq > prefill:
+            if seq - count >= prefill:
+                last = tl.load(Last + state)
+                tl.store(Ids + end - count, last)
+            draft = tl.load(Draft + state * DS + j, j < count - 1, 0)
+            tl.store(Ids + end - count + 1 + j, draft, j < count - 1)
+
+
+def launch(idx, cu, query, buffers, states, total_logits, max_query):
+    expanded = torch.empty(total_logits, dtype=idx.dtype, device=idx.device)
+    local = torch.empty(total_logits, dtype=torch.int32, device=idx.device)
+    logits = torch.empty(total_logits, dtype=torch.int64, device=idx.device)
+    unpack_prepare[(idx.numel()+1,)](
+        idx, cu, query, buffers.query_start_loc,
+        states.num_computed_tokens.gpu, states.prefill_len.gpu,
+        states.last_sampled_tokens, states.draft_tokens,
+        buffers.positions, buffers.seq_lens, buffers.input_ids,
+        expanded, local, logits, idx.numel(), buffers.seq_lens.numel(),
+        states.draft_tokens.stride(0), triton.next_power_of_2(max_query),
+        num_warps=4)
+    return expanded, local, logits
+
+
+def stage(idx_np, cu_np, query_np, buffers, states, total_logits, max_query):
+    idx, cu, query = upload(idx_np, cu_np, query_np, buffers.query_start_loc.device)
+    expanded, local, logits = launch(idx, cu, query, buffers, states,
+                                    total_logits, max_query)
+    return idx, cu, expanded, local, logits
