VLLM_API_KEY=change-me
VLLM_IMAGE=ghcr.io/canoziia/vllm-sm80:latest
# Shared LMCache server image; the same image serves every deployment in this repository.
LMCACHE_IMAGE=ghcr.io/canoziia/vllm-sm80/lmcache-server:latest
MODEL_ROOT=/srv/models
VLLM_CACHE=/srv/deepseek-v41/cache
# Use a fresh L2 directory whenever the checkpoint changes (KV depends on weights).
LMCACHE_L2_PATH=/srv/lmcache/deepseek-v41-1017
# Checkpoint directory under MODEL_ROOT (1017 = rev 1bae0e1088993b9b82de08f59de5be5a34e42170).
DSV41_MODEL_DIR=DeepSeek-V4.1-Flash-1017

# Spread established decodes over the pp_size in-flight pipeline batches
# (port of upstream vllm-project/vllm#57433). 0 = upstream default. Only takes
# effect with the V2 model runner, pipeline parallelism > 1 and async scheduling.
VLLM_PP_DECODE_COHORT_BALANCE=1

# "auto" selects `default` (or `verification` when adaptive verification is on)
# for PP>1; override with "default", "verification", or "off" if needed.
VLLM_DSV41_OPT_PROFILE=auto
# Algorithm switch passed to speculative-config.enable_adaptive_verification.
# The optimisation profile only controls execution, never automatic k.
VLLM_ADAPTIVE_VERIFICATION=false
# Previous acceptance evidence weight retained after each feedback block [0,1).
VLLM_ADAPTIVE_VERIFICATION_DECAY=0.95

# GPUs (CDI nvidia.com/gpu=<index>) for PP ranks 0-5. podman-compose 1.3 does
# not expand ${VAR:-default} for variables missing from .env, so keep all six.
DSV41_GPU_0=0
DSV41_GPU_1=1
DSV41_GPU_2=2
DSV41_GPU_3=3
DSV41_GPU_4=4
DSV41_GPU_5=5
# SSE keep-alive comments (`: keep-alive`) while a stream is idle (queue,
# long prefill), seconds; 0 = off. Keeps proxies with read timeouts (Cloudflare
# ~100 s) from closing long requests. vLLM --sse-keep-alive-interval.
VLLM_SSE_KEEP_ALIVE_INTERVAL=15
