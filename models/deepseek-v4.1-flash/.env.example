VLLM_API_KEY=change-me
VLLM_IMAGE=localhost/vllm-backport:deepseek-v4.1-flash
# Shared LMCache server image (built by scripts/build-lmcache-server-image.sh);
# the same image serves every deployment in this repository.
LMCACHE_IMAGE=localhost/lmcache-server:latest
MODEL_ROOT=/root/app/models
VLLM_CACHE=/root/app/deepseek-v41/cache
LMCACHE_L2_PATH=/mnt/lmcache-sda/deepseek-v41

# Spread established decodes over the pp_size in-flight pipeline batches
# (shared vLLM patch 0003, a port of upstream #57433). 0 = current upstream default here. Only takes effect with the
# V2 model runner, pipeline parallelism > 1 and async scheduling.
VLLM_PP_DECODE_COHORT_BALANCE=1

# Deployed kernels only; opt-in "verification" also enables request spec_k,
# load-aware cohorts, shared decode metadata and exact metadata graphs.
VLLM_DSV41_OPT_PROFILE=default
# Algorithm switch passed to speculative-config.enable_adaptive_verification.
# The optimisation profile only controls execution, never automatic k.
VLLM_ADAPTIVE_VERIFICATION=false
# Previous acceptance evidence weight retained after each feedback block [0,1).
VLLM_ADAPTIVE_VERIFICATION_DECAY=0.9
VLLM_DSV41_DECODE_TRACE=0
# Set torch + a cache-mounted output directory for one profiler session/restart.
VLLM_PROFILER=null
VLLM_TORCH_PROFILE_DIR=

# GPUs (CDI nvidia.com/gpu=<index>) for PP ranks 0-5. podman-compose 1.3 does
# not expand ${VAR:-default} for variables missing from .env, so keep all six.
DSV41_GPU_0=0
DSV41_GPU_1=1
DSV41_GPU_2=2
DSV41_GPU_3=3
DSV41_GPU_4=4
DSV41_GPU_5=5
