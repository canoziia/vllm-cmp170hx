VLLM_API_KEY=change-me
VLLM_PORT=8000
VLLM_IMAGE=localhost/vllm-main-sm80:deepseek-v4.1-flash-tep4
LMCACHE_IMAGE=localhost/lmcache-server:latest
MODEL_ROOT=/root/app/models
VLLM_CACHE=/root/app/.tmp-tep4/cache
DSV41_MODEL_DIR=DeepSeek-V4.1-Flash-1017

# LMCache L1 (8 GiB host RAM) + L2 (500 GiB fs_native NVMe) for nvfp4_ds_mla KV
LMCACHE_L1_SIZE_GB=8
LMCACHE_CHUNK_SIZE=1024
LMCACHE_L2_PATH=/root/app/lmcache/deepseek-v41-1017-nvfp4

# "tep4_fused" enables topology-aware deep fusions (automatically switches
# between full-capacity NVLink Lamport collectives and bounded PCIe P2P Lamport
# collectives at startup with zero code changes).
# Use "tep4_verification" for the baseline SM80 adaptive-verification profile.
VLLM_DSV41_OPT_PROFILE=tep4_fused
VLLM_ADAPTIVE_VERIFICATION=true
VLLM_ADAPTIVE_VERIFICATION_DECAY=0.95

# 2.20 GB per rank = ~2.01M nvfp4_ds_mla GPU KV tokens (~1.92x 1M context), leaving
# ~100+ MiB HBM safety margin under 1M prefill with LMCache CUDA IPC active.
VLLM_KV_CACHE_MEMORY=2200000000
VLLM_MAX_MODEL_LEN=1048576
VLLM_MAX_NUM_BATCHED_TOKENS=3072
VLLM_MAX_NUM_SEQS=32
VLLM_SSE_KEEP_ALIVE_INTERVAL=15

# Four 80G SM80 GPUs (PCI_BUS_ID order). Never assign faulty/leaking GPUs.
DSV41_GPU_0=0
DSV41_GPU_1=1
DSV41_GPU_2=2
DSV41_GPU_3=3
