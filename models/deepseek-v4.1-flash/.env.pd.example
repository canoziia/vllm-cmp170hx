# Copy to .env.pd (chmod 600, never commit!) and fill in VLLM_API_KEY.
VLLM_IMAGE=ghcr.io/canoziia/vllm-sm80:latest
LMCACHE_IMAGE=ghcr.io/canoziia/vllm-sm80/lmcache-server:latest
ROUTER_IMAGE=localhost/vllm-router:pd-bypass

MODEL_ROOT=/root/app/models
DSV41_MODEL_DIR=DeepSeek-V4.1-Flash-1017
ENGRAM_SHM_DIR=/mnt/engram-shm

VLLM_CACHE_DECODE=/root/app/.tmp-tep4/cache
VLLM_CACHE_PREFILL=/root/app/.tmp-pd-prefill/cache
LMCACHE_L2_PATH=/root/app/lmcache/deepseek-v41-1017-nvfp4

# Decode TP4 on NUMA 0 (GPUs 0-3), Prefill TP2 on NUMA 1 (GPUs 6-7)
DSV41_DECODE_GPU_0=0
DSV41_DECODE_GPU_1=1
DSV41_DECODE_GPU_2=2
DSV41_DECODE_GPU_3=3
DSV41_PREFILL_GPU_0=6
DSV41_PREFILL_GPU_1=7

# Ports: Router takes over :8000; backends listen on localhost only
DSV41_PD_PORT=8000
DSV41_DECODE_PORT=18001
DSV41_PREFILL_PORT=18002
LMCACHE_PORT=5556
LMCACHE_HTTP_PORT=18556

LMCACHE_CHUNK_SIZE=1024
LMCACHE_L1_SIZE_GB=8
LMCACHE_L2_CAPACITY_GB=500

VLLM_MAX_MODEL_LEN=1048576
DSV41_DECODE_MAX_NUM_SEQS=32
DSV41_DECODE_MAX_BATCHED_TOKENS=2048
DSV41_DECODE_KV_CACHE_MEMORY=2200000000

DSV41_PREFILL_MAX_NUM_SEQS=4
DSV41_PREFILL_MAX_BATCHED_TOKENS=3072
DSV41_PREFILL_KV_CACHE_MEMORY=3000000000

VLLM_SSE_KEEP_ALIVE_INTERVAL=15
VLLM_API_KEY=change-me
