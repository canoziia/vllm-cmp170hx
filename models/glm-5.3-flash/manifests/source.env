# GLM-5.3-Flash W4A16 + DFlash2 image. The vLLM source, base image and the
# DeepSeek V4.1 / shared / adaptive series are inherited unchanged from
# models/deepseek-v4.1-flash/manifests/source.env; this file only adds the
# GLM-specific pins.
DEFAULT_OUTPUT_IMAGE=localhost/vllm-backport:glm-5.3-flash-w4a16-dflash2
# Port source (kernels, policies) and the recipe its defaults come from.
MM_SOURCE_REPO=https://github.com/Morrowmake/vllm-cmp170hx.git
MM_SOURCE_COMMIT=3a2bf16dae8b97f5ff2c7e9bc5809d24545e6340
MM_RECIPE_REPO=https://github.com/Morrowmake/glm53-flash-cmp170hx-recipe.git
MM_RECIPE_COMMIT=a242b4fc53724bc5216f416fbbfaf7bf318b9f2c
# Model revisions the port was validated with.
TARGET_MODEL=canada-quant/GLM-5.3-Flash-W4A16-MTP
TARGET_REVISION_PREFIX=5723f4d0
DRAFT_MODEL=incoai/GLM-5.3-Flash-DFlash2
DRAFT_REVISION_PREFIX=bf582e4e
