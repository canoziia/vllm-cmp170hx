# Copy to .env next to the compose files, chmod 600. Never commit the real file.
VLLM_API_KEY=change-me

# compose.pd.w4a16-dflash2.yml (production pair) and compose.w4a16-dflash2.yml
GLM_DFLASH2_IMAGE=localhost/vllm-backport:glm-5.3-flash-w4a16-dflash2
LMCACHE_IMAGE=localhost/lmcache-server:latest
ROUTER_IMAGE=localhost/vllm-router:latest
LMCACHE_L2_PATH=/root/app/lmcache/glm-5.3-flash-w4a16
VLLM_CACHE_PREFILL=/root/app/vllm/cache/glm-5.3-flash-w4a16-prefill
VLLM_CACHE_DECODE=/root/app/vllm/cache/glm-5.3-flash-w4a16-decode
GLM_PREFILL_GPU_0=1
GLM_PREFILL_GPU_1=2
GLM_PREFILL_GPU_2=3
GLM_PREFILL_GPU_3=4
GLM_DECODE_GPU_0=5
GLM_DECODE_GPU_1=6
GLM_DECODE_GPU_2=7
GLM_DECODE_GPU_3=8
# 12 GiB per rank: ~2.69M tokens; about 1.4 GiB of GPU memory left at peak
GLM_PREFILL_KV_CACHE_MEMORY=12884901888
GLM_DECODE_KV_CACHE_MEMORY=12884901888

# compose.w4a16-dflash2.yml (single engine) only
GLM_DFLASH2_CACHE=/root/app/vllm/cache/glm53f-w4a16-dflash2

# compose.pd.yml (NVFP4 pair) only
GLM_MODEL_CACHE=/root/app/vllm/cache/huggingface/hub/models--nvidia--GLM-5.3-Flash-NVFP4
