From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] glm5next: size the kpool tail ring for the draft depth

The kpool indexer tail ring held only index_kpool slots. Under speculative
decoding a rejected draft that completes a pool let later drafts overwrite the
keys that the redo then compresses, writing a wrong pool key into the indexer
cache. Size the ring from the drafted width (k<=3 -> 8, k<=7 -> 16) and
address it by pos % ring. Correctness fix; verified by a 293-case GPU
rollback matrix.

diff --git a/vllm/models/glm5next/nvidia/attention.py b/vllm/models/glm5next/nvidia/attention.py
index 0be7493..ff79e35 100644
--- a/vllm/models/glm5next/nvidia/attention.py
+++ b/vllm/models/glm5next/nvidia/attention.py
@@ -190,15 +190,52 @@ class Glm5NextTailCache(DeepseekV32IndexerCache):
     def get_kv_cache_spec(self, vllm_config: VllmConfig):
         # The two head slots form [K, gate score] in the generic
         # [block, head, state, content] cache view.
+        ring = self.tail_ring_size(
+            self._index_kpool, getattr(vllm_config, "num_speculative_tokens", 0)
+        )
+        block_size = getattr(self.cache_config, "block_size", None)
+        if isinstance(block_size, int) and block_size % ring != 0:
+            # Not fatal (the tail group is a separate 1-block/req group), but a
+            # ring that does not divide the attention block can make the
+            # hybrid allocator grow the scheduler block to their lcm.
+            logger.warning_once(
+                "Glm5NextTailCache: attention block size %d is not a multiple "
+                "of the kpool tail ring %d.",
+                block_size,
+                ring,
+            )
         return KpoolTailSpec(
-            block_size=self._index_kpool,
+            block_size=ring,
             num_kv_heads=2,
             head_size=self.head_dim,
             head_size_v=0,
             dtype=torch.bfloat16,
-            sliding_window=self._index_kpool,
+            sliding_window=ring,
         )
 
+    @staticmethod
+    def tail_ring_size(index_kpool: int, num_speculative_tokens: int) -> int:
+        """Slots of the per-request tail ring.
+
+        Verify tokens are stashed into the ring before acceptance. With a
+        one-pool ring (``index_kpool`` slots) the drafts behind a rejected
+        pool-completing draft overwrite the earlier keys of that pool, and the
+        redo of the completing position then compresses wrong keys (a wrong
+        pool key in the indexer cache). The ring therefore covers one pool
+        plus every draft, rounded to ``index_kpool * 2**m`` so it divides the
+        attention block. Ported from Morrowmake/vllm-cmp170hx
+        glm5next/common/attention.py (Glm5NextTailCache.get_kv_cache_spec).
+
+        ROCm keeps the one-pool ring: its kpool kernels
+        (glm5next/amd/ops/kpool_compress.py) still assume ring == kpool.
+        """
+        num_spec = int(num_speculative_tokens or 0)
+        if num_spec <= 0 or current_platform.is_rocm():
+            return index_kpool
+        span = index_kpool + num_spec
+        pools = -(-span // index_kpool)
+        return index_kpool * (1 << (pools - 1).bit_length())
+
     def get_attn_backend(self):
         from vllm.v1.attention.backends.mla.indexer import KpoolTailBackend
 
diff --git a/vllm/models/glm5next/nvidia/ops/kpool_compress.py b/vllm/models/glm5next/nvidia/ops/kpool_compress.py
index d09c33c..fb2a3fc 100644
--- a/vllm/models/glm5next/nvidia/ops/kpool_compress.py
+++ b/vllm/models/glm5next/nvidia/ops/kpool_compress.py
@@ -422,35 +422,43 @@ def _kpool_tail_seed_kernel(
     n_tokens,
     HEAD_DIM: tl.constexpr,
     KPOOL: tl.constexpr,
+    RING: tl.constexpr,
+    TAIL_BLOCK_ELEMS: tl.constexpr,
+    KPOOL_HEAD: tl.constexpr,
     BLOCK_D: tl.constexpr,
 ):
-    """Copy token ``i``'s raw K + gate into its request's tail block.
+    """Copy token ``i``'s raw K + gate into its request's tail ring.
 
     Token ``i`` is among its request's last KPOOL tokens iff the token KPOOL
     ahead belongs to a different tail block (or is past the batch / padding,
-    slot < 0). ``tslot = block * KPOOL + pos % KPOOL``; the destination is
-    ``tail[block, {0:K, 1:score}, pos % KPOOL, :]``.
+    slot < 0). ``tslot = block * RING + pos % RING``; the destination is
+    ``tail[block, {0:K, 1:score}, pos % RING, :]``. RING (the tail block
+    size, a multiple of KPOOL) is larger than KPOOL under speculative decode
+    so a rejected pool-completing draft's successors cannot overwrite the
+    keys its redo reads (see Glm5NextTailCache.get_kv_cache_spec). Blocks are
+    addressed through the tail tensor's strides (TAIL_BLOCK_ELEMS /
+    KPOOL_HEAD), not a dense ``[num_blocks, 2, RING, HEAD_DIM]`` assumption.
     """
     i = tl.program_id(0)
     t = tl.load(tslot_ptr + i).to(tl.int64)
     if t < 0:
         return
-    blk = t // KPOOL  # t >= 0 here, so trunc == floor
+    blk = t // RING  # t >= 0 here, so trunc == floor
     ahead = tl.load(tslot_ptr + i + KPOOL, mask=i + KPOOL < n_tokens, other=-1).to(
         tl.int64
     )
     # Match the torch semantics exactly: a negative ahead slot floors to a
     # block id that differs from every real block -> token is in the tail.
     # Only divide non-negative slots (Triton int div truncates, torch floors).
-    if ahead >= 0 and ahead // KPOOL == blk:
+    if ahead >= 0 and ahead // RING == blk:
         return
     offs = tl.arange(0, BLOCK_D)
     m = offs < HEAD_DIM
-    base = (blk * 2 * KPOOL + t % KPOOL) * HEAD_DIM
+    base = blk * TAIL_BLOCK_ELEMS + (t % RING) * HEAD_DIM
     k = tl.load(key_ptr + i * HEAD_DIM + offs, mask=m)
     s = tl.load(score_ptr + i * HEAD_DIM + offs, mask=m)
     tl.store(tail_ptr + base + offs, k, mask=m)
-    tl.store(tail_ptr + base + KPOOL * HEAD_DIM + offs, s, mask=m)
+    tl.store(tail_ptr + base + KPOOL_HEAD + offs, s, mask=m)
 
 
 def kpool_seed_tail_cache(
@@ -464,6 +472,10 @@ def kpool_seed_tail_cache(
     """Seed the paged tail cache from a prefill batch (see the kernel)."""
     assert tail_kv_cache.dtype == torch.bfloat16
     assert key.dtype == torch.bfloat16
+    assert tail_kv_cache.ndim == 4 and tail_kv_cache.shape[1] == 2
+    assert tail_kv_cache.stride(3) == 1 and tail_kv_cache.stride(2) == head_dim
+    ring = tail_kv_cache.shape[2]
+    assert ring >= kpool and ring % kpool == 0, (ring, kpool)
     n = tslot.shape[0]
     if n == 0:
         return
@@ -475,6 +487,9 @@ def kpool_seed_tail_cache(
         n,
         HEAD_DIM=head_dim,
         KPOOL=kpool,
+        RING=ring,
+        TAIL_BLOCK_ELEMS=tail_kv_cache.stride(0),
+        KPOOL_HEAD=tail_kv_cache.stride(1),
         BLOCK_D=triton.next_power_of_2(head_dim),
     )
 
@@ -502,6 +517,7 @@ def _kpool_decode_update_batched_kernel(
