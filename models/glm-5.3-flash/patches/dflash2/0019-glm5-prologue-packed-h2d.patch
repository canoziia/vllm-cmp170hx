diff --git a/vllm/v1/worker/gpu/prologue_h2d.py b/vllm/v1/worker/gpu/prologue_h2d.py
new file mode 100644
index 0000000..d847a96
--- /dev/null
+++ b/vllm/v1/worker/gpu/prologue_h2d.py
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""One host-to-device copy for the V2 runner's per-step index arrays.
+
+Opt-in with ``VLLM_GLM5_PROLOGUE_PACKED_H2D=1`` (patch 0019). Default **off**:
+``GPUModelRunner.prepare_inputs`` keeps its three ``async_copy_to_gpu`` calls.
+
+``prepare_inputs`` uploads three small arrays every step, each through its own
+``x.pin_memory()`` (a pinned-host allocation plus a host memcpy) and its own
+``cudaMemcpyAsync``:
+
+==========================  ======  ==========================================
+array                       dtype   destination
+==========================  ======  ==========================================
+``idx_mapping_np``          intp    fresh device tensor (``input_batch.idx_mapping``)
+``cu_num_logits_np``        int32   fresh device tensor (only with drafts)
+``query_start_loc_np``      int32   the persistent ``input_buffers.query_start_loc``
+==========================  ======  ==========================================
+
+Here the arrays are written into one pinned byte buffer (each segment 16-byte
+aligned), uploaded with one ``cudaMemcpyAsync`` into one fresh device byte
+buffer, and handed out as dtype views. ``query_start_loc`` must live in the
+persistent buffer (FULL CUDA graphs read it by address), so its segment is
+copied there device-to-device. Net per step: 3 HtoD + 3 pinned allocations
+become 1 HtoD + 1 DtoD + 1 pinned allocation.
+
+Safety
+------
+* The bytes are the same, so every derived input (positions, seq lens, slot
+  mappings, block tables, logits indices) is bit-identical.
+* The device views are fresh allocations, exactly like the tensors
+  ``async_copy_to_gpu`` returns, so deferred readers (the PP handler keeps a
+  step's ``idx_mapping`` for ``pp_size`` steps; the broadcast stream records
+  it) see the same lifetime as before. ``record_stream`` on a view records the
+  whole storage.
+* The pinned buffer comes from PyTorch's caching host allocator, which does
+  not hand a block out again until the event recorded by the non-blocking
+  copy has completed -- the same guarantee ``x.pin_memory()`` relies on today.
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+
+import numpy as np
+import torch
+
+_ALIGN = 16
+_TRUE = ("1", "true", "yes", "on")
+
+
+@functools.cache
+def enabled() -> bool:
+    return os.getenv("VLLM_GLM5_PROLOGUE_PACKED_H2D", "0").strip().lower() in _TRUE
+
+
+def _layout(arrays: list[np.ndarray]) -> tuple[list[int], int]:
+    offsets = []
+    off = 0
+    for a in arrays:
+        offsets.append(off)
+        off += (a.nbytes + _ALIGN - 1) // _ALIGN * _ALIGN
+    return offsets, max(off, _ALIGN)
+
+
+def packed_h2d(
+    arrays: list[np.ndarray],
+    device: torch.device | str,
+    pin: bool | None = None,
+) -> list[torch.Tensor]:
+    """Upload ``arrays`` with one copy; return one 1-D device view per array,
+    with the dtype ``torch.from_numpy`` would give it."""
+    arrays = [np.ascontiguousarray(a).reshape(-1) for a in arrays]
+    offsets, total = _layout(arrays)
+    if pin is None:
+        pin = torch.device(device).type == "cuda"
+    host = torch.empty(total, dtype=torch.uint8, pin_memory=pin)
+    host_np = host.numpy()
+    for a, off in zip(arrays, offsets):
+        host_np[off : off + a.nbytes] = a.view(np.uint8)
+    dev = torch.empty(total, dtype=torch.uint8, device=device)
+    dev.copy_(host, non_blocking=True)
+    out = []
+    for a, off in zip(arrays, offsets):
+        dtype = torch.from_numpy(a[:0]).dtype
+        out.append(dev[off : off + a.nbytes].view(dtype))
+    return out
+
+
+def stage_prologue_inputs(
+    idx_mapping_np: np.ndarray,
+    cu_num_logits_np: np.ndarray | None,
+    query_start_loc_np: np.ndarray,
+    query_start_loc_out: torch.Tensor,
+    device: torch.device | str,
+    pin: bool | None = None,
+) -> tuple[torch.Tensor, torch.Tensor | None]:
+    """Packed replacement for the three uploads in ``prepare_inputs``.
+
+    Writes ``query_start_loc_np`` into ``query_start_loc_out`` (persistent) and
+    returns ``(idx_mapping, cu_num_logits)``; ``cu_num_logits`` is None when
+    ``cu_num_logits_np`` is None (the caller keeps its device ``arange``).
+    """
+    assert query_start_loc_out.dtype == torch.from_numpy(query_start_loc_np[:0]).dtype
+    assert query_start_loc_out.shape[0] == query_start_loc_np.shape[0]
+    arrays = [idx_mapping_np, query_start_loc_np]
+    if cu_num_logits_np is not None:
+        arrays.append(cu_num_logits_np)
+    views = packed_h2d(arrays, device, pin=pin)
+    query_start_loc_out.copy_(views[1], non_blocking=True)
+    cu = views[2] if cu_num_logits_np is not None else None
+    return views[0], cu
