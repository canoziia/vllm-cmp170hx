 import itertools
+import os
 import time
 from collections import defaultdict, deque
 from collections.abc import Iterable
@@ -321,6 +322,19 @@ class Scheduler(SchedulerInterface):
                     "acceptance rates."
                 )
 
+        # Unlike EAGLE's shifted inputs, DFlash stores target context KV at
+        # the original positions and writes queries strictly AFTER that context.
+        # Limit this policy to the validated GLM profile and prompt-only cache
+        # publication; speculative/rejected suffixes are never evidence of a hit.
+        kv_cache_config.dflash_context_prefix = bool(
+            speculative_config is not None
+            and speculative_config.use_dflash()
+            and os.environ.get("VLLM_GLM53_PREFIX_RETENTION", "0") == "1"
+        )
+        if kv_cache_config.dflash_context_prefix:
+            self.use_eagle_block_drop = False
+            self.num_prefill_lookahead = 0
+
         # Create the KV cache manager.
         if hash_block_size is None:
             hash_block_size = block_size
diff --git a/vllm/v1/core/single_type_kv_cache_manager.py b/vllm/v1/core/single_type_kv_cache_manager.py
index 1eaf298..454cd57 100644
--- a/vllm/v1/core/single_type_kv_cache_manager.py
+++ b/vllm/v1/core/single_type_kv_cache_manager.py
@@ -468,6 +468,13 @@ class SingleTypeKVCacheManager(ABC):
             replay_boundaries: Positions a later request replaying this prompt
                 can resume at, from ``get_replay_boundaries``.
         """
+        if getattr(self, "dflash_context_prefix", False):
+            # The final prompt page may also hold query masks / rejected tokens.
+            # Never publish it as a complete page merely because decode advanced.
+            # Earlier complete pages were filled from causal target context and
+            # later context/query writes cannot address positions before them.
+            if num_tokens > request.num_prompt_tokens:
+                return
         num_cached_blocks = self.num_cached_block.get(request.request_id, 0)
         num_full_blocks = num_tokens // self.block_size
 
