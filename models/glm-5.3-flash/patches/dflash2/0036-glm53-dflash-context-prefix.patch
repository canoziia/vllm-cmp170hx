From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] glm5: cache finalized DFlash context prefixes without shifted markers

DFlash context is position preserving, unlike EAGLE. Restrict publication to
complete prompt pages; query and rejected suffixes are never cache evidence.
Reuse Qwen group-scoped CoW to isolate heterogeneous cache state.

diff --git a/vllm/v1/core/kv_cache_coordinator.py b/vllm/v1/core/kv_cache_coordinator.py
index 9903235..13df10c 100644
--- a/vllm/v1/core/kv_cache_coordinator.py
+++ b/vllm/v1/core/kv_cache_coordinator.py
@@ -112,6 +112,12 @@ class KVCacheCoordinator(ABC):
         if use_eagle and not self.eagle_group_ids:
             self.eagle_group_ids = set(range(len(kv_cache_config.kv_cache_groups)))
 
+        if kv_cache_config.dflash_context_prefix:
+            # Complete prompt pages contain only position-preserving context KV.
+            # Keep group identity in the config, but do not consume a future
+            # page as an EAGLE marker for this explicitly different write path.
+            self.eagle_group_ids.clear()
+
         # During chunked prefill with EAGLE, the single next prefill lookahead
         # token past the chunk boundary is combined with the final hidden state
         # and written to the KV cache. Therefore, the final chunk token must be
@@ -151,6 +157,8 @@ class KVCacheCoordinator(ABC):
             )
             for i, kv_cache_group in enumerate(self.kv_cache_config.kv_cache_groups)
         )
+        for manager in self.single_type_managers:
+            manager.dflash_context_prefix = kv_cache_config.dflash_context_prefix
         # Match Mamba checkpoints to Eagle's attention replay boundary.
         if use_eagle:
             for manager in self.single_type_managers:
diff --git a/vllm/v1/core/kv_cache_manager.py b/vllm/v1/core/kv_cache_manager.py
