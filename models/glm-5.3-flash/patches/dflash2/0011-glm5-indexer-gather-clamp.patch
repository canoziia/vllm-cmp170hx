diff --git a/vllm/v1/attention/backends/mla/indexer.py b/vllm/v1/attention/backends/mla/indexer.py
index 7662948..009f0ad 100644
--- a/vllm/v1/attention/backends/mla/indexer.py
+++ b/vllm/v1/attention/backends/mla/indexer.py
@@ -845,6 +845,40 @@ def get_max_prefill_buffer_size(vllm_config: VllmConfig):
     return min(max_model_len, 131072) * 40
 
 
+def get_indexer_gather_workspace_size(
+    vllm_config: VllmConfig, compress_ratio: int = 1
+) -> int:
+    """Rows of index-K a single prefill chunk can ever gather.
+
+    ``get_max_prefill_buffer_size`` is a heuristic, not a bound on what a step
+    can produce. A prefill chunk never spans more requests than
+    ``max_num_seqs``, and each request contributes at most
+    ``cdiv(max_model_len, compress_ratio)`` compressed entries, so the clamp
+    leaves chunk formation unchanged and is never below one full-length
+    request (the single-request escape hatch in
+    ``_split_indexer_prefill_chunks`` still fits). Ported from
+    Morrowmake/vllm-cmp170hx. With ``VLLM_GLM5_INDEXER_GATHER_CLAMP`` unset
+    (default) this returns the heuristic unchanged.
+    """
+    legacy = get_max_prefill_buffer_size(vllm_config)
+    if not envs.VLLM_GLM5_INDEXER_GATHER_CLAMP:
+        return legacy
+    ratio = max(1, int(compress_ratio))
+    max_len = vllm_config.model_config.max_model_len
+    clamped = min(
+        legacy,
+        vllm_config.scheduler_config.max_num_seqs * (-(-max_len // ratio)),
+    )
+    logger.info_once(
+        "VLLM_GLM5_INDEXER_GATHER_CLAMP: indexer gather rows %d -> %d "
+        "(compress_ratio %d).",
+        legacy,
+        clamped,
+        ratio,
+    )
+    return clamped
+
+
 def _supports_varlen_paged_mqa_logits() -> bool:
     return (
         current_platform.is_cuda()
@@ -1056,6 +1090,12 @@ class DeepseekV32IndexerMetadataBuilder(AttentionMetadataBuilder):
                 "DCP is not supported with sparse indexer KV compression "
                 f"(compress_ratio={self.compress_ratio})."
             )
+        # Must stay in step with the indexer op's gather workspace, which is
+        # sized by the same helper (glm5next attention.py). Identical to the
+        # assignment above unless VLLM_GLM5_INDEXER_GATHER_CLAMP=1.
+        self.max_prefill_buffer_size = get_indexer_gather_workspace_size(
+            self.vllm_config, self.compress_ratio
+        )
 
         # Pre-allocate buffers for CUDA graph compatibility when
         if self.compress_ratio > 1:
