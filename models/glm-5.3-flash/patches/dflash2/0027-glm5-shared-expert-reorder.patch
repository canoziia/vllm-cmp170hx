From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] glm5: enqueue shared experts after the routed experts

VLLM_GLM5_SHARED_EXPERT_REORDER (default 0; read once per process). Port of
Morrowmake's switch of the same name. Upstream enqueues the shared experts
on the aux stream before the gate/router/routed experts. With the flag the
runner only records the aux start event at that point (after route v2 when
VLLM_GLM5_ROUTE_V2_FIRST=1), enqueues the routed experts on the main stream,
then runs the shared experts on aux and joins. Same kernels, inputs and
events; only the host enqueue order changes: bit-identical. Disabled with
DP/EP dispatch/combine or when the multi-stream order is not chosen.

diff --git a/vllm/model_executor/layers/fused_moe/runner/moe_runner.py b/vllm/model_executor/layers/fused_moe/runner/moe_runner.py
index 7a3e63c..a206677 100644
--- a/vllm/model_executor/layers/fused_moe/runner/moe_runner.py
+++ b/vllm/model_executor/layers/fused_moe/runner/moe_runner.py
@@ -67,6 +67,19 @@ def _glm5_route_v2_enabled() -> bool:
 
 
 _GLM5_ROUTE_V2: bool | None = None
+_GLM5_SHARED_REORDER: bool | None = None
+
+
+def _glm5_shared_reorder_enabled() -> bool:
+    """VLLM_GLM5_SHARED_EXPERT_REORDER=1 (0028; default off; read once)."""
+    global _GLM5_SHARED_REORDER
+    if _GLM5_SHARED_REORDER is None:
+        import os
+
+        _GLM5_SHARED_REORDER = (
+            os.getenv("VLLM_GLM5_SHARED_EXPERT_REORDER", "0").strip() == "1"
+        )
+    return _GLM5_SHARED_REORDER
 
 
 def register_layer_for_moe_forward_op(
@@ -617,6 +630,7 @@ class MoERunner(MoERunnerInterface):
         shared_experts_input: torch.Tensor | None,
         input_ids: torch.Tensor | None = None,
         shared_experts_overlapping: bool = False,
+        shared_experts_marked: bool = False,
     ) -> tuple[torch.Tensor | None, torch.Tensor | UnfinalizedMoEOutput]:
         """Run expert routing and the fused MoE kernel via the quant method.
 
@@ -659,6 +673,11 @@ class MoERunner(MoERunnerInterface):
         if shared_experts_overlapping:
             assert self._shared_experts is not None
             self._shared_experts.wait()
+        elif shared_experts_marked:
+            # 0028: shared experts on aux behind the routed kernels, joined.
+            assert self._shared_experts is not None
+            assert shared_experts_input is not None
+            self._shared_experts.run_marked(shared_experts_input)
 
         return (
             self._shared_experts.output if self._shared_experts is not None else None,
@@ -991,10 +1010,19 @@ class MoERunner(MoERunnerInterface):
         # If using multi-stream overlap for shared experts, we must launch it
         # before routed expert dispatch.
         shared_experts_overlapping = False
+        shared_experts_marked = False
         if self._shared_experts is not None:
-            shared_experts_overlapping = self._shared_experts.maybe_forward_async(
-                shared_experts_input
-            )
+            if _glm5_shared_reorder_enabled() and not self.do_naive_dispatch_combine:
+                # VLLM_GLM5_SHARED_EXPERT_REORDER (0028): only mark the aux
+                # start here; the shared experts are enqueued on aux after the
+                # routed experts (_apply_quant_method).
+                shared_experts_marked = self._shared_experts.maybe_mark_aux(
+                    shared_experts_input
+                )
+            else:
+                shared_experts_overlapping = (
+                    self._shared_experts.maybe_forward_async(shared_experts_input)
+                )
 
         # If the Runner holds the gate, apply it after the stream sync,
         # so it can run overlapped with the
@@ -1035,6 +1063,7 @@ class MoERunner(MoERunnerInterface):
                 shared_experts_input=shared_experts_input,
                 input_ids=input_ids,
                 shared_experts_overlapping=shared_experts_overlapping,
+                shared_experts_marked=shared_experts_marked,
             )
 
             return self._maybe_combine(
diff --git a/vllm/model_executor/layers/fused_moe/runner/shared_experts.py b/vllm/model_executor/layers/fused_moe/runner/shared_experts.py
index 5b9587c..84c627d 100644
--- a/vllm/model_executor/layers/fused_moe/runner/shared_experts.py
+++ b/vllm/model_executor/layers/fused_moe/runner/shared_experts.py
@@ -153,6 +153,34 @@ class SharedExperts(torch.nn.Module):
             self._output_ready_event[idx].record(self._stream)
         return True
 
+    def maybe_mark_aux(self, shared_experts_input: torch.Tensor) -> bool:
+        """VLLM_GLM5_SHARED_EXPERT_REORDER (0028): mark the aux stream's start
+        point (an event on the main stream, nothing enqueued on aux) when the
+        multi-stream order is chosen; ``run_marked`` later runs the shared
+        experts on aux, behind the routed kernels already enqueued, and joins.
+        Same events, same edges as ``maybe_forward_async``; only the host
+        enqueue order (and so the graph node creation order) changes."""
+        if (
+            self._determine_shared_experts_order(shared_experts_input)
+            != SharedExpertsOrder.MULTI_STREAM_OVERLAPPED
+        ):
+            return False
+        assert self._stream is not None
+        idx = self._output_idx
+        assert self._output[idx] is None
+        self._input_ready_event[idx].record(current_stream())
+        return True
+
+    def run_marked(self, shared_experts_input: torch.Tensor) -> None:
+        """Second half of ``maybe_mark_aux``: run on aux, then join main."""
+        assert self._stream is not None
+        idx = self._output_idx
+        with torch.cuda.stream(self._stream):
+            self._input_ready_event[idx].wait(self._stream)
+            self._output[idx] = self._layer(shared_experts_input)
+            self._output_ready_event[idx].record(self._stream)
+        self._output_ready_event[idx].wait(current_stream())
+
     def wait(self) -> None:
         """Block the main stream until `maybe_forward_async` output is ready."""
         assert self._stream is not None
