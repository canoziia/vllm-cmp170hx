--- a/vllm/models/glm5next/nvidia/model.py
+++ b/vllm/models/glm5next/nvidia/model.py
@@ -99,6 +99,31 @@ from .multimodal import (
 
 logger = init_logger(__name__)
 
+# torch.mm(..., out_dtype=torch.float32) for bf16 inputs (fp32 output, no
+# rounding to bf16). None until probed; False -> upcast fallback.
+_MM_OUT_DTYPE_OK: bool | None = None
+
+
+def _mm_fp32(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+    """``x @ w.T`` with fp32 output (fp32 accumulation, no rounding to the
+    input dtype), as the drafter fc accumulates before its single rounding.
+    Used by the PP fc fold (VLLM_GLM5_PP_FOLD_DRAFT_FC, patch 0023)."""
+    global _MM_OUT_DTYPE_OK
+    if x.is_cuda and _MM_OUT_DTYPE_OK is not False:
+        try:
+            out = torch.mm(x, w.t(), out_dtype=torch.float32)
+            _MM_OUT_DTYPE_OK = True
+            return out
+        except (TypeError, RuntimeError):
+            if _MM_OUT_DTYPE_OK:
+                raise
+            _MM_OUT_DTYPE_OK = False
+            logger.warning(
+                "torch.mm(out_dtype=float32) unavailable; the PP fc fold "
+                "upcasts to fp32 instead (same products, slower)"
+            )
+    return torch.mm(x.float(), w.float().t())
+
 
