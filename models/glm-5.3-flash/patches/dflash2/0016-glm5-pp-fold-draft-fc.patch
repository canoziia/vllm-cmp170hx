diff --git a/vllm/v1/worker/gpu/spec_decode/eagle/aux_fc_fold.py b/vllm/v1/worker/gpu/spec_decode/eagle/aux_fc_fold.py
new file mode 100644
index 0000000..0bfecdb
--- /dev/null
+++ b/vllm/v1/worker/gpu/spec_decode/eagle/aux_fc_fold.py
@@ -0,0 +1,201 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fold a DFlash drafter's input projection into the pipeline stages.
+
+Port of Morrowmake's ``spec_decode/eagle/aux_fc_fold.py``
+(``VLLM_GLM5_PP_FOLD_DRAFT_FC``), patch 0023.
+
+The drafter's first op is ``fc(cat(aux_0, ..., aux_{n-1}))``: one linear map
+over the concatenated aux hidden states, i.e. ``sum_i aux_i @ W_i^T`` with
+``W_i`` the i-th column block of ``fc.weight``. Under PP the aux states are
+produced on several stages and, by default, relayed one key per state to the
+last stage (``PPHandler.relay_aux_hidden_states``), which concatenates them and
+runs the full ``[T, n*H] x [n*H, H]`` GEMM.
+
+With the switch on, every stage multiplies its own aux states by their column
+blocks (bf16 inputs, fp32 output) and adds them to a running fp32 partial sum
+that crosses the boundary under one key instead of the aux states. The last
+stage hands the finished sum to the drafter in place of the concatenation and
+the drafter skips its ``fc`` (one cast to the model dtype). The products and
+the sum are the numbers the single fc GEMM accumulates in fp32 before its one
+rounding, so the result differs only in fp32 summation order.
+
+Each stage loads only its own ``W_i`` (H x H per aux layer) from the drafter
+checkpoint. The last stage cross-checks its blocks against the loaded drafter.
+"""
+
+import glob
+import os
+from typing import Any
+
+import torch
+import torch.nn as nn
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+AUX_FC_PARTIAL_KEY = "aux_fc_partial"
+# Checkpoint names of the drafter fc (qwen3_dflash.py maps "encoder.fc." to
+# "fc."; some exports keep a "model." prefix).
+_FC_WEIGHT_NAMES = ("fc.weight", "model.fc.weight", "encoder.fc.weight")
+
+
+def _inner(model: nn.Module) -> nn.Module | None:
+    from vllm.v1.worker.gpu.spec_decode.eagle.eagle3_utils import _inner_decoder
+
+    return _inner_decoder(model)
+
+
+def _draft_checkpoint_files(spec_config: Any) -> list[str]:
+    path = spec_config.draft_model_config.model
+    if not os.path.isdir(path):
+        from huggingface_hub import snapshot_download
+
+        path = snapshot_download(
+            path, allow_patterns=["*.safetensors"], local_files_only=True
+        )
+    return sorted(glob.glob(os.path.join(path, "*.safetensors")))
+
+
+def load_fc_column_blocks(
+    files: list[str], indices: list[int], hidden_size: int, num_aux: int
+) -> dict[int, torch.Tensor]:
+    """``{i: fc.weight[:, i*H:(i+1)*H]}`` for the requested aux indices."""
+    from safetensors import safe_open
+
+    for f in files:
+        with safe_open(f, framework="pt") as st:
+            names = set(st.keys())
+            name = next((n for n in _FC_WEIGHT_NAMES if n in names), None)
+            if name is None:
+                continue
+            sl = st.get_slice(name)
+            shape = tuple(sl.get_shape())
+            if shape != (hidden_size, num_aux * hidden_size):
+                raise ValueError(
+                    f"{name} has shape {shape}, expected "
+                    f"({hidden_size}, {num_aux * hidden_size})"
+                )
+            out = {
+                i: sl[:, i * hidden_size : (i + 1) * hidden_size].contiguous()
+                for i in indices
+            }
+            for w in out.values():
+                if not w.is_floating_point():
+                    raise ValueError(f"{name} is not a float tensor ({w.dtype})")
+            return out
+    raise FileNotFoundError(f"none of {_FC_WEIGHT_NAMES} found in {files}")
+
+
+def maybe_configure_aux_fc_fold(
+    model: nn.Module,
+    spec_config: Any,
+    pp_handler: Any,
+    load_dummy_weights: bool = False,
+    files: list[str] | None = None,
+    dtype: torch.dtype | None = None,
+) -> bool:
+    """Enable the fold on this stage if VLLM_GLM5_PP_FOLD_DRAFT_FC=1 and the
+    model supports it. Must run after the aux layers and the relay are
+    configured (set_eagle3_aux_hidden_state_layers,
+    configure_aux_hidden_state_relay) and before the persistent receive
+    buffer is allocated (make_empty_intermediate_tensors in the runner).
+
+    Every stage must reach the same decision: the gate only reads the env,
+    the PP world size, the spec method and the model class, which are equal
+    on all stages."""
+    if not envs.VLLM_GLM5_PP_FOLD_DRAFT_FC:
+        return False
+    from vllm.distributed.parallel_state import get_pp_group
+
+    pp = get_pp_group()
+    inner = _inner(model)
+    reason = None
+    if pp.world_size < 2:
+        reason = "no pipeline parallelism"
+    elif spec_config is None or spec_config.method != "dflash":
+        reason = "only the DFlash drafter is supported"
+    elif inner is None or not hasattr(inner, "enable_aux_fc_fold"):
+        reason = f"{type(inner).__name__} does not support it"
+    elif getattr(inner, "is_sequence_parallel", False):
+        reason = "sequence parallelism"
+    elif not getattr(inner, "aux_hidden_state_layers", ()):
+        reason = "no aux hidden-state layers"
+    if reason is not None:
+        logger.warning("VLLM_GLM5_PP_FOLD_DRAFT_FC ignored: %s", reason)
+        return False
+
+    hidden = inner.config.hidden_size
+    num_aux = len(inner.aux_hidden_state_layers)
+    base = inner._aux_slot_base_cached
+    # Aux id i is captured after layer i - 1 (forward: layer_idx + 1 in
+    # aux_layers), so this stage owns the ids in (start_layer, end_layer];
+    # they follow the upstream ones in slot order.
+    num_local = sum(
+        inner.start_layer < i <= inner.end_layer for i in inner.aux_hidden_state_layers
+    )
+    local = list(range(base, base + num_local))
+    device = next(inner.parameters()).device
+    if dtype is None:
+        dtype = torch.bfloat16
+    if load_dummy_weights:
+        blocks = {i: torch.zeros(hidden, hidden, dtype=dtype) for i in local}
+    else:
+        files = files if files is not None else _draft_checkpoint_files(spec_config)
+        blocks = load_fc_column_blocks(files, local, hidden, num_aux)
+    inner.enable_aux_fc_fold(
+        {i: w.to(device=device, dtype=dtype) for i, w in blocks.items()}
+    )
+
+    # The boundary now carries the fp32 partial sum instead of aux states.
+    # Built on the inner model's factory, so the aux slots that
+    # reserve_aux_intermediate_tensor_slots added to the outer one are gone
+    # (the runner indexes every receive-buffer key in the received dict).
+    if not pp.is_first_rank:
+        base_make = inner.make_empty_intermediate_tensors
+
+        def make_empty_with_partial(batch_size, dtype, device):
+            tensors = base_make(batch_size, dtype, device)
+            tensors[AUX_FC_PARTIAL_KEY] = torch.zeros(
+                (batch_size, hidden), dtype=torch.float32, device=device
+            )
+            return tensors
+
+        model.make_empty_intermediate_tensors = make_empty_with_partial
+    if pp_handler is not None:
+        pp_handler.aux_hidden_state_relay_keys = ()
+    logger.info(
+        "DFlash fc folded into the pipeline: this stage applies aux block(s) %s "
+        "of %d and forwards an fp32 partial sum",
+        local,
+        num_aux,
+    )
+    return True
+
+
+def mark_drafter_aux_fc_folded(
+    speculator: Any, target_model: nn.Module | None = None
+) -> None:
+    """Tell the last stage's drafter that its aux input is already the fc
+    output (DFlashQwen3ForCausalLM.combine_hidden_states). With the target
+    model given, check this stage's blocks against the loaded drafter fc."""
+    draft_model = getattr(speculator, "model", None)
+    if draft_model is None:
+        raise RuntimeError("fc fold: the speculator has no draft model")
+    if target_model is not None:
+        inner = _inner(target_model)
+        blocks = getattr(inner, "aux_fc_blocks", None) or {}
+        fc = getattr(getattr(draft_model, "model", None), "fc", None)
+        weight = getattr(fc, "weight", None)
+        if weight is not None and weight.is_floating_point():
+            h = weight.shape[0]
+            for i, w in blocks.items():
+                ref = weight[:, i * h : (i + 1) * h]
+                if ref.shape != w.shape or not torch.equal(ref.to(w.dtype), w):
+                    raise RuntimeError(
+                        f"fc fold: aux block {i} on this stage differs from the "
+                        "loaded drafter fc.weight (wrong checkpoint name/layout?)"
+                    )
+    draft_model.aux_fc_folded = True
