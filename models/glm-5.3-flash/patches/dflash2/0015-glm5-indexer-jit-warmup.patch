From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] glm5next: pre-compile the kpool indexer prefill kernels

VLLM_GLM5_INDEXER_JIT_WARMUP (default 1; 0 disables). At boot, compile every
Triton specialization the kpool indexer prefill reaches
(_fp8_mqa_logits_kernel KV_GROUP x N%16 classes, and the prefill chunk
metadata kernel's JIT keys), removing ~6 s mid-request JIT stalls at the
first long-context chunk after a cold start. Compile-only; outputs are
bit-identical.

diff --git a/vllm/envs.py b/vllm/envs.py
index 413a1cd..8c3a4e1 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -58,6 +58,7 @@ if TYPE_CHECKING:
     VLLM_GLM5_DFLASH_ADAPTIVE_K_HYST: float = 0.03
     VLLM_GLM5_DFLASH_ADAPTIVE_K_PRIOR: float = 0.75
     VLLM_GLM5_INDEXER_GATHER_CLAMP: bool = False
+    VLLM_GLM5_INDEXER_JIT_WARMUP: bool = True
     VLLM_GLM5_PP_SPARSE_MLA_PREFILL: bool = False
     VLLM_GLM5_PP_SPARSE_MLA_PREFILL_MIN_TOKENS: int = 384
     VLLM_GLM5_PP_KDA_PREFILL: bool = False
@@ -981,6 +982,14 @@ environment_variables: dict[str, Callable[[], Any]] = {
     "VLLM_GLM5_INDEXER_GATHER_CLAMP": lambda: bool(
         int(os.getenv("VLLM_GLM5_INDEXER_GATHER_CLAMP", "0"))
     ),
+    # Pre-compile, at model construction, every Triton specialization the
+    # GLM5Next kpool indexer prefill reaches (MQA-logits KV_GROUP x N % 16, and
+    # the prefill-chunk metadata kernel's query-slice classes) instead of
+    # JIT-compiling them mid-request at long context. Compile-only: no kernel
+    # or argument changes, outputs bit-identical. Default on; 0 disables.
+    "VLLM_GLM5_INDEXER_JIT_WARMUP": lambda: bool(
+        int(os.getenv("VLLM_GLM5_INDEXER_JIT_WARMUP", "1"))
+    ),
     # Sparse-MLA prefill with all 64 heads on one card (PP, TP=1): Gluon kernel
     # ported from Morrowmake (glm5next/nvidia/ops/sparse_prefill_mla_pp.py) that
     # gathers each selected cache row once for all heads and skips invalid
diff --git a/vllm/model_executor/layers/sparse_attn_indexer_kpool.py b/vllm/model_executor/layers/sparse_attn_indexer_kpool.py
index 210041b..4701b62 100644
--- a/vllm/model_executor/layers/sparse_attn_indexer_kpool.py
+++ b/vllm/model_executor/layers/sparse_attn_indexer_kpool.py
@@ -967,6 +967,31 @@ def sparse_attn_indexer_kpool(
     return topk_indices_buffer
 
 
+_PREFILL_LOGITS_WARMED: set[tuple[int, int, str]] = set()
+
+
+def _warmup_prefill_logits_once(
+    num_heads: int, head_dim: int, device: torch.device
+) -> None:
+    # One indexer per layer constructs this op; compile once per process.
+    key = (num_heads, head_dim, str(device))
+    if key in _PREFILL_LOGITS_WARMED:
+        return
+    from vllm.v1.attention.ops.mqa_logits_triton import (
+        warmup_fp8_mqa_logits_triton_all_variants,
+    )
+
+    n = warmup_fp8_mqa_logits_triton_all_variants(num_heads, head_dim, device)
+    _PREFILL_LOGITS_WARMED.add(key)
+    logger.info_once(
+        "kpool indexer: pre-compiled %d prefill MQA-logits specializations "
+        "(num_heads=%d, head_dim=%d).",
+        n,
+        num_heads,
+        head_dim,
+    )
+
+
