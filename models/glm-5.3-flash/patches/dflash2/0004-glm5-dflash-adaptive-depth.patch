+    def _select_adaptive_k(self) -> int:
+        """Adaptive DFlash depth: this step's verification width.
+
+        Load width from every request the server holds (running + waiting),
+        narrowed by acceptance when enabled, then capped by the drafts the
+        step's requests actually carry (a uniform batch needs one width).
+        Only requests that may be scheduled in this step are looked at and
+        truncated: under PP + async scheduling the others are still in flight
+        and get fresh full-width placeholders when they are next scheduled.
+        Truncating ``spec_token_ids`` only drops drafts from verification;
+        it never adds or alters a token, so the output stays the target's.
+        """
+        policy = self.adaptive_k
+        assert policy is not None
+        eligible = [
+            r
+            for r in self.running
+            if self.current_step >= r.next_decode_eligible_step
+        ]
+        if not eligible:
+            return self.num_spec_tokens
+        num_reqs = len(self.running) + len(self.waiting) + len(self.skipped_waiting)
+        decoding = [
+            r.request_id
+            for r in eligible
+            if not r.is_prefill_chunk and r.spec_token_ids
+        ]
+        k_want = policy.want(num_reqs, decoding)
+        available = min(
+            (len(r.spec_token_ids) for r in eligible if r.spec_token_ids),
+            default=k_want,
+        )
+        k = k_want if available >= k_want else policy.snap(available)
+        for request in eligible:
+            if len(request.spec_token_ids) > k:
+                # Rebind, never mutate: AsyncScheduler shares one placeholder
+                # list between requests.
+                request.spec_token_ids = request.spec_token_ids[:k]
+        if decoding:
+            policy.record_choice(k)
+            policy.maybe_log()
+        return k
+
