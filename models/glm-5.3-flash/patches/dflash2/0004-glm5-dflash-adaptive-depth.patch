@@ -0,0 +1,341 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Load- and acceptance-adaptive DFlash verification depth (host-side).
+
+Ported from Morrowmake vllm-cmp170hx (``VLLM_GLM5_DFLASH_ADAPTIVE_K``),
+trimmed to the two modes the GLM-5.3-Flash + DFlash2 deployment uses:
+
+* **load mode** (``by_load``): the verification depth for 1, 2, ... requests
+  in the server (running + waiting); the last entry covers every larger count;
+* **acceptance-aware choice** (``accept``, optional, on top of load mode):
+  within the load width, the depth that maximises the batch's expected
+  committed tokens per unit of measured step cost, from each request's own
+  per-draft acceptance (a decayed geometric model).
+
+Everything here is pure Python on the scheduler thread. Nothing changes on the
+device: the drafter always drafts ``num_speculative_tokens`` (the deepest
+depth) in one fixed-shape pass, and the scheduler only decides how many of
+those drafts the target *verifies* this step (a prefix). Rejection sampling is
+untouched, so every committed token still comes from the target's
+verification -- the choice changes speed, never which tokens are accepted.
+
+Decode runs as uniform full CUDA graphs, so a step uses one depth for all its
+requests; ``allowed`` lists the depths that may be chosen and hence the query
+lengths the target captures decode graphs for (see ``max_reqs_for``).
+"""
+
+from dataclasses import dataclass, field
+from typing import Any
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_CONFIG_KEYS = frozenset({"by_load", "accept", "log_interval"})
+_ACCEPT_KEYS = frozenset(
+    {"costs", "costs_multi", "hysteresis", "prior", "decay", "strength"}
+)
+
+
+@dataclass
+class AdaptiveKConfig:
+    """Validated form of ``SpeculativeConfig.adaptive_k``."""
+
+    # Verification width for 1, 2, ... requests; the last covers the rest.
+    by_load: tuple[int, ...] = ()
+    # Depths that may be chosen (= decode query lengths - 1 to capture).
+    allowed: tuple[int, ...] = ()
+    min_k: int = 1
+    max_k: int = 1
+    log_interval: int = 0
+    # Acceptance-aware choice within the load width.
+    accept: bool = False
+    # accept_costs[i]: relative step cost of verifying allowed[i] drafts with
+    # one request in the step; accept_costs_multi for two or more (empty:
+    # accept_costs).
+    accept_costs: tuple[float, ...] = ()
+    accept_costs_multi: tuple[float, ...] = ()
+    accept_hysteresis: float = 0.03
+    accept_prior: float = 0.75
+    accept_decay: float = 0.9
+    accept_strength: float = 2.0
+
+    @property
+    def load_mode(self) -> bool:
+        return bool(self.by_load)
+
+    def k_for_load(self, num_reqs: int) -> int:
+        """Verification width for ``num_reqs`` requests (0 counts as 1)."""
+        return self.by_load[min(max(num_reqs, 1), len(self.by_load)) - 1]
+
+    def max_reqs_for(self, k: int, max_num_reqs: int) -> int:
+        """Largest request count at which depth ``k`` can be verified, so the
+        decode CUDA graphs for ``k`` are needed only up to it (0: never)."""
+        if k not in self.allowed:
+            return 0
+        if k <= self.by_load[-1]:
+            return max_num_reqs
+        widest = 0
+        for n, value in enumerate(self.by_load, start=1):
+            if value >= k:
+                widest = n
+        return min(widest, max_num_reqs)
+
+    @classmethod
+    def from_dict(cls, raw: Any, num_speculative_tokens: int) -> "AdaptiveKConfig":
+        """``num_speculative_tokens`` is the drafted width (the deepest
+        depth); every depth must lie in ``[1, num_speculative_tokens]``."""
+        if not isinstance(raw, dict):
+            raise ValueError(
+                "speculative_config.adaptive_k must be a mapping, e.g. "
+                '{"by_load": [7, 5, 3]}.'
+            )
+        unknown = set(raw) - _CONFIG_KEYS
+        if unknown:
+            raise ValueError(
+                f"Unknown adaptive_k keys {sorted(unknown)}; "
+                f"expected a subset of {sorted(_CONFIG_KEYS)}."
+            )
+        if num_speculative_tokens is None or num_speculative_tokens <= 0:
+            raise ValueError("adaptive_k requires num_speculative_tokens > 0.")
+        raw_by_load = raw.get("by_load")
+        if not isinstance(raw_by_load, (list, tuple)) or not raw_by_load:
+            raise ValueError(
+                "adaptive_k.by_load must be a non-empty list of draft counts "
+                "(for 1, 2, ... requests; the last covers the rest)."
+            )
+        by_load = tuple(int(k) for k in raw_by_load)
+        illegal = sorted({k for k in by_load if not 1 <= k <= num_speculative_tokens})
+        if illegal:
+            raise ValueError(
+                f"adaptive_k.by_load contains {illegal}, outside "
+                f"[1, num_speculative_tokens={num_speculative_tokens}]."
+            )
+        log_interval = int(raw.get("log_interval", 0))
+        if log_interval < 0:
+            raise ValueError("adaptive_k.log_interval must be >= 0.")
+
+        allowed = tuple(sorted(set(by_load)))
+        kwargs: dict[str, Any] = {}
+        raw_accept = raw.get("accept")
+        if raw_accept is not None:
+            if not isinstance(raw_accept, dict):
+                raise ValueError("adaptive_k.accept must be a mapping.")
+            unknown = set(raw_accept) - _ACCEPT_KEYS
+            if unknown:
+                raise ValueError(f"Unknown adaptive_k.accept keys {sorted(unknown)}.")
+            # The acceptance-aware choice may pick any depth between the
+            # shallowest and the deepest load width.
+            allowed = tuple(range(min(by_load), max(by_load) + 1))
+            costs = tuple(float(c) for c in raw_accept.get("costs", ()))
+            if len(costs) != len(allowed) or min(costs, default=0.0) <= 0:
+                raise ValueError(
+                    f"adaptive_k.accept.costs needs one positive cost per "
+                    f"draft count {list(allowed)}, got {list(costs)}."
+                )
+            costs_multi = tuple(
+                float(c) for c in raw_accept.get("costs_multi", ()) or ()
+            )
+            if costs_multi and (
+                len(costs_multi) != len(allowed) or min(costs_multi) <= 0
+            ):
+                raise ValueError(
+                    f"adaptive_k.accept.costs_multi needs one positive cost "
+                    f"per draft count {list(allowed)}, got {list(costs_multi)}."
+                )
+            hysteresis = float(raw_accept.get("hysteresis", 0.03))
+            prior = float(raw_accept.get("prior", 0.75))
+            decay = float(raw_accept.get("decay", 0.9))
+            strength = float(raw_accept.get("strength", 2.0))
+            if not 0.0 <= hysteresis < 1.0:
+                raise ValueError("adaptive_k.accept.hysteresis must be in [0, 1).")
+            if not 0.0 < prior < 1.0 or not 0.0 <= decay < 1.0 or strength <= 0:
+                raise ValueError(
+                    "adaptive_k.accept.prior must be in (0, 1), decay in [0, 1) "
+                    "and strength > 0."
+                )
+            kwargs = dict(
+                accept=True,
+                accept_costs=costs,
+                accept_costs_multi=costs_multi,
+                accept_hysteresis=hysteresis,
+                accept_prior=prior,
+                accept_decay=decay,
+                accept_strength=strength,
+            )
+        return cls(
+            by_load=by_load,
+            allowed=allowed,
+            min_k=min(by_load),
+            max_k=max(by_load),
+            log_interval=log_interval,
+            **kwargs,
+        )
+
+
+@dataclass
+class AdaptiveKPolicy:
+    """Per-request acceptance statistics and the per-step depth choice.
+
+    A request's depth depends only on its own history and on the batch it runs
+    in: new requests start from the fixed configured prior and the hysteresis
+    reference is per request, so an identical request run alone repeats the
+    same depth sequence whatever ran before it.
+    """
+
+    config: AdaptiveKConfig
+    # req_id -> in-flight steps whose drafts were the scheduler's ``[-1] * k``
+    # uniform-decode padding (rejected by construction; not evidence).
+    _pending_padded: dict[str, int] = field(default_factory=dict)
+    # req_id -> decayed accepted-draft count / decayed rejection count.
+    _acc_s: dict[str, float] = field(default_factory=dict)
+    _acc_f: dict[str, float] = field(default_factory=dict)
+    # req_id -> depth this request last ran at (hysteresis reference).
+    _accept_last: dict[str, int] = field(default_factory=dict)
+    # Model-wide observed counts, for the log line only.
+    _obs_s: float = 0.0
+    _obs_f: float = 0.0
+    _k_counts: dict[int, int] = field(default_factory=dict)
+    _steps_since_log: int = 0
+
+    # ---------------------------------------------------------------- feedback
+
+    def mark_padded(self, req_id: str) -> None:
+        """This step's drafts for ``req_id`` are scheduler padding; skip the
+        matching :meth:`observe`. Outputs of a request arrive in the order its
+        steps were scheduled, so a counter suffices even with PP in flight."""
+        self._pending_padded[req_id] = self._pending_padded.get(req_id, 0) + 1
+
+    def observe(self, req_id: str, num_draft_tokens: int, num_accepted: int) -> None:
+        """One verification result: ``num_accepted`` draft tokens (bonus
+        excluded) out of ``num_draft_tokens`` verified."""
+        if num_draft_tokens <= 0:
+            return
+        pending = self._pending_padded.get(req_id)
+        if pending:
+            if pending == 1:
+                del self._pending_padded[req_id]
+            else:
+                self._pending_padded[req_id] = pending - 1
+            return
+        if not self.config.accept:
+            return
+        accepted = min(max(num_accepted, 0), num_draft_tokens)
+        # Geometric model: all-accepted adds successes and no failure, so a
+        # right-censored step needs no correction.
+        rejected = 1.0 if accepted < num_draft_tokens else 0.0
+        d = self.config.accept_decay
+        self._acc_s[req_id] = d * self._acc_s.get(req_id, 0.0) + accepted
+        self._acc_f[req_id] = d * self._acc_f.get(req_id, 0.0) + rejected
+        gd = 0.999
+        self._obs_s = gd * self._obs_s + accepted
+        self._obs_f = gd * self._obs_f + rejected
+
+    def forget(self, req_id: str) -> None:
+        self._pending_padded.pop(req_id, None)
+        self._acc_s.pop(req_id, None)
+        self._acc_f.pop(req_id, None)
+        self._accept_last.pop(req_id, None)
+
+    # ------------------------------------------------- acceptance-aware depth
+
+    def accept_prior(self) -> float:
+        return self.config.accept_prior
+
+    def observed_acceptance(self) -> float:
+        total = self._obs_s + self._obs_f
+        return self._obs_s / total if total else float("nan")
+
+    def accept_rate(self, req_id: str) -> float:
+        """Per-draft acceptance of ``req_id``, shrunk towards the prior."""
+        a = self.config.accept_strength
+        p0 = self.accept_prior()
+        s = self._acc_s.get(req_id, 0.0)
+        f = self._acc_f.get(req_id, 0.0)
+        return (s + a * p0) / (s + f + a)
+
+    @staticmethod
+    def expected_tokens(p: float, k: int) -> float:
+        """Tokens a step commits at depth k (bonus included) when each draft
+        is accepted with probability p given the earlier ones were."""
+        p = min(max(p, 0.0), 0.999)
+        return (1.0 - p ** (k + 1)) / (1.0 - p)
+
+    def select_by_acceptance(self, req_ids: list[str], cap: int) -> int:
+        """The allowed depth <= ``cap`` that maximises the batch's expected
+        tokens per unit step cost; keeps the requests' last depth unless
+        another beats it by the hysteresis margin."""
+        cfg = self.config
+        table = (
+            cfg.accept_costs_multi
+            if len(req_ids) > 1 and cfg.accept_costs_multi
+            else cfg.accept_costs
+        )
+        candidates = [(k, c) for k, c in zip(cfg.allowed, table) if k <= cap]
+        if not candidates or not req_ids:
+            return cap
+        rates = [self.accept_rate(r) for r in req_ids]
+        scores = {
+            k: sum(self.expected_tokens(p, k) for p in rates) / c
+            for k, c in candidates
+        }
+        best = max(scores, key=lambda k: (scores[k], -k))
+        lasts = {self._accept_last.get(r) for r in req_ids}
+        last = lasts.pop() if len(lasts) == 1 else None
+        if (
+            last is not None
+            and last in scores
+            and last != best
+            and scores[best] <= scores[last] * (1.0 + cfg.accept_hysteresis)
+        ):
+            best = last
+        for r in req_ids:
+            self._accept_last[r] = best
+        return best
+
+    # ------------------------------------------------------------------ policy
+
+    def snap(self, k: int) -> int:
+        """Round ``k`` down to the nearest allowed depth (one with graphs);
+        the smallest allowed depth if ``k`` is below all of them."""
+        best = self.config.allowed[0]
+        for value in self.config.allowed:
+            if value > k:
+                break
+            best = value
+        return best
+
+    def want(self, num_reqs_in_server: int, decoding_req_ids: list[str]) -> int:
+        """Depth wanted for a step: the load width, narrowed by acceptance."""
+        k = self.config.k_for_load(num_reqs_in_server)
+        if self.config.accept and decoding_req_ids:
+            k = self.select_by_acceptance(decoding_req_ids, k)
+        return k
+
+    # ----------------------------------------------------------------- logging
+
+    def record_choice(self, k: int) -> None:
+        self._k_counts[k] = self._k_counts.get(k, 0) + 1
+        self._steps_since_log += 1
+
+    def maybe_log(self) -> None:
+        interval = self.config.log_interval
+        if not interval or self._steps_since_log < interval:
+            return
+        total = sum(self._k_counts.values()) or 1
+        hist = " ".join(
+            f"k={k}:{n}({100 * n / total:.0f}%)"
+            for k, n in sorted(self._k_counts.items())
+        )
+        mean_k = sum(k * n for k, n in self._k_counts.items()) / total
+        logger.info(
+            "Adaptive DFlash depth: %d steps, mean k=%.2f, per-draft "
+            "acceptance observed=%.3f (prior %.2f), %s",
+            total,
+            mean_k,
+            self.observed_acceptance(),
+            self.accept_prior(),
+            hist,
+        )
+        self._k_counts.clear()
+        self._steps_since_log = 0
