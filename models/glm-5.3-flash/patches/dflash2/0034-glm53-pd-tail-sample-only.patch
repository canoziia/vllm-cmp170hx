diff --git a/vllm/v1/worker/gpu/glm_pd_tail.py b/vllm/v1/worker/gpu/glm_pd_tail.py
new file mode 100644
index 0000000..640e0db
--- /dev/null
+++ b/vllm/v1/worker/gpu/glm_pd_tail.py
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Logical GLM tail cache views; independent of physical allocator block IDs.
+
+Only request-owned destination pages may be restored. The scheduler/connector
+must finish ordinary prefix retrieval before scattering these views. This
+module does not advance KDA, run target forward, or publish prefix checkpoints.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import prod
+
+import torch
+
+from vllm.v1.kv_cache_interface import (
+    AttentionSpec,
+    KpoolTailSpec,
+    MambaSpec,
+    SlidingWindowSpec,
+)
+
+
+@dataclass
+class CacheSelection:
+    name: str
+    cache: torch.Tensor
+    blocks: torch.Tensor
+    offsets: torch.Tensor | None
+
+    def gather(self) -> torch.Tensor:
+        if self.offsets is None:
+            return self.cache[self.blocks].contiguous()
+        return self.cache[self.blocks, :, self.offsets, :].contiguous()
+
+    def scatter(self, value: torch.Tensor) -> None:
+        if value.dtype != self.cache.dtype:
+            raise ValueError(f"tail dtype mismatch for {self.name}")
+        if self.offsets is None:
+            expected = (self.blocks.numel(), *self.cache.shape[1:])
+            if tuple(value.shape) != expected:
+                raise ValueError(f"tail shape mismatch for {self.name}")
+            self.cache[self.blocks] = value
+        else:
+            expected = (self.blocks.numel(), self.cache.shape[1], self.cache.shape[3])
+            if tuple(value.shape) != expected:
+                raise ValueError(f"tail shape mismatch for {self.name}")
+            self.cache[self.blocks, :, self.offsets, :] = value
+
+
+class GLMTailLayout:
+    """Read the runner's original [block, head, state, content] cache views.
+
+    Cache registration can normalize/re-view tensors for LMCache. Keep a shallow
+    copy of the original dictionary before registering the ordinary connector.
+    Never derive a manager block ID from the normalized connector tensor shape.
+    """
+
+    def __init__(self, kv_cache_config, caches: dict[str, torch.Tensor],
+                 block_tables, chunk_size: int = 5120):
+        self.config = kv_cache_config
+        self.caches = dict(caches)
+        self.tables = block_tables
+        self.chunk_size = chunk_size
+        self.layers = []
+        for gid, group in enumerate(kv_cache_config.kv_cache_groups):
+            specs = getattr(group.kv_cache_spec, "kv_cache_specs", None)
+            for name in sorted(group.layer_names):
+                if name not in caches:
+                    continue
+                spec = specs[name] if specs is not None else group.kv_cache_spec
+                if not isinstance(spec, (AttentionSpec, MambaSpec)):
+                    raise ValueError(f"unsupported tail cache {name}: {type(spec)}")
+                cache = caches[name]
+                if cache.ndim != 4:
+                    raise ValueError(f"tail requires original 4D cache: {name}")
+                if isinstance(spec, MambaSpec) and spec.mamba_cache_mode != "align":
+                    raise ValueError("tail resume requires Mamba align mode")
+                self.layers.append((gid, name, spec, cache))
+
+    def descriptor(self) -> list[tuple]:
+        """Stable layout fingerprint components, excluding allocator addresses."""
+        return [(name, type(spec).__name__, spec.block_size,
+                 spec.tokens_per_state, tuple(cache.shape[1:]), str(cache.dtype),
+                 tuple(getattr(spec, "shapes", ())))
+                for _, name, spec, cache in self.layers]
+
+    def selections(self, req_index: int, length: int,
+                   block_ids: tuple[list[int], ...] | None = None) -> list[CacheSelection]:
+        if length <= 0:
+            raise ValueError("tail snapshot needs a nonempty prompt")
+        result = []
+        prefix = length // self.chunk_size * self.chunk_size
+        # An exact multiple needs the last chunk's live recurrent state too;
+        # keep its positional bytes to avoid relying on retention conventions.
+        if prefix == length:
+            prefix = max(0, prefix - self.chunk_size)
+        for gid, name, spec, cache in self.layers:
+            if block_ids is None:
+                table = self.tables.block_tables[gid].gpu[req_index]
+                kernel_span = self.tables.kernel_block_sizes[gid]
+                ratio = spec.block_size // kernel_span
+                manager_table = table[::ratio] // ratio
+            else:
+                manager_table = torch.tensor(block_ids[gid], device=cache.device,
+                                             dtype=torch.int64)
+            if isinstance(spec, MambaSpec):
+                column = (length - 1) // spec.block_size
+                ids = manager_table[column:column + 1].long()
+                result.append(CacheSelection(name, cache, ids, None))
+                continue
+            if isinstance(spec, KpoolTailSpec):
+                # A non-pruned one-block ring, not a sequence-positioned page.
+                ids = manager_table[:1].long()
+                result.append(CacheSelection(name, cache, ids, None))
+                continue
+            start = prefix
+            if isinstance(spec, SlidingWindowSpec):
+                start = max(0, length - spec.sliding_window)
+            step = spec.tokens_per_state
+            if step <= 0:
+                raise ValueError(f"invalid positional cache stride: {name}")
+            positions = torch.arange(
+                (start + step - 1) // step * step, length, step,
+                device=cache.device, dtype=torch.int64)
+            span = cache.shape[2] * step
+            if spec.block_size % span:
+                raise ValueError(f"unsupported tail cache span: {name}")
+            ids = (manager_table[positions // spec.block_size].long()
+                   * (spec.block_size // span)
+                   + positions.remainder(spec.block_size) // span)
+            offsets = positions.remainder(span) // step
+            result.append(CacheSelection(name, cache, ids, offsets))
+        return result
+
+    def max_payload_bytes(self) -> int:
+        total = 0
+        for _, _, spec, cache in self.layers:
+            size = cache.element_size()
+            if isinstance(spec, (MambaSpec, KpoolTailSpec)):
+                total += prod(cache.shape[1:]) * size
