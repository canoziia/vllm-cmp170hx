+++ b/vllm/v1/attention/backends/mla/req_id_per_token.py
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Device-side ``req_id_per_token`` for the Triton/XPU sparse-MLA builder.
+
+Opt-in with ``VLLM_GLM5_SPARSE_MLA_DEVICE_REQ_IDS=1`` (patch 0020). Default
+**off**: ``XPUMLASparseMetadataBuilder.build`` keeps its host path, i.e.
+
+    req_id_per_token = np.repeat(arange(num_reqs), diff(query_start_loc_cpu))
+    buffer.fill_(0)                                   # 1 fill kernel
+    buffer[:n].copy_(pinned(req_id_per_token))        # 1 pinned HtoD
+
+every step, for every sparse-MLA KV-cache group on the rank. Here one Triton
+launch derives the same int32 values from the device ``query_start_loc``
+(token ``t`` belongs to the request ``j`` with ``qsl[j] <= t < qsl[j+1]``,
+i.e. ``j = #{r in 1..R : qsl[r] <= t}``) and writes zeros past
+``qsl[R]``, over the whole buffer -- exactly what the fill + copy leave.
+
+Equality needs the device ``query_start_loc`` to hold the same bytes as the
+host copy. That holds in the V1/V2 runners except under adaptive
+verification, which rewrites the device copy (``reallocate_drafts``); the
+builder therefore keeps the host path when that is enabled.
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+
+import numpy as np
+import torch
+
+try:  # pragma: no cover - GPU only
+    from vllm.triton_utils import tl, triton
+
+    _HAS_TRITON = triton is not None and tl is not None and hasattr(triton, "jit")
+except Exception:  # pragma: no cover
+    _HAS_TRITON = False
+
+_TRUE = ("1", "true", "yes", "on")
+
+
+@functools.cache
+def enabled() -> bool:
+    return (
+        os.getenv("VLLM_GLM5_SPARSE_MLA_DEVICE_REQ_IDS", "0").strip().lower() in _TRUE
+    )
+
+
+def req_id_per_token_ref(
+    query_start_loc_cpu: torch.Tensor, buffer_len: int
+) -> torch.Tensor:
+    """The upstream host computation, materialised over the whole buffer."""
+    starts = np.asarray(query_start_loc_cpu, dtype=np.int32)
+    seg = np.diff(starts)
+    ids = np.repeat(np.arange(seg.shape[0], dtype=np.int32), seg)
+    out = torch.zeros(buffer_len, dtype=torch.int32)
+    out[: ids.shape[0]] = torch.from_numpy(ids)
+    return out
+
+
+if _HAS_TRITON:  # pragma: no cover - GPU only
+
+    @triton.jit
+    def _req_id_per_token_kernel(
+        qsl_ptr,
+        out_ptr,
+        num_reqs,
+        buffer_len,
+        BLOCK: tl.constexpr,
+    ):
+        offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+        keep = offs < buffer_len
+        cnt = tl.zeros([BLOCK], dtype=tl.int32)
+        for r in range(0, num_reqs):
+            start = tl.load(qsl_ptr + r + 1)
+            cnt += (start <= offs).to(tl.int32)
+        total = tl.load(qsl_ptr + num_reqs)
+        val = tl.where(offs < total, cnt, 0)
+        tl.store(out_ptr + offs, val, mask=keep)
+
+
+def fill_req_id_per_token(
+    query_start_loc: torch.Tensor, num_reqs: int, buffer: torch.Tensor
+) -> bool:
+    """Write the per-token request ids for ``query_start_loc[: num_reqs + 1]``
+    into the whole ``buffer``. Returns False (nothing written) when the
+    device path does not apply, so the caller runs its host path."""
+    if not (
+        _HAS_TRITON
+        and query_start_loc.is_cuda
+        and buffer.is_cuda
+        and buffer.dtype == torch.int32
+        and buffer.is_contiguous()
+        and query_start_loc.is_contiguous()
+        and query_start_loc.dtype == torch.int32
+        and query_start_loc.shape[0] >= num_reqs + 1
+        and num_reqs >= 0
+    ):
+        return False
+    n = buffer.shape[0]
+    block = 1024
+    _req_id_per_token_kernel[(triton.cdiv(n, block),)](
+        query_start_loc, buffer, num_reqs, n, BLOCK=block
+    )
+    return True
