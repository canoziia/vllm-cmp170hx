         assert self.head_dim == 128 and self.quant_block_size == 128
         assert self.scale_fmt == "ue8m0"
         q = q.view(-1, self.head_dim)
-        q_fp8, q_scale = fwht128_quant_fp8(q)
+        from vllm.models.glm5next.nvidia.ops import idx_glue
+
+        wscale = self.softmax_scale * self.n_head**-0.5
+        if (idx_glue.enabled() and q.shape[0] <= 4096
+                and q.dtype == torch.bfloat16 and q.is_contiguous()
+                and weights.dtype == torch.float32
+                and idx_glue.is_pow2_float(wscale)):
+            q_fp8, weights = idx_glue.fwht128_quant_fp8_wscale(
