diff --git a/vllm/models/glm5next/nvidia/ops/moe_sum_add.py b/vllm/models/glm5next/nvidia/ops/moe_sum_add.py
new file mode 100644
index 0000000..6f6dc6c
--- /dev/null
+++ b/vllm/models/glm5next/nvidia/ops/moe_sum_add.py
@@ -0,0 +1,149 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Routed ``moe_sum`` fused with the shared-expert add (VLLM_GLM5_MOE_SUM_ADD).
+
+Port of Morrowmake's ``idx_glue`` "moesum" item (mm-vllm
+``vllm/ampere_decode/idx_glue.py:728-796`` and the runner hand-off in
+``fused_moe/runner/moe_runner.py:868-948``), restricted to the compiled sm_80
+Marlin decode (``marlin_decode.run``).
+
+Incumbent per MoE layer (decode, shared experts present, no reduction or
+transform between the experts and the add):
+
+    moe_sum_vec_kernel   c3[M, topk, H] -> routed[M, H]   (fp32 slot-order sum,
+                                                           one bf16 rounding)
+    elementwise add      shared + routed                  (fp32 opmath,
+                                                           one bf16 rounding)
+
+Fused: one Triton launch computing exactly the same two roundings:
+
+    out = bf16( f32(shared) + f32( bf16( sum_{k=0..topk-1} f32(c3[t, k]) ) ) )
+
+The slot order (k = 0, 1, ..., topk-1, accumulator starting at +0.0) and both
+rounding points are the incumbent's, so the result is bitwise identical (no
+summation order change).  ``tests/step/gpu_moe_sum_add.py`` checks this.
+Note: Triton 3.x folds the final ``bf16(f32(a) + f32(b))`` into
+``fma.rn.bf16 a*1.0+b`` (a single rounding).  For addition, rounding the
+fp32 sum and then to bf16 equals rounding the exact sum once (fp32 has
+24 >= 2*8+2 significand bits, Figueroa's double-rounding bound), so this is
+still the incumbent's result bit for bit.
+
+Hand-off: ``MoERunner.forward`` arms ``DEFERRAL`` around its experts call when
+the gate below holds; ``marlin_decode.run`` offers its ``c3`` instead of
+summing (only the first offer after an arm is taken); the runner takes it
+back and either fuses with the shared output or, if the shapes do not fit,
+performs the deferred sum exactly as before.  Single-threaded host state, read
+only while enqueuing; inside a CUDA graph capture the decision is baked in per
+captured size exactly like every other Python branch of the forward.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+_ENABLED: bool | None = None
+MAX_TOKENS = 32
+
+
+def enabled() -> bool:
+    """VLLM_GLM5_MOE_SUM_ADD=1 (default off; read once)."""
+    global _ENABLED
+    if _ENABLED is None:
+        _ENABLED = os.getenv("VLLM_GLM5_MOE_SUM_ADD", "0").strip() == "1"
+    return _ENABLED
+
+
+@triton.jit
+def _moe_sum_add_kernel(out_ptr, in_ptr, sh_ptr, H, s_tok, s_topk, s_h,
+                        sh_s0, sh_s1, out_s0,
+                        TOPK: tl.constexpr, BLOCK_H: tl.constexpr):
+    t = tl.program_id(0)
+    h = tl.program_id(1) * BLOCK_H + tl.arange(0, BLOCK_H)
+    mask = h < H
+    base = in_ptr + t.to(tl.int64) * s_tok + h * s_h
+    acc = tl.zeros([BLOCK_H], tl.float32)
+    for k in tl.static_range(TOPK):
+        acc += tl.load(base + k * s_topk, mask=mask, other=0.0).to(tl.float32)
+    # bf16 rounding of the routed sum, as moe_sum_vec_kernel stores it
+    routed = acc.to(out_ptr.dtype.element_ty).to(tl.float32)
+    sh = tl.load(sh_ptr + t.to(tl.int64) * sh_s0 + h * sh_s1, mask=mask,
+                 other=0.0).to(tl.float32)
+    tl.store(out_ptr + t.to(tl.int64) * out_s0 + h,
+             (sh + routed).to(out_ptr.dtype.element_ty), mask=mask)
+
+
+def moe_sum_add(inp: torch.Tensor, shared: torch.Tensor,
+                out: torch.Tensor | None = None) -> torch.Tensor:
+    """``shared + moe_sum(inp)`` in one launch; ``inp`` [M, topk, H]."""
+    M, topk, H = inp.shape
+    assert shared.shape == (M, H) and shared.dtype == inp.dtype
+    if out is None:
+        out = torch.empty((M, H), dtype=inp.dtype, device=inp.device)
+    assert out.shape == (M, H) and out.stride(1) == 1
+    if M == 0:
+        return out
+    block_h = 256 if H >= 256 else max(16, triton.next_power_of_2(H))
+    _moe_sum_add_kernel[(M, triton.cdiv(H, block_h))](
+        out, inp, shared, H, inp.stride(0), inp.stride(1), inp.stride(2),
+        shared.stride(0), shared.stride(1), out.stride(0),
+        TOPK=topk, BLOCK_H=block_h, num_warps=4, num_stages=1,
+    )
+    return out
+
+
+def flush(inp: torch.Tensor, out: torch.Tensor) -> None:
+    """The deferred sum done exactly as the incumbent (``ops.moe_sum``)."""
+    from vllm import _custom_ops as ops
+
+    ops.moe_sum(inp, out)
+
+
+class _MoeSumDeferral:
+    def __init__(self) -> None:
+        self.armed = False
+        self.pending: tuple[torch.Tensor, torch.Tensor] | None = None
+
+    def arm(self) -> None:
+        self.armed = True
+        self.pending = None
+
+    def offer(self, inp: torch.Tensor, out: torch.Tensor) -> bool:
+        if not self.armed:
+            return False
+        self.armed = False
+        self.pending = (inp, out)
+        return True
+
+    def take(self) -> tuple[torch.Tensor, torch.Tensor] | None:
+        self.armed = False
+        p, self.pending = self.pending, None
+        return p
+
+
+DEFERRAL = _MoeSumDeferral()
+
+
+def can_fuse(inp: torch.Tensor, shared: torch.Tensor | None) -> bool:
+    return (
+        shared is not None
+        and shared.dim() == 2
+        and inp.dim() == 3
+        and shared.dtype == inp.dtype
+        and shared.shape[0] == inp.shape[0]
+        and shared.shape[1] == inp.shape[2]
+        and shared.stride(1) == 1
+    )
+
+
+def warmup(device, hidden: int = 4096, topk: int = 8) -> None:
+    """Compile the Triton binary outside any CUDA graph capture."""
+    if not enabled() or torch.cuda.is_current_stream_capturing():
+        return
+    for m in (1, 8):
+        x = torch.zeros((m, topk, hidden), dtype=torch.bfloat16, device=device)
+        s = torch.zeros((m, hidden), dtype=torch.bfloat16, device=device)
+        moe_sum_add(x, s)
