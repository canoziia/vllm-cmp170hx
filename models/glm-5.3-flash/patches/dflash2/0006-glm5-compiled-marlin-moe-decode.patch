+    # Comma-separated token counts (1..32) that take the compiled path.
+    "VLLM_GLM5_MARLIN_DECODE_TOKENS": lambda: os.getenv(
+        "VLLM_GLM5_MARLIN_DECODE_TOKENS", "4,8"
