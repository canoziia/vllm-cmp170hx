+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        device: torch.device,
+        stage: int,
+        pp_rank: int,
+        pp_size: int,
+    ) -> None:
+        self.vllm_config = vllm_config
+        self.device = device
+        self.stage = stage
+        self.pp_rank = pp_rank
+        self.pp_size = pp_size
+        self.is_last = pp_rank == pp_size - 1
+        self.is_tail = pp_rank == stage
+        self.live = False
+        spec = vllm_config.speculative_config
+        assert spec is not None
+        self.num_steps = int(spec.num_speculative_tokens)
+        self.max_rows = vllm_config.scheduler_config.max_num_seqs
+        self.rows_table: dict[int, int] | None = None
+        self.layout: TailPayloadLayout | None = None
+        self.module: DraftTailModule | None = None
+        self.speculator = None
+        self.handler = None  # the stage's PPHandler (communicator, stream)
+        self._workspaces: dict = {}
+        self._out_tokens: torch.Tensor | None = None
+        self._scores: torch.Tensor | None = None
+        self._warned_rows = False
+        self._prepared = False
+
+    @classmethod
+    def create(
+        cls,
+        vllm_config: VllmConfig,
+        device: torch.device,
+        pp_rank: int,
+        pp_size: int,
+    ) -> DraftTailController | None:
+        from vllm import envs
+
+        stage = draft_tail_stage(vllm_config, envs.VLLM_PP_DRAFT_TAIL_STAGE)
