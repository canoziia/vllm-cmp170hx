+                # Aux layer ids are "capture after layer i", encoded as i + 1
+                # (eagle3_utils.get_eagle3_aux_layers_from_config adds 1 to
+                # the drafter's dflash_config.target_layer_ids).
+                if layer.layer_idx + 1 in aux_layers:
+                    aux_hidden_states.append(
+                        self._capture_aux_hidden_state(
