# vLLM production-stack router, pinned to a release tag; we build our own image
# so the patch series below is part of the shipped code.
ROUTER_VERSION=vllm-stack-0.1.13
ROUTER_PIP_SPEC="vllm-router @ https://codeload.github.com/vllm-project/production-stack/tar.gz/refs/tags/${ROUTER_VERSION}"
ROUTER_BASE_IMAGE=docker.1ms.run/library/python:3.12-slim
DEFAULT_ROUTER_OUTPUT_IMAGE=localhost/vllm-router
