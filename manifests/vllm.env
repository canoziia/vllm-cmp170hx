# Official upstream vLLM base source & Docker image (pinned by commit and immutable digest).
# Upstream commit: https://github.com/vllm-project/vllm/commit/9c1d45c21836370104d4eb51d3b46eda20719c47
# Official base image: Python 3.12 / CUDA 13.2.1 / PyTorch 2.14.0 / SM80 (TORCH_CUDA_ARCH_LIST includes 8.0)
SOURCE_REPO=https://github.com/vllm-project/vllm.git
SOURCE_COMMIT=9c1d45c21836370104d4eb51d3b46eda20719c47

BASE_IMAGE_TAG=docker.io/vllm/vllm-openai:nightly-9c1d45c21836370104d4eb51d3b46eda20719c47
BASE_IMAGE=docker.io/vllm/vllm-openai@sha256:663d493862a5d2c3f212f28d1bf5a5fd76dff08ec76dd1ebd72a7d230621be9a
VLLM_EXPECTED_PYTHON=3.12
VLLM_EXPECTED_CUDA=13.2

# Patched vLLM branch in this repository (feature commits on top of SOURCE_COMMIT)
VLLM_BRANCH_REPO=https://github.com/canoziia/vllm-sm80.git
VLLM_BRANCH=vllm
VLLM_BRANCH_COMMIT=53498d6d2f371f9f74d57831a9613d4bb83e87d5

# Default local and GHCR output image names
DEFAULT_OUTPUT_IMAGE=localhost/vllm-sm80:latest
GHCR_OUTPUT_IMAGE=ghcr.io/canoziia/vllm-sm80:latest
