# Copy to .env next to compose.yml, chmod 600. Never commit the real file.

# Grafana admin (required, no default password)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# vLLM /metrics targets: NAME=HOST:PORT[;server=..;model=..;role=..;path=..],...
# NAME becomes the `instance` label. role defaults to prefill/decode when NAME
# contains it, else unified; model defaults to NAME minus -prefill/-decode/-nodeN.
VLLM_METRICS_TARGETS=deepseek=162.105.151.147:8000,qwen-node1=162.105.151.147:8001,glm-prefill=162.105.151.94:8301,glm-decode=162.105.151.94:8302,qwen-node2=162.105.151.94:8001
# HOST -> `server` label (unknown hosts keep the address)
VLLM_SERVER_NAMES=162.105.151.147=node1,162.105.151.94=node2,127.0.0.1=node2

# Optional extra jobs, same format. LMCache/router bind 127.0.0.1, so only the
# node running this stack can scrape its own ones.
ROUTER_METRICS_TARGETS=glm-router=127.0.0.1:9103;model=glm
LMCACHE_METRICS_TARGETS=glm-lmcache=127.0.0.1:18559;model=glm,qwen-lmcache=127.0.0.1:18557;model=qwen
# with `--profile gpu`: GPU_METRICS_TARGETS=node2-gpu=127.0.0.1:19835
GPU_METRICS_TARGETS=

# vLLM --api-key only guards /v1/*; /metrics needs no token. If a proxy in
# front requires one, put it in a 0600 file and point here.
#VLLM_METRICS_TOKEN_FILE=/root/app/monitoring-secrets/vllm_metrics_token

# Storage (bind mounts, podman :U chowns them) and retention
MONITORING_DATA_DIR=/root/app/monitoring-data
PROM_RETENTION=180d
PROM_RETENTION_SIZE=50GB
PROM_SCRAPE_INTERVAL=10s

# Listen addresses (host network). Prometheus has no auth: keep it local.
PROM_LISTEN=127.0.0.1
PROM_PORT=19090
GRAFANA_LISTEN=0.0.0.0
GRAFANA_PORT=13000
#GRAFANA_ROOT_URL=https://grafana.example.org/
GPU_EXPORTER_LISTEN=127.0.0.1
GPU_EXPORTER_PORT=19835
