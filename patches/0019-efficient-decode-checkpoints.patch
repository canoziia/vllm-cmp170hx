+@triton.jit
+def _cap_decode_acceptance(idx_mapping, computed, qstart, prompt_len, sampled,
+                           rejected, UNIT: tl.constexpr):
+    row = tl.program_id(0)
+    slot = tl.load(idx_mapping + row)
+    if slot < 0:
+        return
+    start = tl.load(computed + slot)
+    prompt = tl.load(prompt_len + slot)
+    if start < prompt:
+        return
+    count = tl.load(sampled + row)
+    cap = UNIT - start % UNIT
+    keep = tl.minimum(count, cap)
+    tl.store(sampled + row, keep)
+    tl.store(rejected + row, tl.load(rejected + row) + count - keep)
+
 
