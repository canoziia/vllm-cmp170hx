+def test_async_structured_draft_handoff_without_prior_output(
+    structured: bool,
+    prior_placeholders: int,
+    drafts: list[int],
+    expected_pending: bool,
+):
+    """A worker-side -1 draft needs backfill even after all outputs settled.
+
+    Under PP async, the previous verification may reject all three drafts and
+    deliver one target token, leaving zero outstanding output placeholders.
+    The next batch still has three worker-side draft placeholders: sampling
+    before taking the real ids would make the fail-closed grammar cap zero and
+    permanently lock the request into one-token steps.
+    """
+    scheduler = object.__new__(AsyncScheduler)
+    request = SimpleNamespace(
+        is_prefill_chunk=False,
+        use_structured_output=structured,
+        num_output_placeholders=prior_placeholders,
