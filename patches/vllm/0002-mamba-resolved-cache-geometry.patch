From 28a43f7118fb22e90be28bcf57a4942d94e9bc3d Mon Sep 17 00:00:00 2001
From: dsv41-builder <root@localhost>
Date: Wed, 23 Sep 2026 03:13:52 +0800
Subject: [PATCH] mamba: seed resumed state from resolved cache geometry

Bind the resolved KV cache configuration before requests are admitted and compute align-mode state columns from MambaSpec.block_size rather than the smallest global cache group.

Assisted-by: OpenAI Codex <noreply@openai.com>
---
 vllm/v1/worker/gpu/model_runner.py            |  1 +
 vllm/v1/worker/gpu/model_states/interface.py  |  5 ++
 .../worker/gpu/model_states/mamba_hybrid.py   | 48 +++++++++----------
 3 files changed, 28 insertions(+), 26 deletions(-)

diff --git a/vllm/v1/worker/gpu/model_runner.py b/vllm/v1/worker/gpu/model_runner.py
index cdc4ffe8..0fd9a586 100644
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -699,6 +699,7 @@ class GPUModelRunner(LoRAModelRunnerMixin):
             self.vllm_config,
             self.device,
         )
+        self.model_state.set_kv_cache_config(self.kv_cache_config)
         additional_attn_cg_support = self.model_state.get_additional_cg_support()
         attn_cg_support = attn_cg_support.narrow(*additional_attn_cg_support)
         # The speculator clears the flag at load time when the checkpoint has
diff --git a/vllm/v1/worker/gpu/model_states/interface.py b/vllm/v1/worker/gpu/model_states/interface.py
index a5c8d6f4..60ac9d57 100644
--- a/vllm/v1/worker/gpu/model_states/interface.py
+++ b/vllm/v1/worker/gpu/model_states/interface.py
@@ -126,6 +126,11 @@ class ModelState(ABC):
     def apply_staged_writes(self) -> None:
         return None
 
+    def set_kv_cache_config(self, kv_cache_config: KVCacheConfig) -> None:
+        """Hook run once the runner binds a KV cache config, before any
+        request is added. No-op by default."""
+        return None
+
     def get_additional_cg_support(self) -> tuple[AttentionCGSupport, str | None]:
         """Cudagraph support of attention groups this ModelState builds outside
         ``init_attn_backend`` (e.g. encoder-only layers).
diff --git a/vllm/v1/worker/gpu/model_states/mamba_hybrid.py b/vllm/v1/worker/gpu/model_states/mamba_hybrid.py
index 604f50ff..86ba9a5b 100644
--- a/vllm/v1/worker/gpu/model_states/mamba_hybrid.py
+++ b/vllm/v1/worker/gpu/model_states/mamba_hybrid.py
@@ -110,40 +110,36 @@ class MambaHybridModelState(DefaultModelState):
             self._mamba_ctx: MambaSpecDecodeGPUContext | None = None
             self._mamba_group_ids: list[int] = []
             self._mamba_spec: MambaSpec | None = None
-            self._mamba_block_size = (
-                self.cache_config.mamba_block_size or self.cache_config.block_size
-            )
             self._mamba_state_copy_funcs: MambaStateCopyFuncsByType | None = None
 
+    def set_kv_cache_config(self, kv_cache_config: KVCacheConfig) -> None:
+        if not self._align_mode:
+            return
+        mamba_groups = get_mamba_groups(kv_cache_config)
+        mamba_spec = next(iter(mamba_groups))
+        assert all(
+            spec.block_size == mamba_spec.block_size
+            and spec.num_speculative_blocks == mamba_spec.num_speculative_blocks
+            and spec.mamba_cache_mode == mamba_spec.mamba_cache_mode
+            for spec in mamba_groups
+        ), "all mamba groups must share cache scheduling parameters"
+        self._mamba_group_ids = get_mamba_group_ids(mamba_groups)
+        self._mamba_spec = mamba_spec
+
     def add_request(self, req_index: int, new_req_data: NewRequestData) -> None:
         super().add_request(req_index, new_req_data)
         # Must reset the speculative acceptance count in this idx which could be stale.
         self.num_accepted_tokens_gpu[req_index].fill_(1)
         if self._align_mode:
-            # Seed the running state block from the resumed/prefilled position.
-            # The divisor must be the mamba group's block size, not the
-            # attention block size: on hybrids they differ, and a resume over a
-            # cached prefix would otherwise seed an out-of-range block_table
-            # column that the fused align pre-copy reads as a garbage block id
-            # (vllm#53142).
+            # The align block table is laid out in Mamba blocks, which page
+            # unification can make larger than cache_config.block_size.
+            _, mamba_spec = self._get_mamba_group_info()
             self._mamba_state_idx_gpu[req_index].fill_(
-                (new_req_data.num_computed_tokens - 1) // self._mamba_block_size
+                (new_req_data.num_computed_tokens - 1) // mamba_spec.block_size
             )
 
-    def _get_mamba_group_info(
-        self, kv_cache_config: KVCacheConfig
-    ) -> tuple[list[int], MambaSpec]:
-        if self._mamba_spec is None:
-            mamba_groups = get_mamba_groups(kv_cache_config)
-            mamba_spec = next(iter(mamba_groups))
-            assert all(
-                spec.block_size == mamba_spec.block_size
-                and spec.num_speculative_blocks == mamba_spec.num_speculative_blocks
-                and spec.mamba_cache_mode == mamba_spec.mamba_cache_mode
-                for spec in mamba_groups
-            ), "all mamba groups must share cache scheduling parameters"
-            self._mamba_group_ids = get_mamba_group_ids(mamba_groups)
-            self._mamba_spec = mamba_spec
+    def _get_mamba_group_info(self) -> tuple[list[int], MambaSpec]:
+        assert self._mamba_spec is not None, "KV cache config not bound"
         return self._mamba_group_ids, self._mamba_spec
 
     def _ensure_align_ctx(
@@ -206,7 +202,7 @@ class MambaHybridModelState(DefaultModelState):
         num_reqs = input_batch.num_reqs
         if num_reqs == 0:
             return
-        mamba_group_ids, mamba_spec = self._get_mamba_group_info(kv_cache_config)
+        mamba_group_ids, mamba_spec = self._get_mamba_group_info()
         ctx = self._ensure_align_ctx(kv_cache_config, mamba_group_ids, block_tables)
 
         # The state-advance + pre-copy kernels run every step; they fast-exit per
@@ -296,7 +292,7 @@ class MambaHybridModelState(DefaultModelState):
             num_decode_draft_tokens_cpu = torch.from_numpy(num_decode_draft_tokens_np)
 
         if self._align_mode:
-            mamba_group_ids, _ = self._get_mamba_group_info(kv_cache_config)
+            mamba_group_ids, _ = self._get_mamba_group_info()
             aligned_index_builders = []
             for group_idx, group_id in enumerate(mamba_group_ids):
                 for group in attn_groups[group_id]:
-- 
