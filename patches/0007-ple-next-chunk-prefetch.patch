+    def _make_ple_prefetch(self, input_batch: InputBatch) -> PlePrefetch | None:
+        """Predict one equal-sized future segment for every prefill request."""
+        if (
+            not self._ple_prefetch_enabled
+            or not input_batch.has_prefill
+            or not bool(input_batch.is_prefilling_np.all())
+        ):
+            return None
+        req_ids = list(input_batch.req_ids)
+        req_starts = input_batch.num_computed_prefill_tokens_np.astype(
+            np.int64, copy=False
+        ).tolist()
+        future_req_ids: list[str] = []
+        future_starts: list[int] = []
+        future_token_ids: list[list[int]] = []
+        future_contexts: list[list[int]] = []
+        config = self.vllm_config.model_config.hf_text_config
+        context_len = int(config.ngram_size) - 1
+        eos_token_id = int(config.eos_token_id)
+        for index, req_id in enumerate(req_ids):
+            all_tokens = self._ple_prefill_tokens.get(req_id)
+            num_valid = int(input_batch.num_scheduled_tokens[index])
+            current_start = int(req_starts[index])
+            if (
+                all_tokens is None
+                or num_valid <= 0
+                or current_start + num_valid > int(input_batch.prefill_len_np[index])
+            ):
+                return PlePrefetch(req_ids, req_starts, [], [], [], [])
+            start = current_start + num_valid
+            end = min(start + num_valid, int(input_batch.prefill_len_np[index]))
+            if end <= start:
+                continue
+            context = np.full(context_len, eos_token_id, dtype=np.int32)
+            source = all_tokens[max(0, start - context_len) : start]
+            if source.size:
+                context[-source.size :] = source
+            future_req_ids.append(req_id)
+            future_starts.append(start)
+            future_token_ids.append(all_tokens[start:end].tolist())
+            future_contexts.append(context.tolist())
+        return PlePrefetch(
+            req_ids,
+            req_starts,
+            future_req_ids,
+            future_starts,
+            future_token_ids,
+            future_contexts,
+        )
