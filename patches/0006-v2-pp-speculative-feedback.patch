+@triton.jit
+def _copy_received_drafts_kernel(
+    dst_ptr,
+    src_ptr,
+    idx_ptr,
+    dst_stride,
+    src_stride,
+    NUM_STEPS: tl.constexpr,
+):
+    row = tl.program_id(0)
+    req_idx = tl.load(idx_ptr + row)
+    if req_idx < 0:
+        return
+    offsets = tl.arange(0, triton.next_power_of_2(NUM_STEPS))
+    mask = offsets < NUM_STEPS
+    values = tl.load(src_ptr + row * src_stride + offsets, mask=mask)
+    tl.store(dst_ptr + req_idx * dst_stride + offsets, values, mask=mask)
+
