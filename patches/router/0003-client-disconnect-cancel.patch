+
+
+async def _await_or_disconnect(request: Request, coro, request_id: str, phase: str):
+    """Await a PD hop, or cancel it once the client disconnects.
+
+    The PD counterpart of ``_anext_or_disconnect`` (upstream PR #1040): race the
+    hop against ``http.disconnect`` instead of polling
+    ``request.is_disconnected()``. Cancelling the hop closes its aiohttp
+    connection, so the engine aborts the request. Without a disconnect the
+    hop's result or exception is returned unchanged.
+
+    Raises:
+        ClientDisconnect: If the client disconnected before the hop finished.
+    """
+    started = time.time()
+    hop_task = asyncio.ensure_future(coro)
+    disconnect_task = asyncio.ensure_future(_listen_for_disconnect(request))
+    try:
+        await asyncio.wait(
+            (hop_task, disconnect_task), return_when=asyncio.FIRST_COMPLETED
+        )
+        if hop_task.done():
+            return hop_task.result()
+        logger.warning(
+            f"{_log_safe(request_id)} client disconnected during {phase} after "
+            f"{time.time() - started:.1f}s, aborted the backend request"
+        )
+        raise ClientDisconnect()
+    finally:
+        await _cancel_and_wait(disconnect_task)
+        if not hop_task.done():
+            await _cancel_and_wait(hop_task)
 
 
