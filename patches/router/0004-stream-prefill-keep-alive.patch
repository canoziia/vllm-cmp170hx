+    async def forward_prefill_stream():
+        """Forward the prefill hop's SSE comments; keep only its usage.
+
+        Yields the comment events to send; the 1-token data events and
+        [DONE] are dropped. Returns via StopAsyncIteration; `prefill_failed`
+        is set when an error event was forwarded instead.
+        """
+        nonlocal prefill_failed, et
+        try:
+            async for event in _prefill_stream_events(prefill_stream):
+                lines = [line for line in event.split(b"\n") if line]
+                if lines and all(line.startswith(b":") for line in lines):
+                    yield event + b"\n\n"
+                    continue
+                payload = _prefill_event_payload(event)
+                if payload is None:
+                    continue
+                if "error" in payload:
+                    # vLLM ends a failed stream with [DONE] right after.
+                    prefill_failed = True
+                    yield event + b"\n\ndata: [DONE]\n\n"
+                    return
+                usage = _UsageMergeState._find_usage(payload)
+                if usage is not None:
+                    details = usage.get("prompt_tokens_details")
+                    if isinstance(details, dict):
+                        # The non-streaming prefill hop this replaces reported
+                        # multimodal_tokens (null) here; keep router_hops
+                        # byte-identical.
+                        details.setdefault("multimodal_tokens", None)
+                    merge_state.prefill_usage = usage
+        except asyncio.CancelledError:
+            prefill_stream.close()
+            logger.warning(
+                f"{_log_safe(request_id)} client disconnected during prefill "
+                f"stream after {time.time() - st:.1f}s, aborted the backend request"
+            )
+            raise
+        except Exception as e:
+            prefill_stream.close()
+            logger.error(f"Unexpected error in prefiller: {e}", exc_info=True)
+            prefill_failed = True
+            yield json.dumps(
+                {
+                    "error": {
+                        "message": f"Prefiller error: {str(e)}",
+                        "type": "prefiller_error",
+                        "code": 500,
+                    }
+                }
+            ).encode("utf-8")
+            return
+        finally:
+            prefill_stream.release()
+        et = time.time()
+        logger.info(f"{request_id} prefill time (TTFT): {et - st:.4f}")
+        logger.info(
+            f"Routing request {request_id} with session id None to {request.app.state.prefill_client._base_url} at {et}, process time = {et - in_router_time:.4f}"
+        )
+
+    prefill_failed = False
