+async def open_prefill_stream(
+    client: aiohttp.ClientSession, endpoint: str, req_data: dict, request_id: str
+) -> aiohttp.ClientResponse:
+    """Start the prefill hop of a streaming PD request as an SSE stream.
+
+    Streaming lets the router forward the prefill engine's own SSE keep-alive
+    comments (vLLM --sse-keep-alive-interval) while the prompt is prefilled.
+    The response is returned open, after its headers arrived; the caller reads
+    and closes it.
+    """
+    req_data = req_data.copy()
+    req_data["max_tokens"] = 1
+    if "max_completion_tokens" in req_data:
+        req_data["max_completion_tokens"] = 1
+    req_data.pop("min_tokens", None)
+    req_data["stream"] = True
+    if endpoint.rstrip("/") == "/v1/responses":
+        # The Responses API always reports usage in response.completed.
+        req_data.pop("stream_options", None)
+    else:
+        # 0001 needs the prefill usage, so ask for it whatever the client did.
+        req_data["stream_options"] = {"include_usage": True}
+
+    headers = {
+        "Authorization": f"Bearer {os.environ.get('OPENAI_API_KEY')}",
+        "X-Request-Id": request_id,
+    }
+    return await client.post(endpoint, json=req_data, headers=headers)
+
+
+async def _prefill_stream_events(response: aiohttp.ClientResponse):
+    """Yield the raw SSE events (without the blank-line separator)."""
+    buf = bytearray()
+    async for chunk in response.content.iter_any():
+        buf.extend(chunk.replace(b"\r\n", b"\n"))
+        while True:
+            idx = buf.find(b"\n\n")
+            if idx < 0:
+                break
+            event = bytes(buf[:idx])
+            del buf[: idx + 2]
+            yield event
+    if buf.strip():
+        yield bytes(buf)
+
+
+def _prefill_event_payload(event: bytes):
+    """The JSON payload of a prefill `data:` event, or None."""
+    data = [
+        line[5:].strip()
+        for line in event.split(b"\n")
+        if line.startswith(b"data:")
+    ]
+    if not data or data[-1] == b"[DONE]":
+        return None
+    try:
+        payload = json.loads(b"\n".join(data))
+    except Exception:
+        return None
+    return payload if isinstance(payload, dict) else None
+
