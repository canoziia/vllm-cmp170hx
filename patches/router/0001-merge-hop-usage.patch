From: canoziia <canoziia@users.noreply.github.com>
Subject: [PATCH] router: merge both PD hops usage, for both response families

The client must receive a standard OpenAI body, so the accounting is computed in
the router: the prefill hop response (already fetched, formerly discarded) now
feeds the streamed decode usage.

  prompt_tokens / input_tokens                       = the prompt (hops must agree)
  ..._tokens_details.cached_tokens                   = min(prefill, decode) cached
      -> what was cached before the request; the min removes the intra-request
         prefill->decode handoff from the count
  completion_tokens / output_tokens                  = the decode hop's generation

Everything else - including the total prefill compute,
(p_prompt - p_cached) + (d_prompt - d_cached) - is reported under `router_hops`.
The standard fields stay standard: this fork's created_cache_tokens is stripped
and no cache_write_tokens alias is emitted, because such an alias makes a
client's derived input collapse to 0 for every request.

Both /v1/chat/completions and /v1/responses are handled: the Responses API
nests its usage under data["response"]["usage"] and names the fields
input_tokens / output_tokens / input_tokens_details.

The prefill hop is capped for both families. The Responses API ignores
max_tokens, so without max_output_tokens=1 the prefill engine generated the
whole answer before the decode hop was even asked to start: measured +297
generated tokens on the prefill engine for a 300-token answer and a TTFT of
4.7s instead of 0.11s, while the client waited for both generations.

--- a/vllm_router/services/request_service/request.py
+++ b/vllm_router/services/request_service/request.py
@@ -734,6 +734,141 @@
         return await response.json()
 
 
+class _UsageMergeState:
+    """Rewrite the streamed decode usage so the client sees the merged account.
+
+    The client must receive an OpenAI-standard body, so the accounting is baked
+    into `usage` itself; the raw per-hop numbers ride along under `router_hops`.
+
+    input       : the prompt (both hops must agree)
+    cached read : min(prefill cached, decode cached) - what was already cached
+                  before this request; the min removes the intra-request
+                  prefill->decode handoff from the count
+    output      : the decode hop's completion tokens (untouched)
+
+    Both response families are handled: chat completions keep the usage at the
+    top level of a `data:` event (prompt_tokens / completion_tokens /
+    prompt_tokens_details) while the Responses API nests it under
+    `data["response"]["usage"]` (input_tokens / output_tokens /
+    input_tokens_details). Everything else - including the total prefill compute,
+    (p_prompt - p_cached) + (d_prompt - d_cached) - goes to `router_hops`.
+    """
+
+    def __init__(self, prefill_usage, request_id):
+        self.prefill_usage = prefill_usage
+        self.request_id = request_id
+        self.buf = bytearray()
+
+    @staticmethod
+    def _details_key(usage):
+        """Name of the detail object for this usage shape."""
+        if "prompt_tokens" in usage or "completion_tokens" in usage:
+            return "prompt_tokens_details"
+        return "input_tokens_details"
+
+    @classmethod
+    def _view(cls, usage):
+        """(prompt, cached, completion) for either usage shape."""
+        if not isinstance(usage, dict):
+            return None, None, None
+        details = usage.get(cls._details_key(usage))
+        cached = details.get("cached_tokens") if isinstance(details, dict) else None
+        prompt = usage.get("prompt_tokens", usage.get("input_tokens"))
+        completion = usage.get("completion_tokens", usage.get("output_tokens"))
+        return prompt, cached, completion
+
+    @classmethod
+    def _write_cached(cls, usage, cached):
+        """Store the merged cache read back in the usage's own shape."""
+        key = cls._details_key(usage)
+        details = usage.get(key)
+        if not isinstance(details, dict):
+            details = {}
+            usage[key] = details
+        details["cached_tokens"] = cached
+        # This fork's engines report a non-standard created_cache_tokens, and
+        # some clients look for a cache_write_tokens alias; the standard fields
+        # stay standard, the per-hop detail lives in router_hops.
+        details.pop("created_cache_tokens", None)
+        details.pop("cache_write_tokens", None)
+
+    @classmethod
+    def _merge(cls, decode_usage, prefill_usage, request_id):
+        if not isinstance(decode_usage, dict):
+            return decode_usage
+        p_prompt, p_cached, _ = cls._view(prefill_usage)
+        d_prompt, d_cached, _ = cls._view(decode_usage)
+        if p_prompt is not None and d_prompt is not None and p_prompt != d_prompt:
+            logger.warning(
+                f"{request_id} prefill/decode prompt mismatch: "
+                f"prefill={p_prompt} decode={d_prompt}; reporting decode"
+            )
+        input_tokens = d_prompt if d_prompt is not None else p_prompt
+        if p_cached is None:
+            cached_read = d_cached
+        elif d_cached is None:
+            cached_read = p_cached
+        else:
+            cached_read = min(p_cached, d_cached)
+        cache_write = None
+        if None not in (p_prompt, p_cached, d_prompt, d_cached):
+            cache_write = (p_prompt - p_cached) + (d_prompt - d_cached)
+        decode_raw = json.loads(json.dumps(decode_usage))
+        if cached_read is not None:
+            cls._write_cached(decode_usage, cached_read)
+        decode_usage["router_hops"] = {
+            "request_id": request_id,
+            "input": input_tokens,
+            "cached_read": cached_read,
+            "cache_write_prefill_compute": cache_write,
+            "prefill_usage": prefill_usage if isinstance(prefill_usage, dict) else None,
+            "decode_usage": decode_raw,
+        }
+        return decode_usage
+
+    def _rewrite_event(self, event: bytes) -> bytes:
+        head, sep, body = event.partition(b"data:")
+        if not sep:
+            return event
+        body = body.strip()
+        if not body or body == b"[DONE]":
+            return event
+        try:
+            payload = json.loads(body)
+        except Exception:
+            return event
+        if not isinstance(payload, dict):
+            return event
+        usage = payload.get("usage")
+        if not isinstance(usage, dict):
+            response = payload.get("response")
+            usage = response.get("usage") if isinstance(response, dict) else None
+        if not isinstance(usage, dict):
+            return event
+        self._merge(usage, self.prefill_usage, self.request_id)
+        return head + b"data: " + json.dumps(payload).encode("utf-8")
+
+    def feed(self, chunk: bytes):
+        """Return the rewritten complete SSE events; keep one partial buffered."""
+        self.buf.extend(chunk)
+        out = []
+        while True:
+            idx = self.buf.find(b"\n\n")
+            if idx < 0:
+                break
+            event = bytes(self.buf[:idx])
+            del self.buf[: idx + 2]
+            out.append(self._rewrite_event(event) + b"\n\n")
+        return out
+
+    def flush(self) -> bytes:
+        if not self.buf:
+            return b""
+        rest = self._rewrite_event(bytes(self.buf))
+        self.buf.clear()
+        return rest
+
+
 async def send_request_to_decode(
     client: aiohttp.ClientSession, endpoint: str, req_data: dict, request_id: str
 ):
@@ -972,12 +1107,20 @@
