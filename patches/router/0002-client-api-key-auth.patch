+"""Client API-key authentication (from vllm-project/production-stack PR #937).
+
+VLLM_API_KEY (comma-separated for several keys) is the same variable the
+router already uses to authenticate itself to the backends. When it is unset
+or empty, authentication is disabled. Keys are never logged.
+"""
+import hmac
+import os
+from typing import FrozenSet
+
+from fastapi import HTTPException, Request
+
+# Liveness probe stays open so health checks do not need the secret.
+UNAUTHENTICATED_PATHS = frozenset({"/health"})
+
+
+def _parse_api_keys(raw: str) -> FrozenSet[str]:
+    """Comma-separated keys; whitespace around each key is stripped."""
+    return frozenset(k.strip() for k in raw.split(",") if k.strip())
+
+
+def get_allowed_api_keys() -> FrozenSet[str]:
+    return _parse_api_keys(os.getenv("VLLM_API_KEY", ""))
+
+
+def _key_matches(token: str, allowed: FrozenSet[str]) -> bool:
+    # Constant-time per key, and every key is compared (no early exit).
+    tok = token.encode("utf-8")
+    ok = False
+    for key in allowed:
+        ok |= hmac.compare_digest(tok, key.encode("utf-8"))
+    return ok
+
+
+def _unauthorized(detail: str) -> HTTPException:
+    return HTTPException(
+        status_code=401, detail=detail, headers={"WWW-Authenticate": "Bearer"}
+    )
+
+
+async def verify_api_key(request: Request) -> None:
+    """FastAPI dependency enforcing `Authorization: Bearer <key>`."""
+    allowed_keys = get_allowed_api_keys()
+    if not allowed_keys or request.url.path in UNAUTHENTICATED_PATHS:
+        return
+
+    auth_header = request.headers.get("Authorization") or ""
+    scheme, _, token = auth_header.partition(" ")
+    if scheme.lower() != "bearer" or not token.strip():
+        raise _unauthorized(
+            "Missing or malformed Authorization header. Expected: Bearer <token>"
+        )
+    if not _key_matches(token.strip(), allowed_keys):
+        raise _unauthorized("Invalid API key")
