+    def _prime_pp_communicators(self) -> None:
+        """Initialize both lazy PP P2P communicators before memory sizing.
+
+        vLLM's device communicator and torch ProcessGroupNCCL use separate
+        two-rank send/recv communicators. If either is first created after KV
+        allocation, its persistent device buffers are absent from profiling and
+        can OOM during mixed sparse-MLA warmup.
+        """
+        pp_group = get_pp_group()
+        if pp_group.world_size <= 1:
+            return
+        primer = torch.zeros(1, dtype=torch.int32, device=self.device)
+
+        # vLLM/PyNCCL communicator used by the explicit PP primer path.
+        if not pp_group.is_first_rank:
+            pp_group.recv(primer.shape, primer.dtype)
+        if not pp_group.is_last_rank:
+            pp_group.send(primer)
+        torch.accelerator.synchronize()
+
+        # ProcessGroupNCCL communicator used by tensor-dict isend/irecv.
+        rank = pp_group.rank_in_group
+        if not pp_group.is_first_rank:
+            torch.distributed.recv(
+                primer, src=pp_group.ranks[rank - 1], group=pp_group.device_group
+            )
+        if not pp_group.is_last_rank:
+            torch.distributed.send(
+                primer, dst=pp_group.ranks[rank + 1], group=pp_group.device_group
+            )
+        torch.accelerator.synchronize()
+
     @torch.inference_mode()
