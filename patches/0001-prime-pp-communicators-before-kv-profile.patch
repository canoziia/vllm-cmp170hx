@@ -536,6 +536,26 @@ class Worker(WorkerBase):
         with set_current_vllm_config(self.vllm_config):
             self.model_runner.reload_weights(*args, **kwargs)
 
+    def _prime_pp_communicators(self) -> None:
+        """Initialize lazy PP send/recv communicators before memory sizing.
+
+        ProcessGroupNCCL creates an unbatched two-rank communicator on first
+        send/recv. If that happens after KV allocation, its persistent device
+        buffers are absent from memory profiling and can OOM during warmup.
+        Calling this before profiling makes those buffers part of non-KV usage.
+        The later pre-capture call is intentionally retained as an idempotent
+        ordering check.
+        """
+        pp_group = get_pp_group()
+        if pp_group.world_size <= 1:
+            return
+        primer = torch.zeros(1, dtype=torch.int32, device=self.device)
+        if not pp_group.is_first_rank:
+            pp_group.recv(primer.shape, primer.dtype)
+        if not pp_group.is_last_rank:
+            pp_group.send(primer)
+        torch.accelerator.synchronize()
+
     @torch.inference_mode()
     def determine_available_memory(self) -> int:
