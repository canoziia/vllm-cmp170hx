+    # The last-rank-only MTP draft must not mutate the target's shared cache
+    # config. Qwen config validation resolves the draft SSM dtype and page size
+    # in-place; sharing this object made only PP3 target layers switch to FP32.
+    draft_model_config = speculative_config.draft_model_config
