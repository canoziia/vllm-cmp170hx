diff --git a/vllm/v1/worker/gpu/perf_debug.py b/vllm/v1/worker/gpu/perf_debug.py
new file mode 100644
index 000000000..614837fad
--- /dev/null
+++ b/vllm/v1/worker/gpu/perf_debug.py
@@ -0,0 +1,349 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Hot-switchable, low-overhead GPU worker diagnostics.
+
+Disabled by default. A worker only reads the control file after SIGUSR2. When
+inactive, hot-path calls reduce to a boolean branch and never create CUDA
+Events, synchronize a stream, copy tensors, or write output.
+
+Enabled sampled steps use asynchronous CUDA Events and pinned D2H copies. Event
+results are polled on later steps and written in batches, without synchronizing
+the model stream. Optional torch-profiler capture is deliberately intrusive but
+is bounded to an explicit number of steps and can be enabled without restart.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import os
+import signal
+import time
+from collections import defaultdict, deque
+from pathlib import Path
+from typing import Any
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_DEFAULT_DIR = "/root/.cache/vllm-perf-debug"
+
+
+class PerfDebugTracer:
+    def __init__(self, rank: int, device: torch.device, max_num_reqs: int):
+        self.rank = rank
+        self.device = device
+        self.max_num_reqs = max_num_reqs
+        self.enabled = False
+        self._reload_requested = False
+        self._step_seq = 0
+        self._sample_seq = 0
+        self._config: dict[str, Any] = {}
+        self._current: dict[str, Any] | None = None
+        self._pending: deque[dict[str, Any]] = deque()
+        self._write_buffer: list[dict[str, Any]] = []
+        self._output_path: Path | None = None
+        self._profiler = None
+        self._profile_remaining = 0
+        self._profile_path: Path | None = None
+        self._dropped = 0
+        self._accept_sampled_pool: torch.Tensor | None = None
+        self._accept_rejected_pool: torch.Tensor | None = None
+        self._accept_pool_index = 0
+        signal.signal(signal.SIGUSR2, self._request_reload)
+
+    def _request_reload(self, _signum, _frame) -> None:
+        # Signal handlers must not perform file or CUDA operations.
+        self._reload_requested = True
+
+    @property
+    def control_path(self) -> Path:
+        return Path(
+            os.getenv(
+                "VLLM_PERF_DEBUG_CONTROL",
+                f"{os.getenv('VLLM_PERF_DEBUG_DIR', _DEFAULT_DIR)}/control.json",
+            )
+        )
+
+    def _rank_selected(self, value: Any) -> bool:
+        if value in (None, "all", "*"):
+            return True
+        if isinstance(value, int):
+            return self.rank == value
+        return self.rank in value
+
+    def _stop_profiler(self) -> None:
+        if self._profiler is None:
+            return
+        profiler, self._profiler = self._profiler, None
+        try:
+            profiler.stop()
+            assert self._profile_path is not None
+            profiler.export_chrome_trace(str(self._profile_path))
+            logger.info("Perf debug rank %d wrote torch trace %s", self.rank, self._profile_path)
+        except Exception:
+            logger.exception("Perf debug rank %d failed to stop/export profiler", self.rank)
+        self._profile_remaining = 0
+        self._profile_path = None
+
+    def _load_control(self) -> None:
+        self._reload_requested = False
+        old_enabled = self.enabled
+        try:
+            config = json.loads(self.control_path.read_text())
+        except FileNotFoundError:
+            config = {"enabled": False}
+        except Exception:
+            logger.exception("Perf debug rank %d could not read %s", self.rank, self.control_path)
+            return
+
+        enabled = bool(config.get("enabled", False)) and self._rank_selected(
+            config.get("ranks", "all")
+        )
+        if not enabled:
+            self._drain_ready()
+            self.enabled = False
+            self._stop_profiler()
+            self._flush()
+            if old_enabled:
+                logger.info("Perf debug disabled on rank %d", self.rank)
+            return
+
+        self._config = config
+        output_dir = Path(config.get("output_dir") or self.control_path.parent)
+        output_dir.mkdir(parents=True, exist_ok=True)
+        session = str(config.get("session") or time.strftime("%Y%m%d-%H%M%S"))
+        self._output_path = output_dir / f"steps-{session}-rank{self.rank}.jsonl"
+        self._sample_seq = 0
+        self._dropped = 0
+        self._accept_pool_index = 0
+        pool_rows = self.max_pending
+        self._accept_sampled_pool = torch.empty(
+            (pool_rows, self.max_num_reqs), dtype=torch.int32, pin_memory=True
+        )
+        self._accept_rejected_pool = torch.empty_like(
+            self._accept_sampled_pool, pin_memory=True
+        )
+        self.enabled = True
+        self._stop_profiler()
+        profile_steps = max(0, int(config.get("torch_profile_steps", 0)))
+        if profile_steps and self._rank_selected(config.get("profile_ranks", [self.rank])):
+            activities = [torch.profiler.ProfilerActivity.CPU]
+            if torch.cuda.is_available():
+                activities.append(torch.profiler.ProfilerActivity.CUDA)
+            self._profiler = torch.profiler.profile(
+                activities=activities,
+                record_shapes=bool(config.get("profile_record_shapes", False)),
+                profile_memory=bool(config.get("profile_memory", False)),
+                with_stack=bool(config.get("profile_with_stack", False)),
+                with_modules=True,
+            )
+            self._profiler.start()
+            self._profile_remaining = profile_steps
+            self._profile_path = output_dir / f"torch-{session}-rank{self.rank}.json"
+        logger.info(
+            "Perf debug enabled rank=%d sample_every=%d max_samples=%d output=%s "
+            "torch_profile_steps=%d",
+            self.rank,
+            self.sample_every,
+            self.max_samples,
+            self._output_path,
+            profile_steps,
+        )
+
+    @property
+    def sample_every(self) -> int:
+        return max(1, int(self._config.get("sample_every", 1)))
+
+    @property
+    def max_samples(self) -> int:
+        return max(0, int(self._config.get("max_samples", 256)))
+
+    @property
+    def max_pending(self) -> int:
+        return max(8, int(self._config.get("max_pending", 512)))
+
+    @property
+    def flush_every(self) -> int:
+        return max(1, int(self._config.get("flush_every", 16)))
+
+    @property
+    def armed(self) -> bool:
+        """One disabled-path check before constructing per-step metadata."""
+        return self.enabled or self._reload_requested
+
+    @property
+    def step_active(self) -> bool:
+        return self._current is not None
+
+    def begin_step(self, metadata: dict[str, Any]) -> bool:
+        # Critical disabled path: one predictable branch, no CUDA/file calls.
+        if not self.enabled and not self._reload_requested:
+            return False
+        if self._reload_requested:
+            self._load_control()
+        if not self.enabled:
+            return False
+        self._drain_ready()
+        if self._current is not None:
+            # Preserve diagnostics even if an unusual call path skipped sample_tokens.
+            self.finish_step(incomplete=True)
+        self._step_seq += 1
+        if self._profiler is None and self._step_seq % self.sample_every:
+            return False
+        if self.max_samples and self._sample_seq >= self.max_samples:
+            if not self._pending:
+                self._flush()
+                self.enabled = False
+                logger.info(
+                    "Perf debug rank %d completed %d samples and auto-disabled",
+                    self.rank,
+                    self._sample_seq,
+                )
+            return False
+        if len(self._pending) >= self.max_pending:
+            self._dropped += 1
+            return False
+        self._sample_seq += 1
+        self._current = {
+            "schema": 1,
+            "rank": self.rank,
+            "pid": os.getpid(),
+            "step": self._step_seq,
+            "sample": self._sample_seq,
+            "wall_start_ns": time.time_ns(),
+            "cpu_start_ns": time.perf_counter_ns(),
+            "meta": dict(metadata),
+            "cpu_ms": defaultdict(float),
+            "gpu_events": [],
+            "deferred": [],
+        }
+        return True
+
+    def set_meta(self, **metadata: Any) -> None:
+        if self._current is not None:
+            self._current["meta"].update(metadata)
+
+    def cpu_start(self) -> int:
+        return time.perf_counter_ns() if self._current is not None else 0
+
+    def cpu_end(self, name: str, start_ns: int) -> None:
+        if start_ns and self._current is not None:
+            self._current["cpu_ms"][name] += (time.perf_counter_ns() - start_ns) / 1e6
+
+    def cuda_begin(self, name: str, stream=None):
+        if self._current is None:
+            return None
+        event = torch.cuda.Event(enable_timing=True)
+        event.record(stream)
+        return name, event
+
+    def cuda_end(self, token, stream=None) -> None:
+        if token is None or self._current is None:
+            return
+        name, start = token
+        end = torch.cuda.Event(enable_timing=True)
+        end.record(stream)
+        self._current["gpu_events"].append((name, start, end))
+
+    def capture_acceptance(
+        self, num_sampled: torch.Tensor, num_rejected: torch.Tensor
+    ) -> None:
+        if self._current is None:
+            return
+        assert self._accept_sampled_pool is not None
+        assert self._accept_rejected_pool is not None
+        n = num_sampled.numel()
+        row = self._accept_pool_index % self._accept_sampled_pool.shape[0]
+        self._accept_pool_index += 1
+        sampled = self._accept_sampled_pool[row, :n]
+        rejected = self._accept_rejected_pool[row, :n]
+        sampled.copy_(num_sampled.reshape(-1), non_blocking=True)
+        rejected.copy_(num_rejected.reshape(-1), non_blocking=True)
+        done = torch.cuda.Event()
+        done.record()
+        self._current["deferred"].append(("acceptance", done, sampled, rejected))
+
+    def scope(self, name: str):
+        if self._profiler is None:
+            return contextlib.nullcontext()
+        return torch.profiler.record_function(name)
+
+    def finish_step(self, *, incomplete: bool = False) -> None:
+        current, self._current = self._current, None
+        if current is None:
+            return
+        current["cpu_total_ms"] = (
+            time.perf_counter_ns() - current.pop("cpu_start_ns")
+        ) / 1e6
+        current["wall_end_ns"] = time.time_ns()
+        if incomplete:
+            current["incomplete"] = True
+        current["cpu_ms"] = dict(current["cpu_ms"])
+        self._pending.append(current)
+        if self._profiler is not None:
+            self._profiler.step()
+            self._profile_remaining -= 1
+            if self._profile_remaining <= 0:
+                self._stop_profiler()
+        self._drain_ready()
+
+    def _record_ready(self, record: dict[str, Any]) -> bool:
+        return all(end.query() for _, _, end in record["gpu_events"]) and all(
+            done.query() for _, done, *_ in record["deferred"]
+        )
+
+    def _materialize(self, record: dict[str, Any]) -> dict[str, Any]:
+        gpu_ms: dict[str, float] = defaultdict(float)
+        gpu_counts: dict[str, int] = defaultdict(int)
+        for name, start, end in record.pop("gpu_events"):
+            gpu_ms[name] += start.elapsed_time(end)
+            gpu_counts[name] += 1
+        record["gpu_ms"] = dict(gpu_ms)
+        record["gpu_span_counts"] = dict(gpu_counts)
+        for kind, _done, first, second in record.pop("deferred"):
+            if kind == "acceptance":
+                sampled = first.tolist()
+                rejected = second.tolist()
+                record["acceptance"] = {
+                    "num_sampled": sampled,
+                    "num_rejected": rejected,
+                    "sampled_sum": int(sum(sampled)),
+                    "rejected_sum": int(sum(rejected)),
+                    "sampled_mean": float(sum(sampled) / len(sampled)) if sampled else 0.0,
+                }
+        if self._dropped:
+            record["dropped_samples"] = self._dropped
+            self._dropped = 0
+        return record
+
+    def _drain_ready(self) -> None:
+        while self._pending and self._record_ready(self._pending[0]):
+            self._write_buffer.append(self._materialize(self._pending.popleft()))
+        if len(self._write_buffer) >= self.flush_every:
+            self._flush()
+
+    def _flush(self) -> None:
+        if not self._write_buffer or self._output_path is None:
+            return
+        with self._output_path.open("a", encoding="utf-8") as output:
+            for record in self._write_buffer:
+                output.write(json.dumps(record, separators=(",", ":")) + "\n")
+        self._write_buffer.clear()
+
+
+_TRACER: PerfDebugTracer | None = None
+
+
+def init_perf_debug(
+    rank: int, device: torch.device, max_num_reqs: int
+) -> PerfDebugTracer:
+    global _TRACER
+    _TRACER = PerfDebugTracer(rank, device, max_num_reqs)
+    return _TRACER
+
+
+def get_perf_debug() -> PerfDebugTracer | None:
+    return _TRACER
